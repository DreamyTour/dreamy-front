---
export const frontmatter = {
  title: "About Us",
  description: "About Us Dreamy Tours - Personalized tourism experiences",
  lang: "en",
  heroEyebrow: "Team",
  heroImage: "/imagenes/personal.webp",
  heroImageAlt: "About Us - Dreamy Tours",
  seo: {
    metaTitle: "About Us | Turismo Peru Bolivia",
    metaDescription: "About Us Dreamy Tours - Personalized tourism experiences",
  },
  slugs: {
    es: "sobre-nosotros",
    en: "about-us",
    pt: "sobre-nos",
  },
};

import CertificatesCarousel from "@/components/ui/CertificatesCarousel.tsx";
---

<div class="not-prose text-foreground">
  <section class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <div class="rounded-3xl border border-border bg-card p-7 shadow-lg sm:p-10">
      <p class="m-0 text-lg leading-8 text-muted-foreground md:text-xl"><strong class="text-primary">DREAMY TOURS</strong> provides a service beyond the traditional, both in planning and in every excursion. We work with ethical and social responsibility principles, supporting our team while maintaining a continuous commitment to safety and environmental respect.</p>
      <div class="mt-6 border-t border-border pt-6"><p class="m-0 leading-7 text-muted-foreground">Our professionals are dedicated to customer care, helping travellers turn their dreams of discovering new cultures into unforgettable experiences.</p></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 md:py-24" aria-labelledby="about-essence-title">
    <div class="text-center">
      <p class="mx-auto w-fit rounded-full bg-muted px-4 py-1 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-foreground">Our essence</p>
      <h2 id="about-essence-title" class="mt-4 text-4xl font-bold tracking-tight md:text-6xl">
        <span class="text-primary">Mission</span>, <span class="text-secondary">Vision</span> & <span class="text-primary">Values</span>
      </h2>
      <div class="mx-auto mt-5 flex w-fit items-center" aria-hidden="true"><span class="h-0.5 w-7 bg-primary"></span><span class="h-0.5 w-7 bg-secondary"></span></div>
      <p class="mx-auto mt-7 max-w-2xl leading-7 text-muted-foreground md:text-lg">We bring together tradition, trust and technology so you can discover Peru at its most authentic.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:gap-7">
      <article class="relative flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] border border-border bg-card p-7 shadow-[0_18px_40px_-34px_color-mix(in_oklab,var(--foreground)_55%,transparent)] md:p-8">
        <span class="pointer-events-none absolute -right-10 -top-10 size-28 rounded-full bg-primary/[0.07]" aria-hidden="true"></span>
        <div class="relative flex items-center gap-4"><span class="grid size-12 shrink-0 place-items-center rounded-2xl border border-primary/15 bg-primary/10 text-primary" aria-hidden="true"><svg class="size-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.8]" viewBox="0 0 24 24"><path d="M9 20 3.55 17.28A1 1 0 0 1 3 16.38V5.62a1 1 0 0 1 1.45-.89L9 7m0 13 6-3m-6 3V7m6 10 4.55 2.28A1 1 0 0 0 21 18.38V7.62a1 1 0 0 0-.55-.89L15 4m0 13V4m0 0L9 7"></path></svg></span><h3 class="text-2xl font-bold tracking-tight">Mission</h3></div>
        <div class="relative mt-6 space-y-4 leading-7 text-muted-foreground"><p>Deliver a service of quality and reliability, exceeding our travellers’ expectations with tour packages that reveal the wonders of Peru.</p><p>We have a specialised team and technology to offer a personalised experience that exceeds expectations.</p></div>
        <div class="relative mt-auto flex items-center gap-3 pt-7 text-[0.68rem] font-bold uppercase tracking-[0.08em] text-primary"><span class="h-px w-6 bg-primary" aria-hidden="true"></span>Ongoing commitment</div>
      </article>

      <article class="relative flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] border border-border bg-card p-7 shadow-[0_18px_40px_-34px_color-mix(in_oklab,var(--foreground)_55%,transparent)] md:p-8">
        <span class="pointer-events-none absolute -bottom-10 -left-10 size-28 rounded-full bg-secondary/[0.07]" aria-hidden="true"></span>
        <div class="relative flex items-center gap-4"><span class="grid size-12 shrink-0 place-items-center rounded-2xl border border-secondary/15 bg-secondary/10 text-secondary" aria-hidden="true"><svg class="size-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.8]" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M3.5 12h17M12 3.5c2.2 2.35 3.3 5.18 3.3 8.5S14.2 18.15 12 20.5C9.8 18.15 8.7 15.32 8.7 12S9.8 5.85 12 3.5Z"></path></svg></span><h3 class="text-2xl font-bold tracking-tight">Vision</h3></div>
        <div class="relative mt-6 space-y-4 leading-7 text-muted-foreground"><p>Be a travel agency leading the tourism market in Cusco, nationally and internationally, offering innovative products tailored to our travellers’ needs.</p><p>As a tour operator, we work alongside local communities towards socioeconomic development and cultural preservation.</p></div>
        <div class="relative mt-auto flex items-center gap-3 pt-7 text-[0.68rem] font-bold uppercase tracking-[0.08em] text-secondary"><span class="h-px w-6 bg-secondary" aria-hidden="true"></span>Innovation & impact</div>
      </article>

      <article class="relative flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] border border-border bg-card p-7 shadow-[0_18px_40px_-34px_color-mix(in_oklab,var(--foreground)_55%,transparent)] md:p-8">
        <span class="pointer-events-none absolute -right-10 -top-10 size-28 rounded-full bg-accent-warm/15" aria-hidden="true"></span>
        <div class="relative flex items-center gap-4"><span class="grid size-12 shrink-0 place-items-center rounded-2xl border border-primary/15 bg-primary/10 text-primary" aria-hidden="true"><svg class="size-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.8]" viewBox="0 0 24 24"><path d="m3 18 5.5-7 3.5 4 3-3 6 6"></path><path d="M3 20h18"></path><path d="M15.5 7.5h.01"></path></svg></span><h3 class="text-2xl font-bold tracking-tight">Values</h3></div>
        <div class="relative mt-6 leading-7 text-muted-foreground"><p>Cultural transmission: we value the customs and traditions of our ancestors.</p><p class="mt-4">Comprehensive training: we train our team in:</p><ul class="mt-3 grid list-disc gap-2 pl-5 text-sm leading-6 marker:text-secondary" role="list"><li>First aid and emergency response.</li><li>Appropriate food handling.</li><li>Driving and transfer safety.</li></ul></div>
        <div class="relative mt-auto flex items-center gap-3 pt-7 text-[0.68rem] font-bold uppercase tracking-[0.08em] text-primary"><span class="flex" aria-hidden="true"><span class="h-px w-3 bg-primary"></span><span class="h-px w-3 bg-secondary"></span></span>Tradition + preparedness</div>
      </article>
    </div>
  </section>

  <section class="relative left-1/2 w-[100dvw] -translate-x-1/2 bg-[radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--primary)_18%,transparent)_1px,transparent_0)] bg-[size:1rem_1rem] py-20 md:py-24" aria-labelledby="about-philosophy-title">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <p class="flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-accent-warm-foreground"><span aria-hidden="true">Philosophy</span></p>
      <h2 id="about-philosophy-title" class="mt-4 text-4xl font-bold tracking-tight text-foreground md:text-5xl">Our Commitment</h2>
      <div class="relative mt-8 rounded-[1.5rem] border border-border border-l-4 border-l-accent-warm bg-card px-7 py-10 shadow-[0_20px_42px_-32px_color-mix(in_oklab,var(--foreground)_55%,transparent)] md:px-12 md:py-12">
        <p class="mx-auto max-w-4xl text-balance text-xl italic leading-8 text-muted-foreground md:text-2xl md:leading-9">“Dreamy Tours promotes responsible travel based on respect for people and destinations, encouraging authentic interaction with the real life of each community and avoiding its destruction or exploitation.”</p>
        <div class="mt-6 flex justify-center gap-2" aria-hidden="true"><span class="size-2 rounded-full bg-primary"></span><span class="size-2 rounded-full bg-primary"></span><span class="size-2 rounded-full bg-primary"></span></div>
      </div>
    </div>
  </section>

  <section class="bg-background px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="text-center"><p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Licences</p><h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Authorisations and Certifications</h2><span class="mx-auto mt-5 block h-1 w-20 rounded-full bg-secondary"></span></div>
      <div class="mt-10 rounded-3xl border border-border bg-card p-7 shadow-lg sm:p-10"><p class="m-0 leading-7 text-muted-foreground"><strong class="text-primary">Dreamy Tours — Travel Agency and Tour Operator</strong> meets the main requirements and licences to operate tourism services throughout Peru.</p><p class="mb-0 mt-4 leading-7 text-muted-foreground">The following institutions regulate Peru's tourism industry, and we are registered with them as follows:</p></div>
      <ul class="mt-10 grid list-none gap-6 p-0 md:grid-cols-3" role="list">
        <li class="rounded-2xl border border-border border-l-4 border-l-primary bg-card p-6 shadow-lg"><h3 class="m-0 text-lg font-bold">DIRCETUR</h3><p class="mt-1 text-xs text-muted-foreground">Regional Directorate of Foreign Trade and Tourism</p><p class="mt-5 text-sm leading-6 text-muted-foreground">Authorised by DIRCETUR Cusco, which promotes sustainable, competitive tourism and crafts in the region.</p><p class="mb-0 mt-5 text-xs font-bold text-primary">● Current authorisation</p></li>
        <li class="rounded-2xl border border-border border-l-4 border-l-primary bg-card p-6 shadow-lg"><h3 class="m-0 text-lg font-bold">PROMPERÚ</h3><p class="mt-1 text-xs text-muted-foreground">Peru Promotion Commission</p><p class="mt-5 text-sm leading-6 text-muted-foreground">Registered with PROMPERÚ, the institution that promotes Peru's exports and tourism.</p><p class="mb-0 mt-5 text-xs font-bold text-primary">● Active member</p></li>
        <li class="rounded-2xl border border-border border-l-4 border-l-primary bg-card p-6 shadow-lg"><h3 class="m-0 text-lg font-bold">SUNAT</h3><p class="mt-1 text-xs text-muted-foreground">National Tax Administration</p><p class="mt-5 text-sm leading-6 text-muted-foreground">Registered with SUNAT, an institution attached to Peru's Ministry of Economy and Finance.</p><code class="mt-4 block rounded-md bg-muted p-2 text-center text-xs text-foreground">RUC: 20609347318</code><p class="mb-0 mt-5 text-xs font-bold text-primary">● Registration up to date</p></li>
      </ul>
    </div>
  </section>

  <section class="border-y border-border  px-6 py-20">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Certificates</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">Our Accreditations</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-7 text-muted-foreground">Dreamy Tours complies with the main requirements and licences to operate in Peru&apos;s tourism sector.</p>
      <CertificatesCarousel
        client:load
        certificates={[
          { src: "/imagenes/certificados/gercetur.webp", title: "DIRCETUR", subtitle: "Regional Government of Cusco", status: "Current authorisation" },
          { src: "/imagenes/certificados/mincetur-dreamy.webp", title: "MINCETUR", subtitle: "Ministry of Foreign Trade", status: "National registration" },
          { src: "/imagenes/certificados/ficha-ruc.webp", title: "SUNAT", subtitle: "RUC: 20609347318", status: "Registration up to date" },
          { src: "/imagenes/certificados/licencia-dreamy.webp", title: "Operating Licence", subtitle: "Operating document", status: "Current document" },
          { src: "/imagenes/certificados/fertificado-inspeccion.webp", title: "Inspection Certificate", subtitle: "Inspection document", status: "Current document" },
        ]}
        previousLabel="Previous accreditation"
        nextLabel="Next accreditation"
        dialogLabel="Certificate preview"
        closeLabel="Close certificate"
        instructions="Use the previous and next buttons, or swipe through the certificates. Select a certificate to view it in full size."
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center"><p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Professionals</p><h2 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl">The team behind every journey</h2><p class="mt-4 leading-7 text-muted-foreground">A team dedicated to making every itinerary personal, organised and unforgettable.</p></div>
    <div class="mt-14">
      <h3 class="border-l-4 border-secondary pl-3 text-xl font-bold">Technology & IT</h3>
      <ul class="mt-6 grid list-none gap-6 p-0 md:grid-cols-3" role="list">
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl"><img class="!my-0 block h-auto min-h-0 w-full object-contain object-top" src="/imagenes/personal/erian.webp" alt="Erian, Web Developer" width="640" height="480" loading="lazy" decoding="async" /><div class="min-w-0 p-6 text-center"><h4 class="m-0 text-xl font-bold">Erian</h4><p class="mt-1 font-bold text-primary">Web Developer</p><div class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Development tools"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Astro</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">React</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">TypeScript</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Tailwind CSS</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Git</span></div></div></li>
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl"><img class="!my-0 block h-auto min-h-0 w-full object-contain object-top" src="/imagenes/personal/jack.webp" alt="Jack, Web Master and SEO" width="640" height="480" loading="lazy" decoding="async" /><div class="min-w-0 p-6 text-center"><h4 class="m-0 text-xl font-bold">Jack</h4><p class="mt-1 font-bold text-primary">Web Master & SEO</p><div class="mt-4 flex flex-wrap justify-center gap-2" aria-label="SEO tools"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Semrush</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Cloudflare</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Ahrefs</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Google Analytics</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Search Console</span></div></div></li>
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl"><img class="!my-0 block h-auto min-h-0 w-full object-contain object-top" src="/imagenes/personal/junior.webp" alt="Junior, Social Media Manager" width="640" height="480" loading="lazy" decoding="async" /><div class="min-w-0 p-6 text-center"><h4 class="m-0 text-xl font-bold">Junior</h4><p class="mt-1 font-bold text-primary">Social Media Manager</p><div class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Social Media Manager responsibilities"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Social media management</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Community management</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Editorial calendar</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Metrics and reports</span></div></div></li>
    </ul></div>
    <div class="mt-14">
      <h3 class="border-l-4 border-secondary pl-3 text-xl font-bold">Operations</h3>
      <ul class="mt-6 grid list-none gap-6 p-0 md:grid-cols-2" role="list">
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:flex"><img class="!my-0 min-h-48 w-full self-stretch object-cover sm:w-2/5" src="/imagenes/personal/zaida.webp" alt="Zayda, Operations" width="640" height="480" loading="lazy" decoding="async" /><div class="p-6"><h4 class="m-0 text-xl font-bold">Zayda</h4><p class="mt-1 font-bold text-primary">Operations</p><p class="mt-3 text-sm leading-6 text-muted-foreground">Excursion coordination and field logistics.</p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Guiding</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Logistics</span></div></div></li>
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:flex"><img class="!my-0 min-h-48 w-full self-stretch object-cover sm:w-2/5" src="/imagenes/personal/juliana.webp" alt="Juliana, Operations" width="640" height="480" loading="lazy" decoding="async" /><div class="p-6"><h4 class="m-0 text-xl font-bold">Juliana</h4><p class="mt-1 font-bold text-primary">Operations</p><p class="mt-3 text-sm leading-6 text-muted-foreground">Customer care and reservation management.</p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Customer service</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Reservations</span></div></div></li>
    </ul></div>
    <div class="mt-14">
      <h3 class="border-l-4 border-secondary pl-3 text-xl font-bold">Accounting</h3>
      <ul class="mt-6 grid list-none gap-6 p-0 md:grid-cols-2" role="list">
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:flex"><img class="!my-0 min-h-48 w-full self-stretch object-cover sm:w-2/5" src="/imagenes/personal/susana.webp" alt="Susana, Accounting" width="640" height="480" loading="lazy" decoding="async" /><div class="p-6"><h4 class="m-0 text-xl font-bold">Susana</h4><p class="mt-1 font-bold text-primary">Accounting</p><p class="mt-3 text-sm leading-6 text-muted-foreground">Financial management and general accounting.</p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Finance</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Taxation</span></div></div></li>
      <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:flex"><img class="!my-0 min-h-48 w-full self-stretch object-cover sm:w-2/5" src="/imagenes/personal/liz.webp" alt="Lizbeth, Accounting Assistant" width="640" height="480" loading="lazy" decoding="async" /><div class="p-6"><h4 class="m-0 text-xl font-bold">Lizbeth</h4><p class="mt-1 font-bold text-primary">Accounting Assistant</p><p class="mt-3 text-sm leading-6 text-muted-foreground">Accounting support and invoicing.</p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Invoicing</span><span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">Support</span></div></div></li>
    </ul></div>
  </section>

  
</div>
