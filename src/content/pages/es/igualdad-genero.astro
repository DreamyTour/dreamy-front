---
export const frontmatter = {
  title: "Política de Igualdad de Género",
  description: "Política de Igualdad de Género - Dreamy Tours",
  lang: "es",
  heroEyebrow: "Compromiso",
  heroImage: "/imagenes/circuitos.webp",
  heroImageAlt: "Política de Igualdad de Género - Dreamy Tours",
  seo: {
    metaTitle: "Política de Igualdad de Género | Turismo Perú Bolivia",
    metaDescription: "Política de Igualdad de Género - Dreamy Tours",
  },
  slugs: {
    es: "igualdad-genero",
    en: "gender-equality",
    pt: "igualdade-de-genero",
  },
};

const copy = {
  intro: {
    title: "Compromiso con la igualdad",
    text: "En Dreamy Tours, estamos firmemente comprometidos con la igualdad de género y la no discriminación en todos los ámbitos de nuestra actividad.",
  },
  pillars: [
    {
      icon: "⚖",
      title: "Igualdad de Oportunidades",
      text: "Garantizamos el mismo trato y oportunidades para todos nuestros colaboradores, sin importar el género.",
      tone: "green",
    },
    {
      icon: "🛡",
      title: "Entorno Seguro",
      text: "Tolerancia cero hacia el acoso sexual y la discriminación de género en nuestros espacios de trabajo y tours.",
      tone: "red",
    },
    {
      icon: "◈",
      title: "Equidad Salarial",
      text: "Salarios justos por el mismo trabajo. El mérito y la experiencia son nuestros únicos impulsores de compensación.",
      tone: "green",
    },
    {
      icon: "◎",
      title: "Representación",
      text: "Promovemos activamente la participación equitativa de mujeres en todos los niveles de liderazgo dentro de la empresa.",
      tone: "red",
    },
  ],
  actionsTitle: "Acciones concretas",
  actions: [
    [
      "Programas de capacitación",
      "Capacitación en igualdad de género para todo nuestro personal.",
    ],
    [
      "Comités de género",
      "Equipos dedicados a la prevención y atención del acoso.",
    ],
    [
      "Conciliación familiar",
      "Políticas que favorecen el equilibrio entre trabajo y familia.",
    ],
    [
      "Canal de denuncias anónimo",
      "Un espacio seguro y confidencial para reportar incidentes.",
    ],
  ],
  report: {
    title: "Reportar un incidente",
    text: "Si conoces o experimentas alguna situación de discriminación, repórtala a:",
    email: "info@dreamytours.com",
    note: "Todos los reportes serán tratados con confidencialidad y seriedad.",
  },
  footer: ["Compromiso real", "Tolerancia cero", "Igualdad real"],
};
---

<div
  class="not-prose bg-[#fafbfc] px-5 py-12 text-slate-800 [&_h2]:text-balance [&_li]:text-pretty [&_p]:text-pretty sm:py-16 lg:py-20"
>
  <div class="mx-auto w-full max-w-5xl">
    <section
      class="relative mb-8 overflow-hidden rounded-2xl border border-slate-200/60 bg-white p-6 shadow-sm sm:p-8"
      aria-labelledby="gender-intro"
    >
      <div
        class="relative flex flex-col items-start gap-4 sm:flex-row sm:items-center"
      >
        <span
          class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-[#00a43d]/20 bg-[#00a43d]/10 text-2xl text-[#008a32]"
          aria-hidden="true">✦</span
        >
        <div>
          <h2 id="gender-intro" class="text-lg font-bold text-slate-800">
            {copy.intro.title}
          </h2><p class="mt-1 max-w-4xl text-sm leading-relaxed text-slate-600">
            {copy.intro.text}
          </p>
        </div>
      </div>
    </section>

    <section
      class="mb-8 grid grid-cols-1 gap-5 md:grid-cols-2"
      aria-label="Pilares de la política de igualdad"
    >
      {
        copy.pillars.map((pillar) => {
          const isGreen = pillar.tone === "green";
          return (
            <article class="relative overflow-hidden rounded-2xl border border-slate-200/60 bg-white p-6 shadow-sm transition-[box-shadow,border-color] duration-300 hover:border-slate-300 hover:shadow-md motion-reduce:transition-none">
              <>
                <span
                  class:list={[
                    "absolute left-0 top-[10%] h-[80%] w-1 rounded-r-full",
                    isGreen ? "bg-[#00a43d]" : "bg-[#b71532]",
                  ]}
                  aria-hidden="true"
                />
                <div class="pl-3">
                  <>
                    <div class="mb-3 flex items-center gap-3">
                      <>
                        <span
                          class:list={[
                            "flex size-10 items-center justify-center rounded-full border text-xl",
                            isGreen
                              ? "border-[#00a43d]/15 bg-[#e6f5eb] text-[#008a32]"
                              : "border-[#b71532]/15 bg-[#f8e8eb] text-[#9e0f2a]",
                          ]}
                          aria-hidden="true"
                        >
                          {pillar.icon}
                        </span>
                        <h2 class="text-lg font-bold text-slate-800">
                          {pillar.title}
                        </h2>
                      </>
                    </div>
                    <p class="text-sm leading-relaxed text-slate-600">
                      {pillar.text}
                    </p>
                  </>
                </div>
              </>
            </article>
          );
        })
      }
    </section>

    <section class="mb-8" aria-labelledby="gender-actions">
      <div class="mb-4 flex items-center gap-3">
        <span
          class="flex size-9 items-center justify-center rounded-full bg-[#e6f5eb] text-[#008a32]"
          aria-hidden="true">✓</span
        ><h2 id="gender-actions" class="text-xl font-bold text-slate-800">
          {copy.actionsTitle}
        </h2>
      </div><ol class="grid list-none gap-4 p-0 md:grid-cols-2" role="list">
        {
          copy.actions.map(([title, text], index) => {
            const isGreen = index % 2 === 0;
            return (
              <li class="relative flex items-center gap-4 overflow-hidden rounded-xl border border-slate-200/60 bg-white p-4 shadow-sm transition-shadow duration-300 hover:shadow-md motion-reduce:transition-none">
                <>
                  <span
                    class:list={[
                      "absolute left-0 top-[10%] h-[80%] w-1 rounded-r-full",
                      isGreen ? "bg-[#00a43d]" : "bg-[#b71532]",
                    ]}
                    aria-hidden="true"
                  />
                  <span
                    class:list={[
                      "flex size-10 shrink-0 items-center justify-center rounded-full border text-sm font-bold",
                      isGreen
                        ? "border-[#00a43d]/10 bg-[#e6f5eb] text-[#00a43d]"
                        : "border-[#b71532]/10 bg-[#f8e8eb] text-[#b71532]",
                    ]}
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <div>
                    <>
                      <h3 class="text-sm font-semibold text-slate-800">
                        {title}
                      </h3>
                      <p class="mt-1 text-xs leading-relaxed text-slate-500">
                        {text}
                      </p>
                    </>
                  </div>
                </>
              </li>
            );
          })
        }
      </ol>
    </section>

    <aside
      class="relative overflow-hidden rounded-2xl border border-slate-200/60 bg-white p-6 shadow-sm sm:p-8"
      aria-labelledby="gender-report"
    >
      <span
        class="absolute left-0 top-[10%] h-[80%] w-1 rounded-r-full bg-[#b71532]"
        aria-hidden="true"></span><div
        class="flex flex-col items-start gap-4 pl-3 sm:flex-row sm:items-center"
      >
        <span
          class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-[#b71532]/20 bg-[#b71532]/10 text-2xl text-[#9e0f2a]"
          aria-hidden="true">!</span
        ><div>
          <h2 id="gender-report" class="text-lg font-bold text-slate-800">
            {copy.report.title}
          </h2><p class="mt-1 text-sm leading-relaxed text-slate-600">
            {copy.report.text}
          </p><a
            href={`mailto:${copy.report.email}`}
            class="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-[#008a32] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00a43d] focus-visible:ring-offset-2"
            >{copy.report.email}</a
          ><p class="mt-2 text-xs text-slate-400">{copy.report.note}</p>
        </div>
      </div>
    </aside>

    <footer class="mt-8 text-center">
      <div
        class="flex flex-wrap items-center justify-center gap-4 text-xs font-light text-slate-500"
      >
        {
          copy.footer.map((label, index) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/60 bg-white/70 px-4 py-1.5 shadow-sm">
              <span
                class:list={[
                  "size-2 rounded-full",
                  index === 1 ? "bg-[#b71532]" : "bg-[#00a43d]",
                ]}
                aria-hidden="true"
              />
              {label}
            </span>
          ))
        }
      </div><div
        class="mt-6 h-px w-full bg-gradient-to-r from-transparent via-[#00a43d]/30 to-transparent"
        aria-hidden="true"
      >
      </div><p
        class="mt-3 text-[0.6rem] uppercase tracking-[0.2em] text-slate-400"
      >
        ✦ Dreamy Tours · Igualdad de género como pilar ✦
      </p>
    </footer>
  </div>
</div>
