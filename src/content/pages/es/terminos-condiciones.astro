---
export const frontmatter = {
  title: "Política de Términos y Condiciones",
  description: "Política de Términos y Condiciones - Dreamy Tours",
  lang: "es",
  heroEyebrow: "Legal",
  heroImage: "/imagenes/terminos.webp",
  heroImageAlt: "Política de Términos y Condiciones - Dreamy Tours",
  seo: {
    metaTitle: "Política de Términos y Condiciones | Dreamy Tours",
    metaDescription: "Política de Términos y Condiciones - Dreamy Tours",
  },
  slugs: {
    es: "terminos-condiciones",
    en: "terms-and-conditions",
    pt: "termos-e-condicoes",
  },
};

type TermsBlock =
  | { type: "paragraph"; text: string }
  | { type: "list"; items: string[] }
  | { type: "ordered-list"; items: string[] };

interface TermsSection {
  number: string;
  id: string;
  title: string;
  blocks: TermsBlock[];
}

const termsSections: TermsSection[] = [
  {
    number: "1",
    id: "informacion-general",
    title: "Información general",
    blocks: [
      { type: "paragraph", text: "Dreamy Tours organiza y comercializa servicios turísticos propios y de terceros, incluyendo, entre otros:" },
      { type: "list", items: ["Camino Inca Clásico y Camino Inca Corto a Machu Picchu.", "Trekking Salkantay a Machu Picchu.", "Otros trekkings y rutas de aventura en Perú.", "Tours culturales y excursiones.", "Visitas a Machu Picchu y otros atractivos turísticos.", "Paquetes de viaje por Perú y Bolivia.", "Programas personalizados de acuerdo con las necesidades del viajero.", "Servicios de transporte, alojamiento, alimentación, entradas y otros servicios relacionados con el viaje."] },
      { type: "paragraph", text: "Los servicios incluidos en cada reserva dependerán del programa, itinerario y cotización previamente confirmados por Dreamy Tours." },
    ],
  },
  {
    number: "2",
    id: "reservas-confirmacion",
    title: "Reservas y confirmación del viaje",
    blocks: [
      { type: "paragraph", text: "Una reserva se considera confirmada cuando:" },
      { type: "ordered-list", items: ["El viajero acepta la propuesta o cotización enviada por Dreamy Tours.", "Se proporciona la información necesaria de los pasajeros.", "Se realiza el pago del adelanto o importe establecido para el servicio.", "Dreamy Tours confirma la reserva y los servicios contratados."] },
      { type: "paragraph", text: "Para determinados servicios, especialmente Camino Inca, Machu Picchu y otros servicios sujetos a disponibilidad limitada, la reserva estará condicionada a la disponibilidad de permisos, entradas o cupos oficiales." },
      { type: "paragraph", text: "La realización de un pago significa que todos los servicios están confirmados por parte de Dreamy Tours" },
    ],
  },
  {
    number: "3",
    id: "datos-reserva",
    title: "Datos necesarios para realizar una reserva",
    blocks: [
      { type: "paragraph", text: "Para gestionar correctamente una reserva, Dreamy Tours podrá solicitar información de los viajeros, como:" },
      { type: "list", items: ["Nombre completo.", "Nacionalidad.", "Fecha de nacimiento.", "Número de pasaporte o documento de identidad.", "Fecha de viaje.", "Datos de contacto.", "Información adicional necesaria para determinados servicios."] },
      { type: "paragraph", text: "El viajero es responsable de proporcionar información correcta, completa y actualizada." },
      { type: "paragraph", text: "Cualquier error en los datos proporcionados por el pasajero que genere costos adicionales, cambios o imposibilidad de utilizar un servicio será responsabilidad del viajero." },
    ],
  },
  {
    number: "4",
    id: "camino-inca",
    title: "Camino Inca a Machu Picchu",
    blocks: [
      { type: "paragraph", text: "El Camino Inca es una ruta turística con acceso regulado y disponibilidad limitada." },
      { type: "paragraph", text: "La confirmación del Camino Inca depende de la disponibilidad de permisos y espacios autorizados por el estado peruano." },
      { type: "paragraph", text: "Por este motivo:" },
      { type: "list", items: ["Los espacios no pueden garantizarse sin realizar la reserva correspondiente.", "Los permisos son personales y están sujetos a las condiciones establecidas por el estado peruano", "Una vez emitidos determinados permisos, entradas o servicios asociados, pueden existir restricciones para cambios, transferencias o reembolsos."] },
      { type: "paragraph", text: "Dreamy Tours no puede garantizar la disponibilidad de una fecha específica hasta contar con la confirmación oficial correspondiente." },
    ],
  },
  {
    number: "5",
    id: "trekking-aventura",
    title: "Trekking y rutas de aventura",
    blocks: [
      { type: "paragraph", text: "Los trekkings, incluyendo Salkantay Trek, Camino Inca y otras rutas de montaña, se desarrollan en entornos naturales donde pueden presentarse cambios climáticos, variaciones de ruta, restricciones de acceso u otras circunstancias fuera del control de Dreamy Tours." },
      { type: "paragraph", text: "Por razones de seguridad, operación o condiciones del destino, Dreamy Tours podrá modificar el orden de determinadas actividades, horarios, rutas o servicios incluidos en el itinerario." },
      { type: "paragraph", text: "Cualquier modificación buscará mantener la seguridad del viajero y la correcta prestación del servicio." },
    ],
  },
  {
    number: "6",
    id: "paquetes-viaje",
    title: "Paquetes de viaje",
    blocks: [
      { type: "paragraph", text: "Los paquetes de viaje pueden incluir diferentes servicios, como:" },
      { type: "list", items: ["Alojamiento.", "Transporte turístico.", "Trenes.", "Entradas.", "Tours.", "Guías.", "Alimentación.", "Traslados.", "Excursiones.", "Actividades de aventura."] },
      { type: "paragraph", text: "Cada paquete tendrá sus propias condiciones, las cuales serán informadas antes de realizar la reserva." },
      { type: "paragraph", text: "Los horarios, hoteles, trenes, transportes y otros servicios podrán estar sujetos a disponibilidad." },
      { type: "paragraph", text: "Cuando sea necesario realizar un cambio operativo, Dreamy Tours podrá ofrecer una alternativa de categoría y características similares, procurando mantener el valor y la calidad del servicio contratado." },
    ],
  },
  {
    number: "7",
    id: "pagos",
    title: "Pagos",
    blocks: [
      { type: "paragraph", text: "Las condiciones de pago serán comunicadas al viajero antes de confirmar la reserva." },
      { type: "paragraph", text: "Dependiendo del servicio contratado, Dreamy Tours podrá solicitar:" },
      { type: "list", items: ["Un adelanto para confirmar la reserva.", "El pago total antes de la fecha del viaje.", "El saldo restante antes o durante la prestación del servicio."] },
      { type: "paragraph", text: "Los métodos de pago disponibles serán informados al momento de realizar la reserva." },
      { type: "paragraph", text: "Los gastos, comisiones bancarias, cargos de plataformas de pago o diferencias generadas por determinados métodos de pago podrán ser comunicados previamente al viajero." },
    ],
  },
  {
    number: "8",
    id: "precios",
    title: "Precios",
    blocks: [
      { type: "paragraph", text: "Los precios publicados o cotizados por Dreamy Tours corresponden a las condiciones indicadas en cada programa." },
      { type: "paragraph", text: "El precio puede variar dependiendo de:" },
      { type: "list", items: ["Tipo de alojamiento.", "Categoría de tren.", "Servicios adicionales.", "Cambios solicitados por el viajero."] },
      { type: "paragraph", text: "La cotización enviada al cliente tendrá una vigencia determinada, especialmente cuando incluya servicios con disponibilidad limitada o precios sujetos a cambios." },
    ],
  },
  {
    number: "9",
    id: "cancelaciones-reembolsos",
    title: "Cancelaciones y reembolsos",
    blocks: [
      { type: "paragraph", text: "Las condiciones de cancelación dependerán del servicio contratado." },
      { type: "paragraph", text: "Algunos servicios turísticos tienen condiciones de no reembolso debido a que requieren la compra anticipada de permisos, entradas, boletos o reservas." },
      { type: "paragraph", text: "Esto puede aplicarse especialmente a:" },
      { type: "list", items: ["Camino Inca.", "Entradas a Machu Picchu.", "Boletos de tren.", "Servicios de transporte.", "Alojamientos con tarifa no reembolsable.", "Otros servicios contratados bajo condiciones especiales."] },
      { type: "paragraph", text: "En caso de cancelación por parte del viajero, Dreamy Tours revisará los servicios contratados y aplicará las condiciones de cancelación comunicadas al momento de la reserva." },
    ],
  },
  {
    number: "10",
    id: "cambios-viajero",
    title: "Cambios solicitados por el viajero",
    blocks: [
      { type: "paragraph", text: "Cualquier modificación solicitada después de confirmar una reserva estará sujeta a disponibilidad y a las condiciones del proveedor correspondiente." },
      { type: "paragraph", text: "Los cambios pueden generar costos adicionales, especialmente cuando involucren:" },
      { type: "list", items: ["Cambio de fecha.", "Cambio de horario.", "Cambio de categoría.", "Cambio de hotel.", "Cambio de tren.", "Cambio de ruta.", "Servicios adicionales."] },
      { type: "paragraph", text: "Dreamy Tours informará al viajero sobre cualquier costo adicional antes de realizar el cambio, siempre que sea posible." },
    ],
  },
  {
    number: "11",
    id: "causas-externas",
    title: "Cambios por causas externas",
    blocks: [
      { type: "paragraph", text: "Los itinerarios pueden verse afectados por circunstancias fuera del control de Dreamy Tours, como:" },
      { type: "list", items: ["Condiciones climáticas.", "Desastres naturales.", "Bloqueos o protestas.", "Huelgas.", "Restricciones gubernamentales.", "Cierres de rutas.", "Restricciones de acceso a atractivos turísticos.", "Cambios en horarios de vuelos.", "Situaciones de fuerza mayor."] },
      { type: "paragraph", text: "En estos casos, Dreamy Tours trabajará para ofrecer alternativas razonables y mantener la continuidad del viaje en la medida de lo posible." },
      { type: "paragraph", text: "Los costos adicionales derivados de cambios solicitados por el viajero o de circunstancias ajenas a Dreamy Tours podrán ser asumidos por el viajero cuando corresponda." },
    ],
  },
  {
    number: "12",
    id: "machu-picchu-disponibilidad",
    title: "Machu Picchu y servicios sujetos a disponibilidad",
    blocks: [
      { type: "paragraph", text: "El acceso a Machu Picchu, sus diferentes circuitos, montañas, horarios y modalidades de ingreso está sujeto a las disposiciones y disponibilidad establecidas por el estado peruano." },
      { type: "paragraph", text: "Dreamy Tours no controla la disponibilidad ni las modificaciones que puedan realizar las autoridades competentes." },
      { type: "paragraph", text: "Por ello, los servicios relacionados con Machu Picchu se gestionarán de acuerdo con las condiciones vigentes al momento de la reserva." },
    ],
  },
  {
    number: "13",
    id: "responsabilidad-viajero",
    title: "Responsabilidad del viajero",
    blocks: [
      { type: "paragraph", text: "El viajero se compromete a:" },
      { type: "list", items: ["Proporcionar información correcta.", "Respetar los horarios establecidos.", "Seguir las instrucciones del guía y personal encargado.", "Cumplir las normas de los atractivos turísticos.", "Respetar las comunidades locales y el medio ambiente.", "Contar con la documentación necesaria para viajar.", "Informar cualquier necesidad especial antes de la reserva.", "Mantener una conducta adecuada durante el viaje."] },
      { type: "paragraph", text: "La falta de presentación del viajero en el lugar y horario establecido podrá considerarse no presentación (no-show) y podrá generar la pérdida del servicio contratado sin derecho a reembolso." },
    ],
  },
  {
    number: "14",
    id: "documentacion-requisitos",
    title: "Documentación y requisitos de viaje",
    blocks: [
      { type: "paragraph", text: "El viajero es responsable de contar con:" },
      { type: "list", items: ["Pasaporte o documento de identidad válido, según corresponda.", "Documentación migratoria requerida.", "Seguro de viaje, cuando sea recomendable o requerido.", "Documentación adicional solicitada para determinados servicios."] },
      { type: "paragraph", text: "Dreamy Tours podrá orientar al viajero sobre los requisitos disponibles, pero la responsabilidad final de contar con documentación válida corresponde al pasajero." },
    ],
  },
  {
    number: "15",
    id: "seguro-viaje",
    title: "Seguro de viaje",
    blocks: [
      { type: "paragraph", text: "Dreamy Tours recomienda contratar un seguro de viaje con cobertura adecuada, especialmente para trekkings, actividades de aventura y viajes de varios días." },
      { type: "paragraph", text: "El seguro puede incluir, según la póliza contratada, cobertura para asistencia médica, accidentes, equipaje, cancelaciones y otras eventualidades." },
      { type: "paragraph", text: "Salvo que se indique expresamente en el programa contratado, el seguro de viaje no está incluido en el precio." },
    ],
  },
  {
    number: "16",
    id: "equipaje",
    title: "Equipaje",
    blocks: [
      { type: "paragraph", text: "Cada servicio puede tener condiciones específicas respecto al equipaje permitido." },
      { type: "paragraph", text: "En los trekkings, el viajero deberá respetar las recomendaciones de peso y tipo de equipaje proporcionadas por Dreamy Tours." },
      { type: "paragraph", text: "Los objetos personales son responsabilidad del viajero durante todo el viaje." },
      { type: "paragraph", text: "Dreamy Tours no será responsable por pérdidas, daños o robos de objetos personales cuando estos sean consecuencia de la negligencia del propio viajero o de circunstancias ajenas a la empresa." },
    ],
  },
  {
    number: "19",
    id: "proteccion-datos",
    title: "Protección de datos personales",
    blocks: [
      { type: "paragraph", text: "Dreamy Tours se compromete a tratar los datos personales proporcionados por sus clientes de acuerdo con la legislación peruana aplicable en materia de protección de datos personales." },
      { type: "paragraph", text: "Los datos proporcionados durante el proceso de reserva podrán utilizarse para:" },
      { type: "list", items: ["Gestionar reservas.", "Emitir boletos y entradas.", "Coordinar servicios turísticos.", "Contactar al viajero.", "Brindar asistencia durante el viaje.", "Cumplir obligaciones legales y administrativas."] },
      { type: "paragraph", text: "La información será gestionada de acuerdo con nuestra Política de Privacidad." },
    ],
  },
  {
    number: "20",
    id: "atencion-comunicacion",
    title: "Atención y comunicación con el viajero",
    blocks: [
      { type: "paragraph", text: "Dreamy Tours mantiene canales de comunicación para atender consultas, solicitudes y necesidades relacionadas con las reservas." },
      { type: "paragraph", text: "El viajero debe proporcionar un número de teléfono, correo electrónico o medio de contacto válido para recibir información importante sobre su viaje." },
      { type: "paragraph", text: "En caso de cambios operativos, Dreamy Tours utilizará los datos de contacto proporcionados por el cliente." },
    ],
  },
  {
    number: "21",
    id: "aceptacion-terminos",
    title: "Aceptación de los términos",
    blocks: [
      { type: "paragraph", text: "Al realizar una reserva o efectuar un pago por cualquiera de los servicios de Dreamy Tours, el viajero confirma que:" },
      { type: "list", items: ["Ha leído los presentes Términos y Condiciones.", "Comprende las condiciones del servicio contratado.", "Ha recibido información sobre los servicios incluidos y no incluidos.", "Acepta las condiciones de pago, modificación y cancelación aplicables.", "Ha proporcionado información correcta para gestionar su reserva."] },
    ],
  },
  {
    number: "22",
    id: "contacto",
    title: "Contacto",
    blocks: [
      { type: "paragraph", text: "Para consultas sobre reservas, Camino Inca, trekking Salkantay, Machu Picchu, paquetes de viaje por Perú y Bolivia o cualquier otro servicio turístico, puedes comunicarte con nuestro equipo." },
      { type: "paragraph", text: "Dreamy Tours" },
      { type: "paragraph", text: "Agencia de viajes y operadora de turismo" },
      { type: "paragraph", text: "Perú | Bolivia" },
      { type: "paragraph", text: "Planifica tu viaje con nosotros y descubre Perú y Bolivia con el respaldo de un equipo local." },
    ],
  },
];
---

<div class="not-prose mx-auto max-w-7xl">
  <header class="relative isolate overflow-hidden rounded-[2rem] border border-primary/15 bg-card px-6 py-9 shadow-[0_24px_55px_-42px_color-mix(in_oklab,var(--foreground)_62%,transparent)] sm:px-9 sm:py-11">
    <span class="pointer-events-none absolute inset-0 -z-10 [background-image:radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--primary)_32%,transparent)_1px,transparent_1.25px)] [background-size:1rem_1rem] [-webkit-mask-image:radial-gradient(ellipse_42rem_25rem_at_94%_6%,black_0%,black_34%,transparent_78%)] [mask-image:radial-gradient(ellipse_42rem_25rem_at_94%_6%,black_0%,black_34%,transparent_78%)]" aria-hidden="true"></span>
    <span class="pointer-events-none absolute -right-24 -top-32 -z-10 size-96 rounded-full border border-primary/15" aria-hidden="true"></span>
    <div class="relative mx-auto max-w-5xl text-center">
      <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"><span class="text-primary">Bienvenido a</span> <span class="text-secondary">Dreamy Tours</span>.</h1>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <span class="rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-primary-foreground">Legal</span>
        <time datetime="2026-08" class="text-sm font-semibold text-muted-foreground">Última actualización: agosto de 2026</time>
      </div>
      <p class="mt-7 text-pretty text-lg leading-8 text-foreground md:text-xl md:leading-9">Somos una agencia de viajes y operador turístico especializado en experiencias de viaje en Perú y Bolivia, incluyendo Camino Inca a Machu Picchu, trekking Salkantay, otros trekkings en los Andes, tours culturales y paquetes de viaje personalizados.</p>
      <p class="mx-auto mt-5 max-w-4xl text-pretty leading-8 text-muted-foreground md:text-lg">Al realizar una consulta, reserva o compra de cualquiera de nuestros servicios, el viajero declara haber leído y aceptado los presentes Términos y Condiciones.</p>
    </div>
  </header>

  <div class="mt-8 space-y-6">
      {termsSections.map((section, sectionIndex) => (
        <section class="relative" aria-labelledby={`terms-${section.id}-title`}>
          <article class:list={["relative overflow-hidden rounded-[1.5rem] border bg-card px-6 py-7 shadow-[0_20px_44px_-38px_color-mix(in_oklab,var(--foreground)_65%,transparent)] sm:px-8 sm:py-8", sectionIndex === termsSections.length - 1 ? "border-primary/20" : "border-border"]}>
            <span class:list={["absolute inset-y-6 left-0 w-1 rounded-r-full", sectionIndex % 2 === 0 ? "bg-primary" : "bg-secondary"]} aria-hidden="true"></span>
            <header class="relative flex items-start gap-4">
              <span class:list={["grid size-10 shrink-0 place-items-center rounded-xl text-sm font-bold shadow-sm", sectionIndex % 2 === 0 ? "bg-primary text-primary-foreground" : "bg-secondary text-secondary-foreground"]}>{section.number}</span>
              <div class="min-w-0 pt-1">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">Cláusula {section.number}</p>
                <h2 id={`terms-${section.id}-title`} class="mt-1 text-balance text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{section.title}</h2>
              </div>
            </header>

            <div class="relative mt-6 max-w-[78ch] space-y-5 text-pretty leading-8 text-muted-foreground md:text-lg">
              {section.blocks.map((block) =>
                block.type === "paragraph" ? (
                  <p class="m-0">{block.text}</p>
                ) : block.type === "ordered-list" ? (
                  <ol class="grid list-none gap-3 p-0" role="list">
                    {block.items.map((item, itemIndex) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full border border-primary/20 bg-primary/10 text-xs font-bold text-primary">{itemIndex + 1}</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <ul class="grid list-none gap-3 p-0 sm:grid-cols-2" role="list">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-3">
                        <span class:list={["mt-2.5 size-2 shrink-0 rounded-full", sectionIndex % 2 === 0 ? "bg-primary" : "bg-secondary"]} aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                ),
              )}
            </div>
          </article>
        </section>
      ))}
  </div>
</div>
