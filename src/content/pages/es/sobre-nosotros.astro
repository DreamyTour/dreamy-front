            {copy.cta.button}
            <svg
              class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg
