      aria-hidden="true"
    >
    </div>
    <div
      class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[minmax(0,1.08fr)_minmax(18rem,0.72fr)] lg:items-end"
    >
      <div>
        <p
          class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-primary"
        >
          <span class="h-px w-8 bg-primary" aria-hidden="true"></span>{
            copy.intro.eyebrow
          }
        </p>
        <h2
          id="about-intro-title"
          class="mt-5 max-w-4xl text-balance text-4xl font-bold tracking-tight md:text-6xl md:leading-[1.02]"
        >
          <span class="text-primary">{copy.intro.titleBefore}</span><span
            class="text-secondary">{copy.intro.titleAccent}</span
          >{copy.intro.titleAfter}
        </h2>
        <div
          class="mt-8 max-w-3xl space-y-5 text-pretty text-lg leading-8 text-muted-foreground md:text-xl"
        >
          {copy.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <aside
        class="relative overflow-hidden rounded-[1.75rem] border border-border bg-card p-7 shadow-[0_24px_50px_-38px_color-mix(in_oklab,var(--foreground)_65%,transparent)] sm:p-8"
