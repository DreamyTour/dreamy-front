            class="group mt-6 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-center text-sm font-bold text-primary-foreground shadow-[0_14px_28px_-16px_color-mix(in_oklab,var(--primary)_95%,transparent)] transition duration-300 hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-[0_18px_32px_-16px_color-mix(in_oklab,var(--primary)_90%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 active:scale-[0.98]"
          >
