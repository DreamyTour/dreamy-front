---
export const frontmatter = {
  title: "Código ESNNA",
  description:
    "Código de Conducta Contra la Explotación Sexual de Niños, Niñas y Adolescentes - Dreamy Tours",
  lang: "es",
  heroEyebrow: "Turismo responsable",
  layout: "esnna",
  heroImage: "/imagenes/codigo-esnna.webp",
  heroImageAlt: "Código ESNNA - Dreamy Tours",
  seo: {
    metaTitle: "Código ESNNA | Turismo Perú Bolivia",
    metaDescription:
      "Código de Conducta Contra la Explotación Sexual de Niños, Niñas y Adolescentes - Dreamy Tours",
  },
  slugs: {
    es: "codigo-esnna",
    en: "esnna-code",
    pt: "codigo-esnna",
  },
};

import CertificatesGallery from "@/components/ui/CertificatesGallery.astro";

const commitments = [
  {
    title: "No ofrecer planes de explotación",
    description:
      "Abstenerse de ofrecer, expresa o solapadamente, planes de explotación sexual en programas de promoción turística.",
    tone: "green",
  },
  {
    title: "No informar sobre lugares de explotación",
    description:
      "No brindar información a turistas, directa o indirectamente, sobre lugares donde se practique explotación sexual comercial.",
    tone: "green",
  },
  {
    title: "No trasladar a puntos de explotación",
    description:
      "Abstenerse de conducir turistas, directa o indirectamente, a establecimientos o lugares donde se practique explotación sexual.",
    tone: "red",
  },
  {
    title: "No proporcionar vehículos para explotación",
    description:
      "No proporcionar vehículos en rutas turísticas con fines de explotación o abuso sexual de niños, niñas y adolescentes.",
    tone: "red",
  },
  {
    title: "Impedir el ingreso de menores",
    description:
      "Prevenir el ingreso de niños, niñas y adolescentes a hoteles, bares y establecimientos turísticos con fines de explotación o abuso.",
    tone: "red",
  },
  {
    title: "Prevenir ofertas de servicios sexuales",
    description:
      "Adoptar medidas para que el personal vinculado a la empresa no ofrezca servicios turísticos que permitan actividad sexual con menores.",
    tone: "green",
  },
  {
    title: "Denunciar ante las autoridades",
    description:
      "Denunciar ante MINCETUR y las autoridades competentes los hechos de explotación sexual de los que se tenga conocimiento.",
    tone: "red",
  },
  {
    title: "Diseñar y difundir una política interna",
    description:
      "Diseñar y difundir una política interna con medidas para prevenir y contrarrestar la explotación sexual.",
    tone: "green",
  },
  {
    title: "Capacitar al personal",
    description:
      "Capacitar a todo el personal vinculado a la empresa sobre la prevención de la explotación sexual comercial.",
    tone: "green",
  },
  {
    title: "Informar sobre consecuencias legales",
    description:
      "Informar a los usuarios sobre las consecuencias legales en Perú de la explotación y el abuso sexual de niños y adolescentes.",
    tone: "red",
  },
  {
    title: "Exhibir el código en un lugar visible",
    description:
      "Colocar en un lugar visible este Código de Conducta y otros compromisos para la protección de niños, niñas y adolescentes.",
    tone: "green",
  },
] as const;

const commitmentColumns = [commitments.slice(0, 6), commitments.slice(6)];
---

<main class="not-prose bg-[#fafbfc] px-5 py-12 text-slate-800 sm:py-16 lg:py-20">
  <div class="mx-auto w-full max-w-5xl">
    <section class="mb-8 rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="esnna-commitment-heading">
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <span class="inline-flex shrink-0 rounded-2xl border border-[#00a43d]/20 bg-[#00a43d]/10 p-3 text-3xl" aria-hidden="true">
          &#128737;&#65039;
        </span>
        <div>
          <h2 id="esnna-commitment-heading" class="m-0 text-lg font-bold tracking-normal text-slate-800">
            Compromiso firme contra la explotación sexual
          </h2>
          <p class="mb-0 mt-1 text-sm leading-relaxed text-slate-600">
            En virtud de la <strong class="font-semibold text-[#008a32]">Ley N.º 28251</strong>, asumimos los siguientes compromisos mínimos como proveedores de servicios turísticos para prevenir y combatir la explotación sexual de niños, niñas y adolescentes en el ámbito del turismo.
          </p>
        </div>
      </div>
    </section>

    <section aria-label="Medidas de control del Código ESNNA">
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:grid-rows-[repeat(6,minmax(7.5rem,1fr))] md:gap-5">
        {
          commitmentColumns.map((column, columnIndex) => (
            <ol class="m-0 grid list-none auto-rows-fr gap-3 p-0 md:row-span-6 md:grid-rows-[subgrid] md:gap-5" start={columnIndex === 0 ? undefined : 7}>
              {column.map((commitment, itemIndex) => {
                const number = columnIndex === 0 ? itemIndex + 1 : itemIndex + 7;
                const isGreen = commitment.tone === "green";

                return (
                  <li class="group relative flex h-full items-center gap-4 overflow-hidden rounded-xl border border-slate-200/70 bg-slate-50 p-4 shadow-sm transition-[box-shadow,border-color,background-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-slate-300 hover:bg-white hover:shadow-[0_14px_30px_-22px_rgba(15,23,42,0.22)]">
                    <span
                      class:list={[
                        "absolute inset-y-[15%] left-0 w-1 rounded-r-full",
                        isGreen ? "bg-[#00a43d]" : "bg-[#b71532]",
                      ]}
                      aria-hidden="true"
                    />
                    <span
                      class:list={[
                        "flex size-10 shrink-0 items-center justify-center rounded-full border text-sm font-bold",
                        isGreen
                          ? "border-[#00a43d]/10 bg-[#e6f5eb] text-[#00a43d]"
                          : "border-[#b71532]/10 bg-[#f8e8eb] text-[#b71532]",
                      ]}
                      aria-hidden="true"
                    >
                      {number}
                    </span>
                    <div class="min-w-0">
                      <h3 class="m-0 text-sm font-semibold tracking-normal text-slate-800">{commitment.title}</h3>
                      <p class="mb-0 mt-1 text-xs leading-relaxed text-slate-500">{commitment.description}</p>
                    </div>
                  </li>
                );
              })}
            </ol>
          ))
        }
      </div>
    </section>

    <section class="relative mt-8 overflow-hidden rounded-2xl border border-slate-200/70 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="esnna-legal-heading">
      <span class="absolute inset-y-[15%] left-0 w-1 rounded-r-full bg-[#b71532]" aria-hidden="true"></span>
      <div class="flex flex-col items-start gap-4 pl-2 sm:flex-row sm:items-center">
        <span class="inline-flex shrink-0 rounded-2xl border border-[#b71532]/20 bg-[#b71532]/10 p-3 text-2xl" aria-hidden="true">
          &#9878;&#65039;
        </span>
        <div>
          <h2 id="esnna-legal-heading" class="m-0 text-sm font-semibold tracking-normal text-slate-800">Advertencia legal</h2>
          <blockquote class="m-0 mt-1 border-0 bg-transparent p-0 text-sm font-medium leading-relaxed text-[#9e0f2a]">
            <p class="m-0">&ldquo;En desarrollo de la Ley N.º 28251, la agencia advierte a los turistas que la explotación y el abuso sexual de menores en el país son penalizados penal y administrativamente, de acuerdo con las leyes vigentes.&rdquo;</p>
          </blockquote>
          <p class="mb-0 mt-2 flex items-center gap-2 text-xs text-slate-400">
            <span class="size-2 rounded-full bg-[#00a43d]" aria-hidden="true"></span>
            Dreamy Tours · Código de Conducta ESNNA · Versión actualizada
          </p>
        </div>
      </div>
    </section>

    <footer class="mt-8 text-center">
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-normal text-slate-500">
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/70 bg-white/80 px-4 py-1.5 shadow-sm"><span class="size-2 rounded-full bg-[#00a43d]" aria-hidden="true"></span>Compromiso ético</span>
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/70 bg-white/80 px-4 py-1.5 shadow-sm"><span class="size-2 rounded-full bg-[#b71532]" aria-hidden="true"></span>Tolerancia cero</span>
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/70 bg-white/80 px-4 py-1.5 shadow-sm"><span class="size-2 rounded-full bg-[#00a43d]" aria-hidden="true"></span>Protección infantil</span>
      </div>
      <div class="mt-6 h-px w-full bg-gradient-to-r from-transparent via-[#00a43d]/30 to-transparent" aria-hidden="true"></div>
      <p class="mb-0 mt-3 text-[0.6rem] uppercase tracking-[0.2em] text-slate-400">✦ Dreamy Tours · Protegiendo el futuro de nuestros niños ✦</p>
    </footer>

    <section class="mt-12 border-t border-slate-200/80 pt-10 sm:pt-12" aria-labelledby="esnna-certificates-heading">
      <div class="mb-6 text-center">
        <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-[#008a32]">Dreamy Tours</p>
        <h2 id="esnna-certificates-heading" class="m-0 text-2xl font-bold tracking-[-0.03em] text-slate-800 sm:text-3xl">Certificaciones</h2>
      </div>
      <CertificatesGallery
        actionLabel="Ver"
        dialogLabel="Certificación"
        closeLabel="Cerrar ventana de certificaciones"
        certificates={[
          { src: "/imagenes/certificados/codigo-esnna.avif", title: "Código ESNNA" },
          {
            src: "/imagenes/certificados/turismo-responsable.avif",
            title: "Turismo Responsable",
          },
        ]}
      />
    </section>
  </div>
</main>
