---
import PageLayout from "../../layouts/PageLayout.astro";
import MachuPicchuAvailabilityDesign from "../../components/content/MachuPicchuAvailabilityDesign.astro";
export const prerender = false;
if (!import.meta.env.DEV) return new Response(null, { status: 404 });
---

<PageLayout
  lang="es"
  seo={{
    title: "Disponibilidad de Machu Picchu | Dreamy Tours",
    description: "Elige tu fecha, circuito y horario de visita a Machu Picchu.",
    robots: "noindex,nofollow",
  }}
>
  <MachuPicchuAvailabilityDesign />
</PageLayout>
