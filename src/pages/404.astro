---
export const prerender = false;

import "../styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import type { Global, Link } from "@/types/global";

Astro.response.status = 404;

// Keep this route independent from the shared layout and the CMS.
const firstSegment = Astro.url.pathname.split("/")[1];
const lang: "en" | "es" | "pt" =
  firstSegment === "es" || firstSegment === "pt" ? firstSegment : "en";

const contentByLang = {
  en: {
    eyebrow: "Route 404",
    titleBefore: "This route is ",
    titleAccent: "off the map.",
    description:
      "The page you were looking for may have moved, changed its name or never existed. Let's find a new direction for your journey.",
    back: "Go back",
    packages: "View Peru packages",
    home: "Go to home",
    blog: "Explore the blog",
    routeNote: "Every great adventure starts by finding the right path.",
    imageAlt: "Illustration of a traveler checking a map after getting lost",
    imageLabel: "Recalculating route",
    imageCaption: "Your next adventure is still waiting for you.",
  },
  es: {
    eyebrow: "Ruta 404",
    titleBefore: "Esta ruta no está ",
    titleAccent: "en el mapa.",
    description:
      "La página que buscabas pudo cambiar de lugar, de nombre o quizá nunca existió. Busquemos una nueva dirección para tu viaje.",
    back: "Volver atrás",
    packages: "Ver paquetes de Perú",
    home: "Ir al inicio",
    blog: "Explorar el blog",
    routeNote: "Toda gran aventura comienza al encontrar el camino correcto.",
    imageAlt: "Ilustración de un viajero consultando un mapa tras perderse",
    imageLabel: "Recalculando ruta",
    imageCaption: "Tu próxima aventura todavía te está esperando.",
  },
  pt: {
    eyebrow: "Rota 404",
    titleBefore: "Esta rota não está ",
    titleAccent: "no mapa.",
    description:
      "A página que você procurava pode ter mudado de lugar, de nome ou talvez nunca existido. Vamos encontrar uma nova direção para a sua viagem.",
    back: "Voltar",
    packages: "Ver pacotes do Peru",
    home: "Ir ao início",
    blog: "Explorar o blog",
    routeNote: "Toda grande aventura começa ao encontrar o caminho certo.",
    imageAlt:
      "Ilustração de um viajante consultando um mapa depois de se perder",
    imageLabel: "Recalculando rota",
    imageCaption: "Sua próxima aventura ainda está esperando por você.",
  },
};

const content = contentByLang[lang];
const homeUrl = lang === "en" ? "/" : `/${lang}/`;
const packagesUrlByLang = {
  en: "/peru-packages/",
  es: "/es/paquetes-peru/",
  pt: "/pt/pacotes-peru/",
};

// The shared components are real site components. Their fallback data is kept
// here so rendering a missing route never depends on Strapi being available.
const link = (id: number, label: string, url: string): Link => ({
  id,
  label,
  url,
  isButton: false,
  isExternal: /^(?:https?:|mailto:)/.test(url),
});

const shellData: Global = {
  id: 0,
  documentId: "not-found-shell",
  createdAt: "",
  updatedAt: "",
  publishedAt: "",
  locale: lang,
  topBar: {
    id: 1,
    isVisible: true,
    text: "Inca Trail 4 Days availability: 2026-2027.",
    link: link(1, "Book now and don't miss out!", "/inca-trail-availability/"),
  },
  headerTop: {
    id: 1,
    logo: {
      id: 1,
      label: "Dreamy Tours",
      url: "/",
      isExternal: false,
      imagen: {} as never,
    },
    headerLink: [
      link(2, "Blog", "/blog/"),
      link(3, "info@dreamy.tours", "mailto:info@dreamy.tours"),
      link(4, "WhatsApp", "https://wa.me/51969787221"),
    ],
    button: [link(5, "Inca Trail Availability 2026", "/inca-trail-availability/")],
  },
  menu: {
    id: 1,
    menuItems: [
      { id: 1, link: link(10, "Inca Trails Machu Picchu", "/inca-trail/"), item: [] },
      { id: 2, link: link(11, "Alternative Treks", "/alternative-treks/"), item: [] },
      { id: 3, link: link(12, "Perú Packages", "/peru-packages/"), item: [] },
      { id: 4, link: link(13, "Bolivia", "/bolivia/"), item: [] },
      { id: 5, link: link(14, "Chile", "/chile/"), item: [] },
      { id: 6, link: link(15, "Plan Your Trip", "/plan-your-trip/"), item: [] },
    ],
  },
  footer: {
    id: 1,
    logo: {
      id: 1,
      label: "Dreamy Tours",
      url: "/",
      isExternal: false,
      imagen: {} as never,
    },
    content:
      "We provide our clients with unique travel experiences, meeting the highest standards of safety, punctuality, reliability, operational excellence and quality of service.",
    socialTitle: "Follow us",
    socialLogo: [],
    destination: {
      id: 1,
      titulo: "Destinations",
      link: [
        link(20, "Cusco", "/cusco/"),
        link(21, "Machu Picchu", "/inca-trail/"),
        link(22, "Puno", "/puno/"),
        link(23, "Lima", "/lima/"),
        link(24, "Arequipa", "/arequipa/"),
      ],
    },
    dreamyAbout: {
      id: 1,
      titulo: "Dreamy Tours",
      link: [
        link(30, "About Us", "/about-us/"),
        link(31, "Company Policies", "/privacy-policy/"),
        link(32, "Payment Methods", "/payment-methods/"),
        link(33, "Blog", "/blog/"),
      ],
    },
    contact: {
      id: 1,
      titulo: "Contact",
      link: [
        link(40, "info@dreamy.tours", "mailto:info@dreamy.tours"),
        link(41, "+51 969 787 221", "https://wa.me/51969787221"),
        link(42, "Cusco, Peru", "#"),
      ],
    },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 - {content.titleBefore}{content.titleAccent}</title>
  </head>
  <body>
    <Header data={shellData} lang={lang} languageUrls={{}} />
    <main
      class="relative isolate overflow-hidden bg-background px-6 py-12 md:py-16 lg:py-20"
    >
      <span
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--primary)_28%,transparent)_1px,transparent_1.25px)] bg-[size:1.1rem_1.1rem] [mask-image:radial-gradient(ellipse_48rem_30rem_at_88%_42%,black,transparent_74%)]"
        aria-hidden="true"></span>
      <span
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--secondary)_22%,transparent)_1px,transparent_1.25px)] bg-[position:0.55rem_0.55rem] bg-[size:1.1rem_1.1rem] [mask-image:radial-gradient(ellipse_38rem_24rem_at_10%_72%,black,transparent_72%)]"
        aria-hidden="true"></span>

      <div
        class="mx-auto grid min-h-[calc(100svh-13rem)] max-w-7xl items-center gap-12 lg:grid-cols-[minmax(0,0.96fr)_minmax(25rem,0.84fr)] lg:gap-20"
      >
        <div
          class="relative max-w-2xl py-4 lg:col-start-2 lg:row-start-1 lg:py-8"
        >
          <p
            class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-background/85 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-primary shadow-[0_12px_26px_-22px_color-mix(in_oklab,var(--primary)_80%,transparent)] backdrop-blur-sm"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              ><circle
                cx="12"
                cy="12"
                r="8"
                stroke="currentColor"
                stroke-width="2"></circle><path
                d="m15 9-2.4 4.8L9 15l2.4-4.8L15 9Z"
                fill="currentColor"></path></svg
            >
            {content.eyebrow}
          </p>

          <p
            class="pointer-events-none mt-7 select-none text-[clamp(10rem,25vw,17.5rem)] font-black leading-[0.76] tracking-[-0.1em] text-primary"
            aria-hidden="true"
          >
            404
          </p>

          <div class="relative mt-5">
            <p
              class="text-sm font-bold uppercase tracking-[0.22em] text-secondary"
            >
              Dreamy Tours · Perú & Bolivia
            </p>
            <h1
              class="mt-4 max-w-xl text-balance text-4xl font-black leading-[0.98] tracking-[-0.055em] text-primary sm:text-5xl md:text-6xl"
            >
              {content.titleBefore}<span class="text-secondary"
                >{content.titleAccent}</span
              >
            </h1>
            <p
              class="mt-6 max-w-xl text-pretty text-lg leading-8 text-muted-foreground md:text-xl md:leading-9"
            >
              {content.description}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a
                href={homeUrl}
                onclick="if (window.history.length > 1) { window.history.back(); return false; }"
                class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-primary/30 bg-background/80 px-6 py-3 text-sm font-bold text-primary shadow-[0_16px_28px_-24px_color-mix(in_oklab,var(--primary)_85%,transparent)] transition duration-300 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg
                  class="size-4 transition-transform duration-300 group-hover:-translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  ><path
                    d="m15 18-6-6 6-6"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
                {content.back}
              </a>
              <a
                href={packagesUrlByLang[lang]}
                class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-secondary/30 bg-background/80 px-6 py-3 text-sm font-bold text-secondary shadow-[0_16px_28px_-24px_color-mix(in_oklab,var(--secondary)_85%,transparent)] transition duration-300 hover:-translate-y-0.5 hover:border-secondary/50 hover:bg-secondary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  ><path
                    d="M3 6.5 12 3l9 3.5v11L12 21l-9-3.5v-11Z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"></path><path
                    d="M3 6.5 12 10l9-3.5M12 10v11"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"></path></svg
                >
                {content.packages}
                <svg
                  class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  ><path
                    d="m9 18 6-6-6-6"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </a>
              <a
                href={homeUrl}
                class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-[0_18px_30px_-18px_color-mix(in_oklab,var(--primary)_90%,transparent)] transition duration-300 hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-[0_22px_34px_-18px_color-mix(in_oklab,var(--primary)_95%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                {content.home}
                <svg
                  class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  ><path
                    d="m9 18 6-6-6-6"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </a>
            </div>

            <p
              class="mt-8 flex max-w-lg items-start gap-3 text-sm leading-6 text-muted-foreground"
            >
              <span
                class="mt-2 h-px w-9 shrink-0 bg-secondary"
                aria-hidden="true"></span>{content.routeNote}
            </p>
          </div>
        </div>

        <figure
          class="relative mx-auto w-full max-w-xl lg:col-start-1 lg:row-start-1 lg:justify-self-start"
        >
          <span
            class="pointer-events-none absolute -left-4 top-[17%] size-16 rounded-full border border-secondary/35 bg-background/80"
            aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute -right-5 bottom-[22%] size-20 rounded-full border border-primary/25 bg-background/80"
            aria-hidden="true"></span>
          <div
            class="relative aspect-square overflow-hidden rounded-[2.4rem] border border-primary/20 bg-background p-5 shadow-[0_32px_70px_-40px_rgb(15_23_42_/_0.35)] sm:p-8"
          >
            <span
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--primary)_35%,transparent)_1px,transparent_1.2px)] bg-[size:1rem_1rem] opacity-50 [mask-image:radial-gradient(circle_at_52%_42%,black,transparent_68%)]"
              aria-hidden="true"></span>
            <span
              class="pointer-events-none absolute left-[14%] top-[15%] h-px w-[24%] bg-secondary/70"
              aria-hidden="true"></span>
            <span
              class="pointer-events-none absolute right-[13%] top-[15%] grid size-12 place-items-center rounded-full border border-secondary/25 bg-background/90 text-secondary shadow-sm"
              aria-hidden="true"
              ><svg class="size-5" viewBox="0 0 24 24" fill="none"
                ><circle
                  cx="12"
                  cy="12"
                  r="8"
                  stroke="currentColor"
                  stroke-width="1.7"></circle><path
                  d="m15 9-2.4 4.8L9 15l2.4-4.8L15 9Z"
                  fill="currentColor"></path></svg
              ></span
            >
            <img
              src="/imagenes/404.webp"
              alt={content.imageAlt}
              width="1080"
              height="1080"
              fetchpriority="high"
              decoding="async"
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 32rem, calc(100vw - 3rem)"
              class="absolute inset-0 z-10 m-auto h-[62%] w-[62%] animate-bounce object-contain object-center [animation-duration:8s] [animation-timing-function:cubic-bezier(0.4,0,0.2,1)] drop-shadow-[0_24px_22px_rgba(46,43,34,0.22)] motion-reduce:animate-none"
            />
          </div>
          <figcaption
            class="relative z-20 -mt-8 ml-5 max-w-[18rem] rounded-2xl border border-secondary/20 bg-background px-5 py-4 shadow-[0_20px_38px_-26px_rgb(15_23_42_/_0.3)] sm:ml-8"
          >
            <p
              class="flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.15em] text-secondary"
            >
              <span
                class="size-1.5 rounded-full bg-secondary"
                aria-hidden="true"></span>{content.imageLabel}
            </p>
            <p class="mt-1.5 text-sm font-semibold leading-5 text-foreground">
              {content.imageCaption}
            </p>
          </figcaption>
        </figure>
      </div>
    </main>
    <Footer data={shellData.footer} lang={lang} />
  </body>
</html>
