---
export const prerender = false;

Astro.response.status = 404;

// This page must remain independent of the CMS and the shared site layout.
const firstSegment = Astro.url.pathname.split("/")[1];
const lang =
  firstSegment === "es" || firstSegment === "pt" ? firstSegment : "en";
const contentByLang = {
  en: {
    title: "This route is off the map.",
    description:
      "The page you are looking for may have moved or no longer exists.",
    home: "Go to home",
    blog: "Explore the blog",
  },
  es: {
    title: "Esta ruta no está en el mapa.",
    description: "La página que buscas pudo cambiar de lugar o ya no existe.",
    home: "Ir al inicio",
    blog: "Explorar el blog",
  },
  pt: {
    title: "Esta rota não está no mapa.",
    description:
      "A página que você procura pode ter mudado de lugar ou não existir mais.",
    home: "Ir ao início",
    blog: "Explorar o blog",
  },
};
const content = contentByLang[lang];
const homeUrl = lang === "en" ? "/" : `/${lang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 - {content.title}</title>
    <style is:inline>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f7f8f4;
        color: #173c30;
        font:
          1rem/1.6 system-ui,
          sans-serif;
      }
      main {
        max-width: 42rem;
        margin: 0 auto;
        padding: clamp(3rem, 12vh, 8rem) 1.5rem;
      }
      .brand {
        font-weight: 700;
        letter-spacing: 0.08em;
      }
      .code {
        margin: 2rem 0 0;
        font-size: clamp(5rem, 20vw, 9rem);
        font-weight: 800;
        line-height: 1;
      }
      h1 {
        font-size: clamp(1.75rem, 5vw, 2.75rem);
        line-height: 1.2;
      }
      p {
        max-width: 34rem;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
      }
      a {
        display: inline-block;
        padding: 0.75rem 1.25rem;
        border: 1px solid #173c30;
        border-radius: 0.5rem;
        color: inherit;
        font-weight: 600;
        text-underline-offset: 0.2em;
      }
      a:first-child {
        background: #173c30;
        color: #fff;
      }
      a:hover {
        text-decoration-thickness: 0.15em;
      }
      a:focus-visible {
        outline: 3px solid #986000;
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">DREAMY TOURS</p>
      <p class="code">404</p>
      <h1>{content.title}</h1>
      <p>{content.description}</p>
      <div class="links">
        <a href={homeUrl}>{content.home}</a>
        <a href={`${homeUrl}blog/`}>{content.blog}</a>
      </div>
    </main>
  </body>
</html>
