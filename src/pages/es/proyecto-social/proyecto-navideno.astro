---
import { purposeSeo } from "@/data/purposeSeo";
import { purposeSlugs } from "@/lib/purposeRoutes";
import DynamicContentPage from "@/components/pages/DynamicContentPage.astro";
import * as content from "@/components/content/ChristmasProjectContent.astro";
export const frontmatter = {
  title: "Proyecto Navideño",
  heroEyebrow: "Compartir nos une",
  description: purposeSeo.christmas.es.metaDescription,
  lang: "es",
  layout: "editorial",
  heroImage: "/imagenes/proyecto-social/navidad/navidad-dreamy-tour.webp",
  heroImagePosition: "bottom",
  heroImageAlt:
    "Equipo de Dreamy Tours y niños compartiendo una celebración navideña",
  seo: purposeSeo.christmas.es,
} as const;
---

<DynamicContentPage
  type="content"
  lang="es"
  contentComponent={content}
  pageSlugMap={purposeSlugs.christmas}
  contentFrontmatter={frontmatter}
/>
