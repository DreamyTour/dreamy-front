---
import Layout from "@/layouts/main.astro";
import type { SEOProps } from "@/components/layout/SEO.astro";
import type { Lang } from "@/lib/i18n";

interface Props {
  seo?: SEOProps;
  lang?: Lang;
  enableViewTransitions?: boolean;
}

const { seo, lang, enableViewTransitions } = Astro.props;
---

<Layout seo={seo} lang={lang} enableViewTransitions={enableViewTransitions}>
  <slot />
</Layout>
