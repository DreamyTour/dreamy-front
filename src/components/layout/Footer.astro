---
import Certification from "@/components/layout/Certification.astro";
import {
  EmailIcon,
  WhatsAppIcon,
  PhoneIcon,
  LocationIcon,
} from "@/components/icons/SocialContactIcons";
import type { Footer as FooterType } from "@/types/global";
import type { Lang } from "@/lib/i18n";
import { getImageUrl } from "@/lib/helpers";
import { rewriteUrl } from "@/lib/utils";
import { normalizeWhatsAppUrl } from "@/lib/socialLinks";

interface Props {
  data?: FooterType;
  lang: Lang;
}

const { data, lang } = Astro.props;

const complaintsBook = {
  es: {
    href: "/es/libro-reclamaciones",
    label: "Libro de Reclamaciones",
    eyebrow: "Atención al cliente",
  },
  en: {
    href: "/complaints-book",
    label: "Complaints Book",
    eyebrow: "Customer support",
  },
  pt: {
    href: "/pt/livro-de-reclamacoes",
    label: "Livro de Reclamações",
    eyebrow: "Atendimento ao cliente",
  },
}[lang];

const isComplaintsBookLink = (link: { label?: string; url?: string }) =>
  /reclam|complaint/i.test(`${link.label || ""} ${link.url || ""}`);

const dreamyAboutLinks = data?.dreamyAbout?.link?.filter(
  (link) => !isComplaintsBookLink(link),
);
---

<footer
  class="dreamy-footer relative overflow-hidden bg-[#081711] pt-8 pb-10 text-white"
>
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,_#0b1d15_0%,_#081711_58%,_#050907_100%)]"
    >
    </div>
    <div class="dreamy-footer-pattern absolute inset-0"></div>
    <div
      class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"
    >
    </div>
    <div
      class="absolute left-0 top-0 h-full w-full bg-[radial-gradient(circle_at_50%_0%,_rgba(255,255,255,0.08),_transparent_38%)]"
    >
    </div>
  </div>

  <div class="relative z-10">
    <Certification lang={lang} />

    <div class="max-w-8xl mx-auto px-6 pt-8 md:px-10 lg:pt-10">
      <div class="border-b border-white/10 py-8 lg:py-10">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
          <div
            class="flex flex-col border-b border-white/10 pb-10 lg:col-span-5 lg:border-b-0 lg:border-r lg:pr-12"
          >
            <a
              href="/"
              class="group mb-7 inline-block w-max focus:outline-hidden"
            >
              <img
                src="/logo-dreamytours.svg"
                alt="Logo Dreamy Tours"
                class="h-16 w-auto brightness-0 invert drop-shadow-sm transition-opacity duration-300 group-hover:opacity-85 md:h-[72px]"
                width="220"
                height="80"
                loading="lazy"
                decoding="async"
              />
            </a>
            {
              data?.content && (
                <p class="max-w-md text-base leading-8 text-white/64">
                  {data.content}
                </p>
              )
            }
          </div>

          <div
            class="grid grid-cols-1 gap-9 md:grid-cols-2 lg:col-span-4 lg:gap-10"
          >
            <div class="flex flex-col gap-5">
              {
                data?.destination?.titulo && (
                  <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-white/82">
                    {data.destination.titulo}
                  </h3>
                )
              }
              {
                data?.destination?.link && data.destination.link.length > 0 && (
                  <ul class="flex flex-col gap-3">
                    {data.destination.link.map((link) => (
                      <li>
                        <a
                          href={rewriteUrl(
                            normalizeWhatsAppUrl(link.label, link.url) || "",
                            lang,
                          )}
                          class="group inline-flex items-center text-[0.95rem] text-white/62 transition-colors duration-300 hover:text-white"
                          target={link.isExternal ? "_blank" : "_self"}
                          rel={link.isExternal ? "noopener noreferrer" : ""}
                        >
                          <span class="mr-0 h-px w-0 bg-white/70 transition-all duration-300 ease-out group-hover:mr-2 group-hover:w-3" />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>

            <div class="flex flex-col gap-5">
              {
                data?.dreamyAbout?.titulo && (
                  <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-white/82">
                    {data.dreamyAbout.titulo}
                  </h3>
                )
              }
              {
                dreamyAboutLinks && dreamyAboutLinks.length > 0 && (
                  <ul class="flex flex-col gap-3">
                    {dreamyAboutLinks.map((link) => (
                      <li>
                        <a
                          href={rewriteUrl(
                            normalizeWhatsAppUrl(link.label, link.url) || "",
                            lang,
                          )}
                          class="group inline-flex items-center text-[0.95rem] text-white/62 transition-colors duration-300 hover:text-white"
                          target={link.isExternal ? "_blank" : "_self"}
                          rel={link.isExternal ? "noopener noreferrer" : ""}
                        >
                          <span class="mr-0 h-px w-0 bg-white/70 transition-all duration-300 ease-out group-hover:mr-2 group-hover:w-3" />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </div>

          <div class="flex flex-col gap-5 lg:col-span-3">
            {
              data?.contact?.titulo && (
                <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-white/82">
                  {data.contact.titulo}
                </h3>
              )
            }
            {
              data?.contact?.link && data.contact.link.length > 0 && (
                <ul class="flex flex-col gap-3.5">
                  {data.contact.link.map((link, index) => {
                    const isLink = index < 2;
                    const content = (
                      <>
                        <span
                          class={`mt-0.5 shrink-0 text-emerald-50/75 transition-all duration-300 ${isLink ? "group-hover:scale-110 group-hover:text-emerald-400" : ""}`}
                        >
                          {index === 0 && <EmailIcon className="size-5" />}
                          {index === 1 && <WhatsAppIcon className="size-5" />}
                          {index === 2 && <PhoneIcon className="size-5" />}
                          {(index === 3 || index === 4) && (
                            <LocationIcon className="size-5" />
                          )}
                        </span>
                        <span class="leading-relaxed">{link.label}</span>
                      </>
                    );

                    return (
                      <li>
                        {isLink ? (
                          <a
                            href={rewriteUrl(
                              normalizeWhatsAppUrl(link.label, link.url) || "",
                              lang,
                            )}
                            class="group flex items-start gap-3 text-[0.92rem] text-white/62 transition-colors duration-300 hover:text-emerald-400"
                            target={link.isExternal ? "_blank" : "_self"}
                            rel={link.isExternal ? "noopener noreferrer" : ""}
                          >
                            {content}
                          </a>
                        ) : (
                          <span class="flex items-start gap-3 text-[0.92rem] text-white/62">
                            {content}
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              )
            }

            <a
              href={complaintsBook.href}
              class="group mt-2 inline-flex w-fit items-center gap-3 border-t border-white/12 pt-5 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-200"
            >
              <svg
                viewBox="0 0 48 40"
                fill="none"
                class="h-10 w-12 shrink-0 text-emerald-100/75 transition-transform duration-300 group-hover:-rotate-2 group-hover:scale-105 group-hover:text-emerald-100 motion-reduce:transition-none motion-reduce:group-hover:rotate-0 motion-reduce:group-hover:scale-100"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M24 10.2C19.2 6.7 12.1 6.1 5 8.7v24.2c7.1-2.6 14.2-2 19 1.5V10.2Z"
                ></path>
                <path
                  d="M24 10.2c4.8-3.5 11.9-4.1 19-1.5v24.2c-7.1-2.6-14.2-2-19 1.5V10.2Z"
                ></path>
                <path
                  d="M9.5 13.2c4.1-1.3 8.3-.9 11.5.8M9.5 18.3c4.1-1.3 8.3-.9 11.5.8M38.5 13.2c-4.1-1.3-8.3-.9-11.5.8M38.5 18.3c-4.1-1.3-8.3-.9-11.5.8"
                ></path>
                <path d="M24 10.2v24.2"></path>
              </svg>
              <span class="flex flex-col">
                <span
                  class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-emerald-100/55"
                >
                  {complaintsBook.eyebrow}
                </span>
                <span
                  class="text-[0.95rem] font-semibold text-white/85 transition-colors duration-300 group-hover:text-emerald-100 motion-reduce:transition-none"
                >
                  {complaintsBook.label}
                </span>
              </span>
              <svg
                viewBox="0 0 20 20"
                fill="none"
                class="size-4 shrink-0 text-emerald-100/55 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:text-emerald-100 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col items-center gap-6 pt-6 md:flex-row md:justify-between"
      >
        <p
          class="text-center text-sm leading-relaxed text-white/55 xl:text-left"
        >
          <span class="font-medium text-white/75">
            &copy; {new Date().getFullYear()} Inversiones Dreamy Tours E.I.R.L.
          </span>
          <span
            class="mx-2 hidden h-1 w-1 rounded-full bg-emerald-200/55 sm:inline-block"
          ></span>
          <span class="block sm:inline">RUC: 20609347318</span>
        </p>

        {
          data?.socialLogo && data.socialLogo.length > 0 && (
            <div class="flex items-center gap-3">
              {data?.socialTitle && (
                <span class="mr-2 hidden text-xs font-semibold uppercase tracking-[0.18em] text-white/45 sm:block">
                  {data.socialTitle}
                </span>
              )}
              {data.socialLogo.map((social) => (
                <a
                  href={normalizeWhatsAppUrl(social.label, social.url)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Siguenos en ${social.label || "red social"}`}
                  class="footer-social-link group relative flex h-11 w-11 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-white/[0.04] transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-110 hover:border-emerald-200/60 hover:bg-emerald-300/15 hover:shadow-[0_0_0_5px_rgba(110,231,183,0.08),0_14px_28px_rgba(16,185,129,0.28)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-200 active:scale-100 motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:scale-100"
                >
                  <span
                    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_24%,rgba(255,255,255,0.58),transparent_26%),linear-gradient(135deg,rgba(110,231,183,0.32),rgba(16,185,129,0.08))] opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
                    aria-hidden="true"
                  />
                  <span
                    class="pointer-events-none absolute inset-1 rounded-full border border-white/35 opacity-0 scale-75 transition-[opacity,scale] duration-300 group-hover:scale-100 group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-75"
                    aria-hidden="true"
                  />
                  {social.imagen?.url && (
                    <img
                      src={getImageUrl(social.imagen)}
                      alt=""
                      aria-hidden="true"
                      class="relative z-10 h-5 w-auto opacity-85 transition-all duration-300 group-hover:scale-110 group-hover:brightness-125 group-hover:opacity-100 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .dreamy-footer {
    isolation: isolate;
  }

  .dreamy-footer-pattern {
    background-image: url("/fondo.svg");
    background-position: center top;
    background-repeat: repeat;
    background-size: clamp(26rem, 38vw, 38rem) clamp(26rem, 38vw, 38rem);
    filter: invert(1) sepia(0.2) saturate(0.45) contrast(1.08);
    opacity: 0.2;
    mix-blend-mode: soft-light;
  }

  .dreamy-footer-pattern::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 82% 8%,
        color-mix(in oklab, var(--accent-warm) 18%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 18% 88%,
        color-mix(in oklab, var(--primary) 16%, transparent),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, black 8%, transparent),
        transparent 36%,
        color-mix(in oklab, black 36%, transparent)
      );
  }

  @media (max-width: 767px) {
    .dreamy-footer-pattern {
      background-position: center top;
      background-size: 24rem 24rem;
      opacity: 0.07;
    }
  }

  @media (forced-colors: active) {
    .dreamy-footer-pattern {
      display: none;
    }
  }
</style>
