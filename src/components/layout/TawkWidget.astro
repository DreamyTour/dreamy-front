---
import type { Lang } from "@/lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const statusLabels = {
  es: "En línea",
  en: "Online",
  pt: "Online",
} satisfies Record<Lang, string>;

const triggerLabels = {
  es: "Abrir el chat de Dreamy Tours",
  en: "Open the Dreamy Tours chat",
  pt: "Abrir o chat da Dreamy Tours",
} satisfies Record<Lang, string>;

const statusLabel = statusLabels[lang];
const triggerLabel = triggerLabels[lang];
---

<aside class="tawk-chat-trigger fixed z-[61]">
  <button
    id="tawk-chat-trigger"
    type="button"
    aria-label={triggerLabel}
    title={triggerLabel}
    class="group inline-flex items-center gap-3 rounded-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#e03445] focus-visible:ring-offset-2"
  >
    <span
      id="tawk-online-badge"
      aria-label={statusLabel}
      role="status"
      hidden
      class="tawk-chat-status pointer-events-none inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-[#e03445]/20 bg-white/95 px-3 py-2 text-sm font-bold tracking-tight text-[#b71532] shadow-lg shadow-[#b71532]/15 backdrop-blur"
    >
      <span class="relative flex size-2.5" aria-hidden="true">
        <span class="tawk-online-pulse absolute inset-0 rounded-full bg-[#e03445]"></span>
        <span class="relative size-2.5 rounded-full bg-[#e03445] ring-2 ring-[#fce5e8]"></span>
      </span>
      {statusLabel}
    </span>

    <span
      class="flex size-15 shrink-0 items-center justify-center rounded-full bg-[#e03445] text-white shadow-lg shadow-[#8e1023]/30 ring-1 ring-white/25 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:scale-105 group-hover:bg-[#c8243b]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 11.5a7.5 7.5 0 0 1-8 7.48 8.4 8.4 0 0 1-3.65-.9L4 19.5l1.35-3.56A7.3 7.3 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z"></path>
        <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path>
      </svg>
    </span>
  </button>
</aside>

<script is:inline>
  (() => {
    const badgeId = "tawk-online-badge";

    const setStatus = (status) => {
      window.__dreamyTawkStatus = status;

      const badge = document.getElementById(badgeId);
      if (badge) {
        badge.toggleAttribute("hidden", status !== "online");
      }
    };

    window.__dreamyTawkSetStatus = setStatus;

    if (window.__dreamyTawkStatus) {
      setStatus(window.__dreamyTawkStatus);
    }

    if (!window.__dreamyTawkBadgeNavigationListener) {
      window.__dreamyTawkBadgeNavigationListener = true;
      document.addEventListener("astro:after-swap", () => {
        window.__dreamyTawkSetStatus?.(window.__dreamyTawkStatus);
      });
    }

    if (window.__dreamyTawkLoaded) return;

    window.__dreamyTawkLoaded = true;
    window.Tawk_API = window.Tawk_API || {};
    window.Tawk_LoadStart = new Date();

    const previousOnLoad = window.Tawk_API.onLoad;
    const previousOnStatusChange = window.Tawk_API.onStatusChange;
    const previousOnChatMinimized = window.Tawk_API.onChatMinimized;

    window.Tawk_API.onLoad = function () {
      previousOnLoad?.();
      setStatus(window.Tawk_API.getStatus?.());
      window.Tawk_API.hideWidget?.();
    };

    window.Tawk_API.onStatusChange = function (status) {
      previousOnStatusChange?.(status);
      setStatus(status);
    };

    window.Tawk_API.onChatMinimized = function () {
      previousOnChatMinimized?.();
      window.Tawk_API.hideWidget?.();
    };

    if (!window.__dreamyTawkTriggerListener) {
      window.__dreamyTawkTriggerListener = true;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest("#tawk-chat-trigger")) return;

        window.Tawk_API?.showWidget?.();
        window.Tawk_API?.maximize?.();
      });
    }

    window.Tawk_API.customStyle = {
      zIndex: "60 !important",
      visibility: {
        desktop: {
          position: "br",
          xOffset: 16,
          yOffset: 16,
        },
        mobile: {
          position: "br",
          xOffset: 16,
          yOffset: 16,
        },
      },
    };

    const script = document.createElement("script");
    script.id = "tawk-to-widget";
    script.async = true;
    script.src = "https://embed.tawk.to/5e2c76118e78b86ed8ab1025/default";
    script.setAttribute("crossorigin", "*");
    document.head.appendChild(script);
  })();
</script>

<style>
  .tawk-chat-trigger {
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    inset-inline-end: max(1rem, env(safe-area-inset-right));
  }

  @media (min-width: 64rem) {
    .tawk-chat-trigger {
      inset-block-end: max(4.75rem, env(safe-area-inset-bottom));
    }
  }

  .tawk-online-pulse {
    animation: tawk-online-pulse 1.7s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes tawk-online-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }

    50% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tawk-online-pulse {
      animation: none;
    }
  }
</style>
