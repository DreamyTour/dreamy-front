---
import type { HeaderTop as HeaderTopType } from "@/types/global";
import LanguageSwitcherInline from "@/components/LanguageSwitcherInline.astro";
import type { Lang } from "@/lib/i18n";
import { localizePath } from "@/lib/i18n";
import { rewriteUrl } from "@/lib/utils";
import TourSearch from "@/components/layout/TourSearch";

interface Props {
  data?: HeaderTopType;
  lang: Lang;
  availableLangs?: readonly Lang[];
}

const { data, lang, availableLangs } = Astro.props;
if (!data) return;

/**
 * El logo SIEMPRE apunta al home localizado.
 * No usamos data.logo.url de Strapi porque puede ser una URL absoluta
 * (empieza con "http") que rewriteUrl no localiza por diseño.
 * localizePath garantiza: en → "/", es → "/es", pt → "/pt"
 */
const logoUrl = localizePath("/", lang);
const headerCopy = {
  es: {
    contact: "Contacto directo",
    exploreNav: "Explora Dreamy Tours",
    quickActions: "Acciones rápidas",
  },
  en: {
    contact: "Direct contact",
    exploreNav: "Explore Dreamy Tours",
    quickActions: "Quick actions",
  },
  pt: {
    contact: "Contato direto",
    exploreNav: "Explore Dreamy Tours",
    quickActions: "Ações rápidas",
  },
}[lang];
const headerLinks = data.headerLink ?? [];
type HeaderLink = (typeof headerLinks)[number];

const getLinkLabel = (link: HeaderLink) => link.label?.trim() ?? "";
const isWhatsAppLink = (link: HeaderLink) =>
  /(?:wa\.me|api\.whatsapp\.com|whatsapp\.com)/i.test(link.url ?? "") ||
  /whatsapp/i.test(getLinkLabel(link));
const isRemovedHeaderPhone = (link: HeaderLink) =>
  /51953005373/i.test(`${getLinkLabel(link)} ${link.url ?? ""}`);
const isEmailLink = (link: HeaderLink) =>
  /(?:mailto:|mail\.google\.com)/i.test(link.url ?? "") ||
  getLinkLabel(link).includes("@");
const isBlogLink = (link: HeaderLink) =>
  /blog/i.test(`${getLinkLabel(link)} ${link.url ?? ""}`);
const isGayFriendlyLink = (link: HeaderLink) =>
  /gay\s*friendly|lgbt/i.test(`${getLinkLabel(link)} ${link.url ?? ""}`);

const contactLinks = headerLinks.filter(
  (link) => !isRemovedHeaderPhone(link) && (isWhatsAppLink(link) || isEmailLink(link)),
);
const exploreLinks = headerLinks.filter(
  (link) => !isWhatsAppLink(link) && !isEmailLink(link),
);

// Función helper para links / botones
const getLinkProps = (
  link: (typeof data.headerLink)[number] | (typeof data.button)[number],
) => {
  const isExternal = link.isExternal;
  return {
    target: isExternal ? "_blank" : "_self",
    rel: isExternal ? "noopener noreferrer" : undefined,
  };
};
---

<section
  class="hidden w-full border-b border-border/60 bg-background text-foreground xl:block"
>
  <div
    class="mx-auto flex max-w-8xl items-center justify-between gap-10 px-4 py-3.5"
  >
    <a
      href={logoUrl}
      target={data.logo?.isExternal ? "_blank" : "_self"}
      rel={data.logo?.isExternal ? "noopener noreferrer" : undefined}
      class="group block shrink-0"
      aria-label="Dreamy Tours - inicio"
    >
      <img
        src="/logo-dreamytours.svg"
        alt=""
        class="h-[72px] w-auto transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
        width="220"
        height="72"
        fetchpriority="high"
      />
    </a>

    <div class="flex min-w-0 flex-1 flex-col items-end gap-3">
      <div
        class="flex w-full flex-wrap items-center justify-end gap-x-4 gap-y-2"
      >
        {
          contactLinks.length > 0 && (
            <nav
              class="rounded-full border border-primary/15 bg-primary/[0.04] px-1 py-1 shadow-[0_4px_14px_rgba(15,23,42,0.05)]"
              aria-label={headerCopy.contact}
            >
              <ul class="flex items-center gap-1">
                {contactLinks.map((link, index) => {
                  const { target, rel } = getLinkProps(link);
                  const isWhatsApp = isWhatsAppLink(link);

                  return (
                    <li class={index === 0 ? "" : "border-l border-primary/15"}>
                      <a
                        href={rewriteUrl(link.url, lang)}
                        target={target}
                        rel={rel}
                        class="group inline-flex min-h-8 items-center gap-1.5 rounded-full px-2.5 text-xs font-semibold tabular-nums text-foreground/75 transition-colors duration-200 hover:bg-background hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 motion-reduce:transition-none"
                      >
                        <span
                          class={`flex size-4 shrink-0 items-center justify-center transition-transform duration-200 group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100 ${
                            isWhatsApp ? "text-[#20bd5a]" : "text-secondary"
                          }`}
                          aria-hidden="true"
                        >
                          {isWhatsApp ? (
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="size-3.5"
                            >
                              <path d="M21 11.5a8.38 8.38 0 0 1-9 8.5 9.3 9.3 0 0 1-4.5-1.2L3 20l1.4-4.2A8.5 8.5 0 1 1 21 11.5Z" />
                              <path d="M8.5 9.2c.2 2 2 4.1 4.1 4.5l1.2-1.2 1.7.8c.3.2.4.5.2.8-.5.8-1.3 1.2-2.2 1.1-3.2-.6-5.8-3.1-6.5-6.2-.2-.9.2-1.8.9-2.3.3-.2.7-.1.8.2l.8 1.6Z" />
                            </svg>
                          ) : (
                            <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-3.5"
                          >
                            <rect width="20" height="16" x="2" y="4" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                          )}
                        </span>
                        <span>{getLinkLabel(link)}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }

        {
          exploreLinks.length > 0 && (
            <nav
              class="rounded-full border border-border/70 bg-background p-1 shadow-[0_4px_14px_rgba(15,23,42,0.05)]"
              aria-label={headerCopy.exploreNav}
            >
              <ul class="flex items-center">
                {exploreLinks.map((link) => {
                  const { target, rel } = getLinkProps(link);
                  const isBlog = isBlogLink(link);
                  const isGayFriendly = isGayFriendlyLink(link);

                  return (
                    <li class="border-l border-border/65 px-1 first:border-l-0">
                      <a
                        href={rewriteUrl(link.url, lang)}
                        target={target}
                        rel={rel}
                        class={`inline-flex min-h-8 items-center rounded-full px-3 text-xs font-bold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 motion-reduce:transition-none ${
                          isGayFriendly
                            ? "border-[#c2185b] bg-[#c2185b] text-white shadow-[0_5px_14px_rgba(194,24,91,0.26)] hover:-translate-y-px hover:border-[#a9144e] hover:bg-[#a9144e] hover:shadow-[0_8px_20px_rgba(194,24,91,0.34)]"
                            : isBlog
                            ? "border border-primary/20 bg-primary/6 text-primary shadow-[0_1px_3px_rgba(15,70,60,0.08)] hover:-translate-y-px hover:bg-primary hover:text-primary-foreground hover:shadow-[0_5px_14px_rgba(15,70,60,0.18)]"
                            : "text-foreground/70 hover:-translate-y-px hover:bg-primary hover:text-primary-foreground hover:shadow-[0_5px_14px_rgba(15,70,60,0.18)]"
                        }`}
                      >
                        {isGayFriendly && <span aria-hidden="true" class="mr-1">✦</span>}
                        <span>{getLinkLabel(link)}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }
      </div>

      <div class="flex flex-wrap items-center justify-end gap-2">
        <TourSearch lang={lang} client:media="(min-width: 1280px)" />
        <nav class="hidden xl:block" aria-label={headerCopy.quickActions}>
          <ul class="flex flex-wrap justify-end gap-2">
            {
              data.button.filter((btn) => !isRemovedHeaderPhone(btn)).map((btn) => (
                <li>
                  <a
                    href={rewriteUrl(btn.url, lang)}
                    target={btn.isExternal ? "_blank" : "_self"}
                    rel={btn.isExternal ? "noopener noreferrer" : undefined}
                    class={`inline-flex items-center rounded-full border px-3.5 py-2 text-xs font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 motion-reduce:transition-none ${
                      isGayFriendlyLink(btn)
                        ? "border-[#c2185b] bg-[#c2185b] text-white shadow-[0_6px_16px_rgba(194,24,91,0.26)] hover:-translate-y-px hover:border-[#a9144e] hover:bg-[#a9144e] hover:shadow-[0_9px_22px_rgba(194,24,91,0.34)]"
                        : btn.type === "PRIMARY"
                        ? "border-secondary bg-secondary text-white hover:bg-secondary/90"
                        : "border-border bg-muted/60 text-foreground/75 hover:border-primary/25 hover:text-primary"
                    }`}
                  >
                    {isGayFriendlyLink(btn) && <span aria-hidden="true" class="mr-1">✦</span>}
                    {btn.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LanguageSwitcherInline
          currentLang={lang}
          availableLangs={availableLangs}
        />
      </div>
    </div>
  </div>
</section>
