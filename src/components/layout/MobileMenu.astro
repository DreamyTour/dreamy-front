---
import { LANGS, type Lang, localizePath, stripLangPrefix } from "@/lib/i18n";
import { rewriteUrl } from "@/lib/utils";
import type { Link, MenuItem, Menu as MenuType } from "@/types/global";

interface Props {
  menu: MenuType;
  quickActions?: Link[];
  logoUrl: string;
  lang: Lang;
  availableLangs?: readonly Lang[];
}

const {
  menu,
  quickActions = [],
  logoUrl,
  lang,
  availableLangs = LANGS,
} = Astro.props;
const languageNames: Record<Lang, string> = {
  en: "English",
  es: "Español",
  pt: "Português",
};
const languageFlags: Record<Lang, string> = {
  en: "/imagenes/flag/um.svg",
  es: "/imagenes/flag/es.svg",
  pt: "/imagenes/flag/br.svg",
};
---

<section
  class="relative xl:hidden"
  data-mobile-menu-root
  data-current-lang={lang}
  data-available-langs={availableLangs.join(",")}
>
  <nav
    class="relative z-50 mx-3 mt-3 rounded-2xl border border-white/70 bg-white/[0.88] px-3 py-2.5 shadow-[0_18px_45px_-30px_rgba(4,31,20,0.55)] backdrop-blur-xl"
    aria-label="Controles móviles"
  >
    <ul class="flex list-none items-center gap-2.5 p-0">
      <li class="min-w-0 shrink-0">
        <a href={logoUrl} class="block" aria-label="Dreamy Tours - inicio">
          <img
            src="/logo-dreamytours.svg"
            alt=""
            class="h-9 w-auto"
            width="110"
            height="40"
            fetchpriority="high"
          />
        </a>
      </li>

      <li class="ml-auto">
        <details class="group relative" data-language-switcher>
          <summary
            aria-label="Cambiar idioma"
            class="inline-flex h-10 min-w-[116px] cursor-pointer list-none items-center justify-between gap-2 rounded-xl border border-slate-200/80 bg-white/80 px-2.5 text-[13px] font-semibold text-slate-800 shadow-[0_8px_22px_-18px_rgba(15,23,42,0.75)] transition-[border-color,background-color,box-shadow] duration-200 hover:border-primary/25 hover:bg-white hover:shadow-[0_10px_26px_-18px_rgba(15,23,42,0.85)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/45 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden"
          >
            <span class="inline-flex items-center gap-2">
              <span
                class="grid size-6 shrink-0 place-items-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 shadow-[0_1px_2px_rgba(15,23,42,0.12)]"
              >
                <img
                  src={languageFlags[lang]}
                  alt=""
                  aria-hidden="true"
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              </span>
              <span>{languageNames[lang]}</span>
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-4 text-slate-500 transition-transform duration-200 group-open:rotate-180"
              aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
            >
          </summary>

          <div
            id="language-menu-mobile"
            role="menu"
            data-language-menu
            class="absolute right-0 z-50 mt-2 min-w-[170px] overflow-hidden rounded-xl border border-white/80 bg-white/[0.96] p-1.5 shadow-[0_20px_45px_-24px_rgba(4,31,20,0.42)] backdrop-blur-xl"
          >
            {
              availableLangs.map((optionLang) => {
                const selected = optionLang === lang;
                return (
                  <a
                    href={localizePath(
                      stripLangPrefix(Astro.url.pathname),
                      optionLang,
                    )}
                    role="menuitemradio"
                    aria-checked={selected}
                    data-language={optionLang}
                    class:list={[
                      "flex w-full items-center justify-between gap-3 rounded-sm px-3 py-2 text-left text-sm transition-colors duration-150 focus-visible:outline-none",
                      selected
                        ? "bg-primary/10 font-semibold text-primary ring-1 ring-inset ring-primary/15 hover:bg-primary/12 focus-visible:bg-primary/12"
                        : "text-slate-700 hover:bg-slate-100 focus-visible:bg-slate-100",
                    ]}
                  >
                    <span class="inline-flex items-center gap-2.5">
                      <span class="grid size-6 shrink-0 place-items-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 shadow-[0_1px_2px_rgba(15,23,42,0.12)]">
                        <img
                          src={languageFlags[optionLang]}
                          alt=""
                          aria-hidden="true"
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      </span>
                      <span>{languageNames[optionLang]}</span>
                    </span>
                    {selected && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        class="size-4 text-primary"
                        aria-hidden="true"
                      >
                        <path d="m5 12 4 4L19 6" />
                      </svg>
                    )}
                  </a>
                );
              })
            }
          </div>
        </details>
      </li>

      <li>
        <button
          type="button"
          data-menu-toggle
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-[#08281b] text-white shadow-[0_12px_25px_-14px_rgba(3,24,15,0.9)] transition-[transform,background-color,box-shadow] duration-200 hover:bg-[#0d3a27] hover:shadow-[0_14px_30px_-14px_rgba(3,24,15,0.95)] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            data-menu-open-icon
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="size-[25px]"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            data-menu-close-icon
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="hidden size-[25px]"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>

  <div
    hidden
    data-menu-overlay
    class="fixed inset-0 z-40 bg-[#06150e]/35 backdrop-blur-[3px]"
    aria-hidden="true"
  >
  </div>

  <nav
    id="mobile-menu"
    data-mobile-menu
    hidden
    class="absolute left-3 right-3 top-full z-50 mt-2 max-h-[calc(100dvh-92px)] overflow-y-auto rounded-[1.4rem] border border-white/80 bg-white/[0.96] p-2.5 shadow-[0_30px_70px_-38px_rgba(3,28,17,0.62)] backdrop-blur-xl animate-in fade-in slide-in-from-top-2 duration-300 ease-out motion-reduce:animate-none"
    aria-label="Menú principal"
  >
    <ul class="flex flex-col gap-2 px-0.5 pb-1 pt-0.5">
      {
        menu?.menuItems?.map((item: MenuItem) => {
          const hasChildren = Boolean(item.item?.length);
          const submenuId = `mobile-submenu-${item.id}`;
          return (
            <li>
              {hasChildren ? (
                <>
                  <button
                    type="button"
                    data-accordion-toggle
                    class="group relative inline-flex w-full items-center rounded-2xl border border-transparent px-4 py-3.5 text-[15px] font-semibold text-foreground transition-[background-color,border-color,color] duration-200 hover:border-primary/10 hover:bg-primary/[0.06] hover:text-primary"
                    aria-expanded="false"
                    aria-controls={submenuId}
                  >
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-y-3 left-1.5 w-0.5 rounded-full bg-secondary opacity-0 shadow-[0_0_10px_rgba(204,54,42,0.7)] transition-opacity group-hover:opacity-100"
                    />
                    <span class="inline-flex items-center gap-2">
                      <span>{item.link.label}</span>
                      {item.link.badge && (
                        <span class="rounded-full bg-secondary px-2 py-0.5 text-[10px] font-semibold leading-none text-secondary-foreground">
                          {item.link.badge}
                        </span>
                      )}
                    </span>
                    <svg
                      data-accordion-chevron
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="ml-auto size-[18px] text-muted-foreground/50 transition-transform duration-200"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                  <ul
                    id={submenuId}
                    hidden
                    data-accordion-panel
                    class="mb-2 mt-1 flex animate-in fade-in slide-in-from-top-1 flex-col gap-0.5 border-l border-primary/12 px-2.5 duration-200"
                  >
                    {item.item.map((subItem: Link) => (
                      <li>
                        <a
                          href={rewriteUrl(subItem.url, lang)}
                          data-menu-link
                          class="group relative flex min-w-0 items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-foreground/70 transition-[color,box-shadow] duration-200 hover:text-secondary hover:shadow-[0_8px_22px_-8px_color-mix(in_oklab,var(--secondary)_28%,transparent)] focus-visible:text-secondary focus-visible:shadow-[0_8px_22px_-8px_color-mix(in_oklab,var(--secondary)_28%,transparent)]"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            class="size-3.5 shrink-0 text-primary/45 transition-transform group-hover:translate-x-0.5 group-hover:text-secondary group-focus-visible:text-secondary"
                            aria-hidden="true"
                          >
                            <path d="m9 18 6-6-6-6" />
                          </svg>
                          <span class="min-w-0 truncate">{subItem.label}</span>
                          {subItem.badge && (
                            <span class="shrink-0 rounded-full bg-secondary px-2 py-0.5 text-[10px] font-semibold leading-none text-secondary-foreground">
                              {subItem.badge}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={rewriteUrl(item.link.url, lang)}
                  data-menu-link
                  class="group relative inline-flex w-full min-w-0 items-center rounded-2xl border border-transparent px-4 py-3.5 text-[15px] font-semibold text-foreground transition-[background-color,border-color,color] duration-200 hover:border-primary/10 hover:bg-primary/[0.06] hover:text-primary"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-y-3 left-1.5 w-0.5 rounded-full bg-secondary opacity-0 shadow-[0_0_10px_rgba(204,54,42,0.7)] transition-opacity group-hover:opacity-100"
                  />
                  <span class="inline-flex items-center gap-2">
                    <span>{item.link.label}</span>
                    {item.link.badge && (
                      <span class="rounded-full bg-secondary px-2 py-0.5 text-[10px] font-semibold leading-none text-secondary-foreground">
                        {item.link.badge}
                      </span>
                    )}
                  </span>
                </a>
              )}
            </li>
          );
        })
      }
    </ul>

    {
      quickActions.length > 0 && (
        <ul class="mt-3 grid gap-2 border-t border-primary/10 px-0.5 pb-1 pt-3">
          {quickActions.map((action) => (
            <li>
              <a
                href={rewriteUrl(action.url, lang)}
                target={action.isExternal ? "_blank" : "_self"}
                rel={action.isExternal ? "noopener noreferrer" : undefined}
                data-menu-link
                class:list={[
                  "inline-flex min-h-12 w-full min-w-0 items-center justify-center rounded-xl border px-4 py-3 text-center text-sm font-bold leading-snug transition-[background-color,border-color,box-shadow] duration-200",
                  action.type === "PRIMARY"
                    ? "border-secondary bg-secondary text-white shadow-[0_16px_34px_-24px_color-mix(in_oklab,var(--secondary)_80%,transparent)] hover:bg-secondary/90 hover:shadow-[0_18px_38px_-22px_color-mix(in_oklab,var(--secondary)_65%,transparent)]"
                    : "border-primary/15 bg-primary/[0.055] text-primary hover:border-primary/30 hover:bg-primary/10",
                ]}
              >
                <span class="min-w-0 break-words text-wrap-pretty [overflow-wrap:anywhere]">
                  {action.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </nav>
</section>

<script>
  import {
    localizePath,
    stripLangPrefix,
    translatePathForSlug,
    type Lang,
  } from "@/lib/i18n";

  function resolveLocalizedPath(nextLang: Lang, root: HTMLElement) {
    if (!root.dataset.availableLangs?.split(",").includes(nextLang))
      return null;

    const normalizedPath = stripLangPrefix(window.location.pathname);
    for (const id of ["tour-slug-map", "page-slug-map"]) {
      const element = document.getElementById(id);
      if (!element) continue;
      try {
        const slugMap = JSON.parse(element.textContent ?? "{}") as Record<
          string,
          string
        >;
        if (slugMap[nextLang])
          return localizePath(`/${slugMap[nextLang]}`, nextLang);
      } catch {}
    }
    const blogMap = document.getElementById("blog-slug-map");
    if (blogMap) {
      try {
        const slugMap = JSON.parse(blogMap.textContent ?? "{}") as Record<
          string,
          string
        >;
        if (slugMap[nextLang]) {
          return localizePath(
            translatePathForSlug(normalizedPath, slugMap[nextLang]),
            nextLang,
          );
        }
      } catch {}
    }
    return localizePath(normalizedPath, nextLang);
  }

  function initMobileMenus() {
    document
      .querySelectorAll<HTMLElement>("[data-mobile-menu-root]")
      .forEach((root) => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = "true";

        const toggle =
          root.querySelector<HTMLButtonElement>("[data-menu-toggle]");
        const menu = root.querySelector<HTMLElement>("[data-mobile-menu]");
        const overlay = root.querySelector<HTMLElement>("[data-menu-overlay]");
        const openIcon = root.querySelector<SVGElement>(
          "[data-menu-open-icon]",
        );
        const closeIcon = root.querySelector<SVGElement>(
          "[data-menu-close-icon]",
        );
        const languageSwitcher = root.querySelector<HTMLDetailsElement>(
          "[data-language-switcher]",
        );
        const languageMenu = root.querySelector<HTMLElement>(
          "[data-language-menu]",
        );
        if (!toggle || !menu || !overlay) return;

        const setMenuOpen = (open: boolean, restoreFocus = false) => {
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute(
            "aria-label",
            open ? "Cerrar menú" : "Abrir menú",
          );
          menu.hidden = !open;
          overlay.hidden = !open;
          openIcon?.classList.toggle("hidden", open);
          closeIcon?.classList.toggle("hidden", !open);
          document.body.style.overflow = open ? "hidden" : "";
          if (open) {
            requestAnimationFrame(() =>
              menu
                .querySelector<HTMLElement>("a[href], button:not([disabled])")
                ?.focus(),
            );
          } else if (restoreFocus) {
            toggle.focus();
          }
        };

        toggle.addEventListener("click", () =>
          setMenuOpen(toggle.getAttribute("aria-expanded") !== "true"),
        );
        overlay.addEventListener("click", () => setMenuOpen(false, true));
        menu
          .querySelectorAll<HTMLElement>("[data-menu-link]")
          .forEach((link) =>
            link.addEventListener("click", () => setMenuOpen(false)),
          );
        root
          .querySelectorAll<HTMLButtonElement>("[data-accordion-toggle]")
          .forEach((button) => {
            button.addEventListener("click", () => {
              const open = button.getAttribute("aria-expanded") !== "true";
              button.setAttribute("aria-expanded", String(open));
              const panel = document.getElementById(
                button.getAttribute("aria-controls") ?? "",
              );
              if (panel) panel.hidden = !open;
              button
                .querySelector("[data-accordion-chevron]")
                ?.classList.toggle("rotate-180", open);
              button.classList.toggle("text-primary", open);
            });
          });

        languageMenu
          ?.querySelectorAll<HTMLAnchorElement>("[data-language]")
          .forEach((link) => {
            link.addEventListener("click", (event) => {
              const nextLang = link.dataset.language as Lang;
              languageSwitcher?.removeAttribute("open");
              if (nextLang === root.dataset.currentLang) {
                event.preventDefault();
                return;
              }
              event.preventDefault();
              const targetPath = resolveLocalizedPath(nextLang, root);
              if (targetPath) window.location.href = targetPath;
            });
          });

        document.addEventListener("pointerdown", (event) => {
          if (
            languageSwitcher &&
            !languageSwitcher.contains(event.target as Node)
          ) {
            languageSwitcher.removeAttribute("open");
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            languageSwitcher?.removeAttribute("open");
            if (toggle.getAttribute("aria-expanded") === "true")
              setMenuOpen(false, true);
            return;
          }
          if (
            event.key !== "Tab" ||
            toggle.getAttribute("aria-expanded") !== "true"
          )
            return;
          const focusable = menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          );
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        });
      });
  }

  initMobileMenus();
  document.addEventListener("astro:page-load", initMobileMenus);
</script>
