---

<section
  aria-labelledby="travel-experiences-title"
  class="bg-background py-10 md:py-14"
  data-travel-experiences
>
  <div class="experiences-shell mx-auto max-w-8xl px-6">
    <div class="experiences-layout">
      <header class="experiences-heading">
        <h2
          id="travel-experiences-title"
          class="text-balance font-bold tracking-tight text-foreground"
        >
          {t.title}{" "}<span class="text-primary">{t.highlight}</span>
        </h2>
        <SectionDivider />
        <p
          class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground"
        >
          {t.description}
        </p>
      </header>
      <ul
        class="experiences-list m-0 grid grid-cols-2 list-none gap-3 p-0 sm:gap-x-6 sm:gap-y-7 lg:grid-cols-3"
      >
        {
          t.experiences.map(([title, description], index) => (
            <li class="min-w-0">
              <article class="h-full rounded-xl border border-border bg-card p-3 sm:rounded-none sm:border-0 sm:bg-transparent sm:p-0">
                <div class="flex flex-col items-start gap-2 sm:flex-row sm:gap-4">
                  <span
                    class:list={[
                      "grid size-10 shrink-0 place-items-center rounded-lg",
                      iconColors[index],
                    ]}
                    aria-hidden="true"
                  >
                    <svg
                      class="size-6"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill={index === 1 ? "currentColor" : "none"}
                      stroke={index === 1 ? "none" : "currentColor"}
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      focusable="false"
                    >
                      {illustrations[index].paths.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  </span>
                  <h3 class="text-sm font-semibold leading-5 tracking-tight text-foreground sm:text-lg sm:leading-6">
                    {title}
                  </h3>
                </div>
                <p class="mt-2 text-pretty text-xs leading-5 text-muted-foreground sm:text-sm sm:leading-6 sm:pl-14">
                  {description}
                </p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .experience-icon-pride {
    background: linear-gradient(
      to bottom,
      #e40303 0% 16.667%,
      #ff8c00 16.667% 33.333%,
      #ffed00 33.333% 50%,
      #008026 50% 66.667%,
      #004dff 66.667% 83.333%,
      #750787 83.333% 100%
    );
  }
  .experience-icon-pride svg {
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.4));
  }
  .experiences-shell {
    container-type: inline-size;
  }
  .experiences-layout {
    display: grid;
    gap: 2rem;
  }
  .experiences-heading h2 {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  @container (min-width: 1100px) {
    .experiences-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 1.05fr);
      gap: 3rem;
      align-items: center;
    }
    .experiences-heading {
      grid-column: 2;
      grid-row: 1;
    }
    .experiences-list {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
