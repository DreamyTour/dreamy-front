---
import SectionDivider from "@/components/ui/SectionDivider.astro";
import type { Lang } from "@/lib/i18n";
import TripAdvisorLogo from "@/assets/certification/certificado-tripadvisor.svg?url";
import { ChevronDown, ChevronLeft, ChevronRight } from "lucide-react";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type ReviewSource = "tripadvisor" | "google" | "trustpilot";
type Review = {
  source: ReviewSource;
  author: string;
  title?: string;
  text: string;
  rating: number;
  date?: string;
  url?: string;
};
type SourceSummary = {
  rating: number;
  reviewCount: number;
  url: string;
};

const sourceOrder: ReviewSource[] = ["tripadvisor", "trustpilot", "google"];
const sourceLabels = {
  trustpilot: {
    name: "Trustpilot",
    panelClass: "review-source-panel--trustpilot",
    cardClass: "review-card--trustpilot",
  },
  tripadvisor: {
    name: "Tripadvisor",
    panelClass: "review-source-panel--tripadvisor",
    cardClass: "review-card--tripadvisor",
  },
  google: {
    name: "Google Reviews",
    panelClass: "review-source-panel--google",
    cardClass: "review-card--google",
  },
} as const;

const reviewCopy = {
  es: {
    brandTour: "Dreamy Tours",
    basedOn: "Basado en",
    reviews: "opiniones",
    of: "De 5 estrellas",
    full: "Ver en la plataforma",
    title: "Lo que cuentan nuestros viajeros",
    description:
      "Experiencias compartidas en TripAdvisor, Google y Trustpilot.",
    more: "Leer más",
    less: "Leer menos",
  },
  en: {
    brandTour: "Dreamy Tours",
    basedOn: "Based on",
    reviews: "reviews",
    of: "Out of 5 stars",
    full: "View on platform",
    title: "Stories from our travelers",
    description: "Experiences shared on TripAdvisor, Google and Trustpilot.",
    more: "Read more",
    less: "Read less",
  },
  pt: {
    brandTour: "Dreamy Tours",
    basedOn: "Baseado em",
    reviews: "avaliações",
    of: "De 5 estrelas",
    full: "Ver na plataforma",
    title: "O que contam nossos viajantes",
    description:
      "Experiências compartilhadas no TripAdvisor, Google e Trustpilot.",
    more: "Leia mais",
    less: "Leia menos",
  },
};

const reviewLabels =
  reviewCopy[lang as keyof typeof reviewCopy] || reviewCopy.es;
const navigationLabels = {
  es: { previous: "Comentario anterior", next: "Siguiente comentario" },
  en: { previous: "Previous review", next: "Next review" },
  pt: { previous: "Avaliação anterior", next: "Próxima avaliação" },
}[lang];
const tripadvisorUrl =
  "https://www.tripadvisor.com.pe/Attraction_Review-g294314-d17325827-Reviews-Dreamy_Tours-Cusco_Cusco_Region.html";
const googleUrl =
  "https://www.google.com/maps/place/Dreamy+Tours/@-13.524429,-71.9506049,1057m/data=!3m2!1e3!4b1!4m6!3m5!1s0x916dd587b52c49c5:0xdaa973fe4585e28a!8m2!3d-13.5244342!4d-71.94803!16s%2Fg%2F11fkv9g6rk";
const trustpilotUrl = "https://www.trustpilot.com/review/dreamy.tours";

const sourceSummaries: Record<ReviewSource, SourceSummary> = {
  trustpilot: { rating: 5.0, reviewCount: 3, url: trustpilotUrl },
  tripadvisor: {
    rating: 4.9,
    reviewCount: 12910,
    url: tripadvisorUrl,
  },
  google: {
    rating: 4.9,
    reviewCount: 552,
    url: googleUrl,
  },
};

const reviews: Review[] = [
  {
    source: "trustpilot",
    author: "Raíza Celeghin Benedecti",
    title: "Viagem em família pelo Peru",
    text: "Viajamos em família e a Lia e Luciana nos ajudaram a organizar tudo, sempre atentas aos detalhes, pedidos especiais do grupo e orientações. Ainda, selecionaram um lunch box para a trilha de 2 dias e um restaurante no tour do Vale Sagrado que nos surpreenderam positivamente. Os almoços foram deliciosos, cheios de sabores peruanos!\n\nFizemos 3 tours com a Dreamy Tours e os 3 guias que nos receberam (Andi, Jimmy e Paula) foram excepcionais! Nos explicaram todos os detalhes e todas as histórias dos locais visitados.",
    rating: 5,
    date: "2026-09-18",
    url: trustpilotUrl,
  },
  {
    source: "trustpilot",
    author: "Yuri Alata tacusi",
    title: "Perfecto para viajar con niños",
    text: "Hemos hecho el paquete de 10 días con nuestros dos hijos y ha sido un acierto. Todo muy bien atado: vuelos, traslados, excursiones y hoteles. Los niños disfrutaron muchísimo y nosotros pudimos relajarnos porque no tuvimos que preocuparnos de nada. El guía local era muy simpático y paciente con los peques. Repetiríamos sin dudar.",
    rating: 5,
    date: "2026-07-16",
    url: trustpilotUrl,
  },
  {
    source: "trustpilot",
    author: "Roel Jhonatan",
    title: "Muy recomendado desde inicio a fin",
    text: "Muy recomendado desde inicio a fin, compre mi paquete Lima - Puno - Arequipa y Cusco. Todo una experiencia inolvidable muy recomendado al 100%",
    rating: 5,
    date: "2022-04-22",
    url: trustpilotUrl,
  },
  {
    source: "tripadvisor",
    author: "Attorla",
    title: "Arropados en Peru",
    text: "Nos hemos sentido muy a gusto durante toda nuestra estancia y visitas, un 5 con asterisco para esta empresa, de volver repetiremos con ellos",
    rating: 5,
    date: "2026-09-28",
    url: tripadvisorUrl,
  },
  {
    source: "tripadvisor",
    author: "Mariano d",
    title: "Excelente experiencia en Camino Inka",
    text: "Excelente experiencia. Cumpió tadas mis expectativas y más, La calidez y profesionalismo del guía Henry Quintano y su ayudante Percy nos hucieron sentir muy seguros y nos enseñaron mucho de la cultura quechua y de la historia de estos pueblos. Siempre estuvieron pendientes que no nos falte nada y que todo salga de la mejor manera. Muy recomendable. La comida nos sorprendió por su variedad y abundancia.",
    rating: 5,
    date: "2026-05-04",
    url: "https://www.tripadvisor.com.pe/ShowUserReviews-g294314-d17325827-r1056725873-Dreamy_Tours-Cusco_Cusco_Region.html",
  },
  {
    source: "tripadvisor",
    author: "JUNIOR EDU S",
    title: "Experiencia muy gratificante",
    text: "Fue una experiencia unica, la atencion fue genial, muy amigables y cumplieron con todo. Me voy satisfecho.",
    rating: 5,
    date: "2026-04-29",
    url: "https://www.tripadvisor.com.pe/ShowUserReviews-g294314-d17325827-r1058317381-Dreamy_Tours-Cusco_Cusco_Region.html",
  },
  {
    source: "google",
    author: "Victor Jean Pierrr Parimango Alvarez",
    text: "Nuestro viaje familiar a Cusco y Machu Picchu con Dreamy Tours fue increible. La agencia organizo todo perfectamente: traslados puntuales, un guia excelente y recomendaciones geniales.",
    rating: 5,
    date: "2025-09-15",
    url: googleUrl,
  },
  {
    source: "google",
    author: "Johanna Nava Hayden",
    text: "Contratamos la agencia desde Argentina, y de principio a fin la experiencia fue excelente. Muy buena atencion, siempre estan en contacto para lo que necesites.",
    rating: 5,
    date: "2024-06-15",
    url: googleUrl,
  },
  {
    source: "google",
    author: "Carla Miguez",
    text: "Me gusto mucho el tour, pude disfrutar hermosos paisajes y aprender sobre la forma de vida local. Excelente guia y buen manejo de los horarios.",
    rating: 5,
    date: "2022-06-15",
    url: googleUrl,
  },
];

const formatDate = (date: string | undefined) => {
  if (!date) return "";
  const parsed = new Date(date);
  if (Number.isNaN(parsed.getTime())) return "";
  return new Intl.DateTimeFormat(lang, {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(parsed);
};

const getSourceReviews = (source: ReviewSource) =>
  reviews
    .filter((review) => review.source === source)
    .sort((a, b) => Date.parse(b.date || "") - Date.parse(a.date || ""))
    .slice(0, 3);
---

<section
  class="reviews-wall bg-white py-6 sm:py-16"
  aria-labelledby="reviews-wall-title"
>
  <div class="mx-auto max-w-8xl px-4 sm:px-6">
    <header class="mb-8 max-w-3xl">
      <h2
        id="reviews-wall-title"
        class="relative mb-2 inline-block text-3xl font-semibold leading-tight tracking-tight text-foreground md:text-4xl"
      >
        <span class="relative z-10">{reviewLabels.title}</span>
      </h2>
      <SectionDivider />

      <p class="text-base leading-relaxed text-gray-600">
        {reviewLabels.description}
      </p>
    </header>
    <review-tabs
      class="block space-y-3 sm:space-y-6"
      data-active-source="tripadvisor"
    >
      {
        sourceOrder.map((source) => {
          const label = sourceLabels[source];
          const summary = sourceSummaries[source];
          return (
            <details
              open
              data-review-source
              id={`reviews-panel-${source}`}
              class={`review-tab-panel review-source-row--${source} rounded-2xl border border-border bg-card shadow-[0_2px_0_rgba(0,0,0,0.05)] sm:rounded-none sm:border-0 sm:bg-transparent sm:shadow-none`}
            >
              <summary class="flex min-h-24 cursor-pointer list-none items-center gap-3 px-4 py-4 text-left hover:bg-primary/[0.03] focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-primary sm:hidden [&::-webkit-details-marker]:hidden">
                <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                  <a
                    href={summary.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="review-accordion-brand"
                    aria-label={label.name}
                  >
                    {source === "tripadvisor" ? (
                      <img
                        src={TripAdvisorLogo}
                        alt=""
                        width="104"
                        height="32"
                        loading="lazy"
                      />
                    ) : source === "google" ? (
                      <span class="review-accordion-google" aria-hidden="true">
                        <span class="g-blue">G</span>
                        <span class="g-secondary">o</span>
                        <span class="g-yellow">o</span>
                        <span class="g-blue">g</span>
                        <span class="g-green">l</span>
                        <span class="g-secondary">e</span>
                      </span>
                    ) : (
                      <span
                        class="review-accordion-trustpilot"
                        aria-hidden="true"
                      >
                        <span class="trustpilot-star">★</span>Trustpilot
                      </span>
                    )}
                  </a>
                  <span class="flex shrink-0 flex-col items-end gap-1 text-xs leading-relaxed text-muted-foreground">
                    <span class="flex items-baseline gap-1">
                      <strong class="text-3xl font-semibold leading-none tracking-tight text-foreground">
                        {sourceSummaries[source].rating.toFixed(1)}
                      </strong>
                      <span class="text-xs">/ 5</span>
                    </span>
                    <span class="text-[0.65rem]">
                      {new Intl.NumberFormat(lang).format(
                        sourceSummaries[source].reviewCount,
                      )}{" "}
                      {reviewLabels.reviews}
                    </span>
                  </span>
                </span>
                <ChevronDown
                  size={16}
                  aria-hidden="true"
                  className="review-source-chevron shrink-0 text-primary motion-safe:transition-transform"
                />
              </summary>
              <div class="review-desktop-row">
                <div
                  data-rating-summary
                  class={`review-source-panel review-desktop-summary ${label.panelClass}`}
                >
                  <a
                    href={summary.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`review-brand-logo review-brand-logo--${source}`}
                    aria-label={label.name}
                  >
                    {source === "google" ? (
                      <>
                        <span class="g-blue" aria-hidden="true">
                          G
                        </span>
                        <span class="g-secondary" aria-hidden="true">
                          o
                        </span>
                        <span class="g-yellow" aria-hidden="true">
                          o
                        </span>
                        <span class="g-blue" aria-hidden="true">
                          g
                        </span>
                        <span class="g-green" aria-hidden="true">
                          l
                        </span>
                        <span class="g-secondary" aria-hidden="true">
                          e
                        </span>
                        <span class="review-google-word" aria-hidden="true">
                          Reviews
                        </span>
                      </>
                    ) : source === "trustpilot" ? (
                      <span class="trustpilot-wordmark">
                        <span class="trustpilot-star" aria-hidden="true">
                          ★
                        </span>
                        Trustpilot
                      </span>
                    ) : (
                      <img
                        class="tripadvisor-logo-img"
                        src={TripAdvisorLogo}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </a>
                  <span class="review-source-tour">
                    {reviewLabels.brandTour}
                  </span>
                  <span class="review-score-line">
                    <span class="review-score">
                      {summary.rating.toFixed(1)}
                    </span>
                    <span class="review-score-descriptor">
                      {reviewLabels.of}
                    </span>
                    <span
                      class={`review-stars review-stars--${source}`}
                      role="img"
                      aria-label={`${summary.rating} / 5`}
                    >
                      {Array.from({ length: 5 }).map((_, index) => (
                        <span
                          aria-hidden="true"
                          class:list={{
                            "is-filled": index < Math.round(summary.rating),
                          }}
                        />
                      ))}
                    </span>
                  </span>
                  <span class="review-total">
                    {reviewLabels.basedOn}{" "}
                    {new Intl.NumberFormat(lang).format(summary.reviewCount)}{" "}
                    {reviewLabels.reviews}
                  </span>
                </div>
                <div class="review-carousel-body border-t border-border px-3 py-4 sm:border-0 sm:p-0">
                  <div class="review-carousel">
                    <button
                      type="button"
                      class="review-carousel-button review-carousel-button--previous"
                      data-review-previous
                      hidden
                      aria-label={navigationLabels.previous}
                      aria-controls={`reviews-cards-${source}`}
                    >
                      <ChevronLeft size={20} aria-hidden="true" />
                    </button>
                    <div
                      class="review-row-cards"
                      id={`reviews-cards-${source}`}
                    >
                      {getSourceReviews(source).map((review) => (
                        <article class={`review-card ${label.cardClass}`}>
                          <span
                            class={`review-platform-badge review-platform-badge--${source}`}
                            role="img"
                            aria-label={label.name}
                          >
                            {source === "google" ? (
                              <span class="g-blue" aria-hidden="true">
                                G
                              </span>
                            ) : source === "trustpilot" ? (
                              <span class="trustpilot-star" aria-hidden="true">
                                ★
                              </span>
                            ) : (
                              <img
                                class="review-platform-badge-img"
                                src={TripAdvisorLogo}
                                alt=""
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                          </span>
                          <div class="review-card__header">
                            <span
                              class="review-avatar review-avatar--initials"
                              aria-hidden="true"
                            >
                              {review.author.slice(0, 2).toUpperCase()}
                            </span>
                            <div class="review-card__author">
                              <h3 class="review-author">
                                {review.url ? (
                                  <a
                                    href={review.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="hover:underline underline-offset-2"
                                  >
                                    {review.author}
                                  </a>
                                ) : (
                                  review.author
                                )}
                              </h3>
                              <time class="review-date" datetime={review.date}>
                                {formatDate(review.date)}
                              </time>
                            </div>
                          </div>
                          <p class="review-title">
                            {review.title || label.name}
                          </p>
                          <span
                            class={`review-stars review-stars--${source}`}
                            role="img"
                            aria-label={`${review.rating} / 5`}
                          >
                            {Array.from({ length: 5 }).map((_, index) => (
                              <span
                                aria-hidden="true"
                                class:list={{
                                  "is-filled":
                                    index < Math.round(review.rating),
                                }}
                              />
                            ))}
                          </span>
                          {review.text.length > 160 ? (
                            <div class="review-expand">
                              <p
                                id={`review-${source}-${reviews.indexOf(review)}`}
                                class="review-text"
                              >
                                {review.text}
                              </p>
                              <button
                                type="button"
                                class="review-expand-toggle"
                                aria-expanded="false"
                                aria-controls={`review-${source}-${reviews.indexOf(review)}`}
                              >
                                <span class="review-more">
                                  {reviewLabels.more}
                                </span>
                                <span class="review-less">
                                  {reviewLabels.less}
                                </span>
                              </button>
                            </div>
                          ) : (
                            <p class="review-text">{review.text}</p>
                          )}
                        </article>
                      ))}
                    </div>
                    <button
                      type="button"
                      class="review-carousel-button review-carousel-button--next"
                      data-review-next
                      hidden
                      aria-label={navigationLabels.next}
                      aria-controls={`reviews-cards-${source}`}
                    >
                      <ChevronRight size={20} aria-hidden="true" />
                    </button>
                  </div>
                  <output
                    class="review-carousel-position"
                    data-review-position
                    hidden
                    aria-live="polite"
                    aria-atomic="true"
                  >
                    1 / {getSourceReviews(source).length}
                  </output>
                </div>
              </div>
            </details>
          );
        })
      }
    </review-tabs>
  </div>
</section>

<script>
  class ReviewTabs extends HTMLElement {
    private controller?: AbortController;
    private observers: ResizeObserver[] = [];

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.controller = new AbortController();
      const { signal } = this.controller;
      const mobile = window.matchMedia("(max-width: 639px)");
      const desktop = window.matchMedia("(min-width: 1024px)");
      const panels = Array.from(
        this.querySelectorAll<HTMLDetailsElement>("[data-review-source]"),
      );
      panels.forEach((panel) => {
        const track = panel.querySelector<HTMLElement>(".review-row-cards");
        const previous = panel.querySelector<HTMLButtonElement>(
          "[data-review-previous]",
        );
        const next =
          panel.querySelector<HTMLButtonElement>("[data-review-next]");
        const position = panel.querySelector<HTMLOutputElement>(
          "[data-review-position]",
        );
        const cards = Array.from(
          panel.querySelectorAll<HTMLElement>(".review-card"),
        );
        if (!track || !previous || !next || !position || !cards.length) return;
        let active = 0;
        const sync = () => {
          const visibleCount = mobile.matches ? 1 : desktop.matches ? 3 : 2;
          previous.hidden = next.hidden = cards.length <= visibleCount;
          position.hidden = !mobile.matches;
          if (!track.clientWidth) return;
          const start = cards[0].offsetLeft;
          active = cards.reduce(
            (nearest, card, index) =>
              Math.abs(card.offsetLeft - start - track.scrollLeft) <
              Math.abs(cards[nearest].offsetLeft - start - track.scrollLeft)
                ? index
                : nearest,
            0,
          );
          previous.disabled = active === 0;
          next.disabled = active >= cards.length - visibleCount;
          position.value = `${active + 1} / ${cards.length}`;
          cards.forEach((card) => {
            const start = card.offsetLeft - cards[0].offsetLeft;
            card.inert =
              start + card.offsetWidth <= track.scrollLeft + 1 ||
              start >= track.scrollLeft + track.clientWidth - 1;
          });
        };
        const move = (direction: number) => {
          const index = Math.max(
            0,
            Math.min(
              cards.length - (mobile.matches ? 1 : desktop.matches ? 3 : 2),
              active + direction,
            ),
          );
          track.scrollTo({
            left: cards[index].offsetLeft - cards[0].offsetLeft,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "auto"
              : "smooth",
          });
        };
        previous.addEventListener("click", () => move(-1), { signal });
        next.addEventListener("click", () => move(1), { signal });
        track.addEventListener("scroll", sync, { passive: true, signal });
        mobile.addEventListener("change", sync, { signal });
        desktop.addEventListener("change", sync, { signal });
        const observer = new ResizeObserver(sync);
        observer.observe(track);
        this.observers.push(observer);
        sync();
      });
      const updateLayout = () => {
        panels.forEach((panel) => {
          panel.open = !mobile.matches;
          panel
            .querySelector<HTMLElement>(".review-row-cards")
            ?.scrollTo({ left: 0, behavior: "instant" });
        });
      };
      mobile.addEventListener("change", updateLayout, { signal });
      updateLayout();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observers.forEach((observer) => observer.disconnect());
      this.observers = [];
      delete this.dataset.ready;
    }
  }
  if (!customElements.get("review-tabs"))
    customElements.define("review-tabs", ReviewTabs);

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(
      ".review-expand-toggle",
    );
    if (!button) return;
    const container = button.closest(".review-expand");
    const text = container?.querySelector<HTMLElement>(".review-text");
    const before = text?.getBoundingClientRect().height;
    const expanded = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(expanded));
    button.closest(".review-expand")?.classList.toggle("is-expanded", expanded);
    if (
      text &&
      before &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      text.animate(
        [
          { height: `${before}px` },
          { height: `${text.getBoundingClientRect().height}px` },
        ],
        {
          duration: 220,
          easing: "ease-out",
        },
      );
    }
  });
</script>

<style is:global>
  .review-desktop-summary {
    display: none !important;
  }
  @media (min-width: 640px) {
    .reviews-wall .review-desktop-row {
      --review-row-height: 13rem;
      display: grid;
      grid-template-columns: minmax(14rem, 0.95fr) minmax(0, 2fr);
      align-items: stretch;
      gap: 2rem;
    }
    .reviews-wall review-tabs .review-desktop-summary {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: var(--review-row-height);
      height: 100%;
      padding: 1.25rem;
      text-decoration: none;
      cursor: default;
      gap: 0.5rem;
    }
    .reviews-wall .review-desktop-summary .review-brand-logo--tripadvisor {
      width: 8rem;
    }
    .reviews-wall .review-desktop-summary .review-score-line {
      align-items: flex-end;
    }
    .reviews-wall .review-desktop-summary .review-score {
      font-size: 2rem;
    }
    .reviews-wall .review-desktop-summary .review-total {
      font-size: 0.65rem;
    }
    .reviews-wall .review-desktop-summary .review-brand-logo--google,
    .reviews-wall .review-desktop-summary .trustpilot-wordmark {
      font-size: 1.35rem;
    }
    .reviews-wall .review-desktop-summary .review-google-word {
      display: none;
    }
    .reviews-wall .review-carousel-body {
      min-width: 0;
    }
    .reviews-wall .review-carousel {
      position: relative;
