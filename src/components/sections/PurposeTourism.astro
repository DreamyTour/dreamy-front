---
import SectionDivider from "@/components/ui/SectionDivider.astro";
import type { Lang } from "@/lib/i18n";
import { useTranslations } from "@/i18n/ui";
import { purposeHref } from "@/lib/purposeRoutes";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
type CommitmentKey =
  | "sustainable"
  | "inclusive"
  | "responsible"
  | "cultural"
  | "social";
interface Commitment {
  key: CommitmentKey;
  image: { src: string; width: number; height: number; alt: string } | null;
  hrefs?: Partial<Record<Lang, string>>;
  plannedHref?: string;
}

const commitments: Commitment[] = [
  {
    key: "sustainable",
    image: {
      src: "/imagenes/turismo-sostenible-peru.webp",
      width: 570,
      height: 700,
      alt: t("purpose.sustainable.alt"),
    },
    hrefs: {
      es: purposeHref("sustainable", "es"),
      en: purposeHref("sustainable", "en"),
      pt: purposeHref("sustainable", "pt"),
    },
  },
  {
    key: "inclusive",
    image: {
      src: "/imagenes/turismo-inclusivo-cusco.webp",
      width: 1400,
      height: 630,
      alt: t("purpose.inclusive.alt"),
    },
    hrefs: {
      es: purposeHref("inclusive", "es"),
      en: purposeHref("inclusive", "en"),
      pt: purposeHref("inclusive", "pt"),
    },
  },
  {
    key: "responsible",
    image: {
      src: "https://cdn.dreamy.tours/8/Turismo_Vivencial_1543730010.webp",
      width: 1200,
      height: 900,
      alt: t("purpose.responsible.alt"),
    },
    hrefs: {
      es: purposeHref("responsible", "es"),
      en: purposeHref("responsible", "en"),
      pt: purposeHref("responsible", "pt"),
    },
  },
  {
    key: "cultural",
    image: {
      src: "/imagenes/artesania-cusco.webp",
      width: 1400,
      height: 1050,
      alt: t("purpose.cultural.alt"),
    },
    hrefs: {
      es: `${purposeHref("responsible", "es")}#experiencias-culturales`,
      en: `${purposeHref("responsible", "en")}#experiencias-culturales`,
      pt: `${purposeHref("responsible", "pt")}#experiencias-culturales`,
    },
  },
  {
    key: "social",
    image: {
      src: "/imagenes/proyecto-social/navidad/2024-saylla/foto-01-800.webp",
      width: 800,
      height: 534,
      alt: t("purpose.social.alt"),
    },
    hrefs: {
      es: purposeHref("social", "es"),
      en: purposeHref("social", "en"),
      pt: purposeHref("social", "pt"),
    },
  },
];
---

<section
  class="bg-background px-6 py-12 text-foreground"
  aria-labelledby="purpose-title"
  id="turismo-con-proposito"
>
  <div class="mx-auto max-w-7xl">
    <header class="mx-auto mb-8 max-w-3xl text-center">
      <p
        class="mb-3 text-[0.7rem] font-semibold tracking-[0.14em] text-primary uppercase"
      >
        {t("purpose.eyebrow")}
      </p>
      <h2
        id="purpose-title"
        class="text-[clamp(2rem,1.5rem+1.5vw,3rem)] leading-[1.1] font-bold tracking-[-0.035em]"
      >
        {t("purpose.title")}{" "}<span class="text-primary"
          >{t("purpose.highlight")}</span
        >
      </h2>
      <SectionDivider align="center" />
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        {t("purpose.description")}
      </p>
    </header>

    <purpose-cards class="grid grid-cols-1 gap-6 md:grid-cols-6">
      {
        commitments.map((item, index) => {
          const title = t(`purpose.${item.key}.title`);
          const href = item.hrefs?.[lang];
          const Photo = href ? "a" : "div";
          const Action = href ? "a" : "button";
          const wide = index > 2;
          const readAbout = `${t("purpose.readAbout")} ${title.toLocaleLowerCase(lang)}`;
          return (
            <div
              data-purpose-reveal
              class:list={[
                "min-w-0",
                wide ? "md:col-span-6 lg:col-span-3" : "md:col-span-2",
              ]}
            >
              <article
                data-commitment={item.key}
                class:list={[
                  "group/card relative isolate flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-border bg-background shadow-sm transition-[translate,border-color,box-shadow] duration-500 hover:border-primary/35 hover:shadow-[0_12px_32px_-18px_var(--primary)] focus-within:border-primary/35 motion-safe:hover:-translate-y-1 motion-reduce:transition-none",
                  wide && "sm:grid sm:grid-cols-[1.1fr_1fr]",
                ]}
              >
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 top-0 z-20 h-px origin-left scale-x-0 bg-primary/60 transition-transform duration-700 group-hover/card:scale-x-100 motion-reduce:transition-none"
                />
                <Photo
                  class:list={[
                    "relative block aspect-[16/9] overflow-hidden bg-muted focus-visible:z-20 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-primary",
                    wide && "sm:order-2 sm:aspect-auto sm:min-h-64",
                    !item.image && "photo-pending",
                  ]}
                  href={href}
                  aria-label={href ? readAbout : undefined}
                >
                  {item.image ? (
                    <img
                      class:list={[
                        "h-full w-full scale-100 object-cover transition-[scale] duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:group-hover/card:scale-[1.03] motion-reduce:transition-none",
                        item.key === "sustainable" && "object-[center_60%]",
                        item.key === "cultural" && "object-[70%_center]",
                      ]}
                      src={item.image.src}
                      alt={item.image.alt}
                      width={item.image.width}
                      height={item.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div
                      class="flex h-full flex-col items-center justify-center gap-3 text-primary/40"
                      aria-hidden="true"
                    >
                      <svg
                        class="size-12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {item.key === "inclusive" ? (
                          <>
                            <circle cx="9" cy="7" r="3" />
                            <path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6m2 5a5 5 0 0 1 3 5v1" />
                          </>
                        ) : (
                          <>
                            <path d="M20 4c-8-1-14 3-14 9a5 5 0 0 0 5 5c6 0 10-6 9-14ZM4 21 15 10M10 15v-4m0 4h4" />
                          </>
                        )}
                      </svg>
                      <span class="text-xs text-muted-foreground">
                        {t("purpose.comingSoon")}
                      </span>
                    </div>
                  )}
                  <span
                    aria-hidden="true"
                    class="absolute top-4 left-4 inline-flex items-center gap-2 rounded-full bg-background px-3 py-1.5 text-[0.65rem] font-semibold tracking-wider text-primary uppercase shadow-sm"
                  >
                    <span class="size-1.5 rounded-full bg-primary" />
                    {t(`purpose.${item.key}.label`)}
                  </span>
                </Photo>

                <div class="relative z-10 flex min-w-0 flex-col p-6">
                  <h3 class="text-[1.35rem] leading-tight font-semibold tracking-tight">
                    {href ? (
                      <a
                        class="transition-colors hover:text-secondary! hover:no-underline! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
                        href={href}
                      >
                        {title}
                      </a>
                    ) : (
                      title
                    )}
                  </h3>
                  <p class="mt-3 mb-5 text-sm leading-relaxed text-muted-foreground">
                    {t(`purpose.${item.key}.description`)}
                  </p>
                  <div class="mt-auto flex justify-center">
                    <Action
                      href={href}
                      type={href ? undefined : "button"}
                      disabled={href ? undefined : true}
                      title={href ? undefined : t("purpose.comingSoon")}
                      aria-label={
                        href
                          ? readAbout
                          : `${readAbout}. ${t("purpose.comingSoon")}`
                      }
                      class:list={[
                        "group/button relative isolate inline-flex min-h-10 items-center justify-center gap-3 overflow-hidden rounded-full border border-primary/40 px-5 py-2 text-[0.8rem] leading-none font-semibold text-primary transition-colors duration-300 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:-translate-x-full before:rounded-full before:bg-primary before:transition-transform before:duration-300 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:before:transition-none motion-reduce:transition-none",
                        href &&
                          "hover:text-white! hover:no-underline! hover:before:translate-x-0 focus-visible:text-white! focus-visible:before:translate-x-0",
                        "w-auto self-start",
                      ]}
                    >
                      {t("purpose.readMore")}
                      <span class="sr-only">: {title}</span>
                      <svg
                        class:list={[
                          "size-4 transition-transform duration-300 motion-reduce:transition-none",
                          href &&
                            "motion-safe:group-hover/button:translate-x-1 motion-safe:group-focus-visible/button:translate-x-1",
                        ]}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                      </svg>
                    </Action>
                  </div>
                </div>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-y-0 -left-1/2 z-10 w-1/2 -skew-x-12 bg-linear-to-r from-transparent via-primary/5 to-transparent transition-[left] duration-1000 motion-safe:group-hover/card:left-[150%] motion-reduce:hidden"
                />
              </article>
            </div>
          );
        })
      }
    </purpose-cards>
  </div>
</section>

<script>
  class PurposeCards extends HTMLElement {
    private observer?: IntersectionObserver;
    private animations = new Set<Animation>();
    private motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    private stopMotion = () => {
      if (!this.motion.matches) return;
      this.observer?.disconnect();
      this.animations.forEach((animation) => animation.cancel());
      this.animations.clear();
    };

    connectedCallback() {
      // Content remains visible without JavaScript; animation is an enhancement.
      if (this.motion.matches || !("IntersectionObserver" in window)) return;
      this.motion.addEventListener("change", this.stopMotion);
      this.observer = new IntersectionObserver(
        (entries) => {
          let stagger = 0;
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const animation = entry.target.animate(
              [
                { opacity: 0, transform: "translateY(24px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              {
                duration: 650,
                delay: stagger++ * 85,
                easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                fill: "backwards",
              },
            );
            this.animations.add(animation);
            animation.finished
              .then(() => this.animations.delete(animation))
              .catch(() => {});
            this.observer?.unobserve(entry.target);
          });
        },
        { threshold: 0.12 },
      );
      this.querySelectorAll("[data-purpose-reveal]").forEach((card) =>
        this.observer?.observe(card),
      );
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.motion.removeEventListener("change", this.stopMotion);
      this.animations.forEach((animation) => animation.cancel());
      this.animations.clear();
    }
  }

  if (!customElements.get("purpose-cards"))
    customElements.define("purpose-cards", PurposeCards);
</script>
