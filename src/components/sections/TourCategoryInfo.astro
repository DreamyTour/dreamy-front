---
import SectionDivider from "@/components/ui/SectionDivider.astro";
import CategoryInfoBlocks from "@/components/content/CategoryInfoBlocks.astro";
import type { UsefulInfo } from "@/types/page";
import { getUsefulInfoItems } from "@/lib/categoryTourSections";
import {
  ArrowUpRight,
  BedDouble,
  BookOpenText,
  BusFront,
  CalendarDays,
  BookOpen,
  Camera,
  CircleHelp,
  CircleDollarSign,
  ChevronDown,
  CloudSun,
  Clock3,
  Compass,
  Flower2,
  Globe2,
  Info,
  Landmark,
  Map,
  MapPinned,
  MessageSquareText,
  Mountain,
  Plane,
  Route,
  ShieldCheck,
  Sparkles,
  Sun,
  TicketCheck,
  UtensilsCrossed,
  UsersRound,
} from "lucide-react";
interface Props {
  info?: UsefulInfo | null;
  lang: "es" | "en" | "pt";
}
const { info, lang } = Astro.props;
const normalizeTabText = (value?: string | null) =>
  (value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
const getSemanticTabIcon = (text: string) => {
  if (/transporte|transport|\bbuses?\b|traslad|transfer|shuttle|movilidad/.test(text))
    return BusFront;
  if (/altitud|altura|elevacion|altitude|elevation|\bmontana\b/.test(text))
    return Mountain;
  if (/clima|weather|climate|temperatura|temperature|lluvia|rain/.test(text))
    return CloudSun;
  if (/conexion|connection|ruta|route|como llegar|how to get|acceso|access/.test(text))
    return Route;
  if (/colca|canon|canyon|destino|destination|lugar|place|visita|visit/.test(text))
    return MapPinned;
  if (/trek|sendero|trilha|hike|montanha|mountain/.test(text)) return Mountain;
  if (/duracion|duration|horario|schedule|tiempo|time/.test(text)) return Clock3;
  if (/entrada|ticket|boleto|ingreso|admission/.test(text)) return TicketCheck;
  if (/guia|guide|acompanamiento|acompanhar/.test(text)) return UsersRound;
  if (/alojamiento|hospedaje|hotel|accommodation|lodging/.test(text))
    return BedDouble;
  if (/comentario|opinion|resena|review|testimonial/.test(text))
    return MessageSquareText;
  if (/pregunta|faq|frecuente|question|duvida/.test(text)) return CircleHelp;
  if (/itinerario|itinerary|programa|program|circuito|circuit/.test(text))
    return Compass;
  if (/historia|history|cultura|culture|arqueolog|archaeolog/.test(text))
    return BookOpen;
  return undefined;
};
const getTabIcon = (label?: string | null, title?: string | null) =>
  getSemanticTabIcon(normalizeTabText(label)) ||
  getSemanticTabIcon(normalizeTabText(title)) ||
  Info;
const fallbackTabIcons = [
  CalendarDays,
  Camera,
  CircleDollarSign,
  Flower2,
  Globe2,
  Landmark,
  Map,
  Plane,
  ShieldCheck,
  Sparkles,
  Sun,
  UtensilsCrossed,
  BookOpenText,
];
const isTransportLabel = (label?: string | null) =>
  /^(transporte(?: turistico)?|transport(?:ation)?|tourist transportation)$/.test(
    (label || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim()
      .toLowerCase(),
  );
const usefulInfoItems = getUsefulInfoItems(info);
const usedTabIcons = new Set([BusFront]);
const categoryTabs = usefulInfoItems
  .filter((item) => !isTransportLabel(item.etiqueta))
  .map((item, index) => {
    const preferredIcon = getTabIcon(item.etiqueta, item.titulo);
    const icon = usedTabIcons.has(preferredIcon)
      ? (fallbackTabIcons.find((candidate) => !usedTabIcons.has(candidate)) ||
        Info)
      : preferredIcon;
    usedTabIcons.add(icon);

    return {
      ...item,
      id: index + 1,
      icon,
      isTransport: false as const,
    };
  });
const transportCopy = {
  es: {
    sectionTitle: "Información para organizar tu viaje",
    label: "Transporte",
    title: "Transporte turístico en Perú para tu viaje",
    paragraphs: [
      "En Dreamy Tours coordinamos opciones de transporte turístico junto a Viamed Perú para complementar tu itinerario. Puedes consultar traslados desde el aeropuerto, excursiones de medio día o día completo y viajes entre destinos, según la ruta que tengas prevista.",
      "Cada servicio se organiza de acuerdo con la fecha, el recorrido y el tamaño del grupo. La disponibilidad y el tipo de vehículo se confirman al planificar tu viaje.",
    ],
    link: "Conoce los servicios de Viamed Perú",
  },
  en: {
    sectionTitle: "Information to plan your trip",
    label: "Transportation",
    title: "Tourist transportation in Peru for your trip",
    paragraphs: [
      "At Dreamy Tours, we coordinate tourist transportation options with Viamed Perú to complement your itinerary. Ask us about airport transfers, half-day or full-day excursions, and trips between destinations, depending on your planned route.",
      "Each service is arranged according to your travel date, route, and group size. Availability and vehicle type are confirmed while planning your trip.",
    ],
    link: "Explore Viamed Perú services",
  },
  pt: {
    sectionTitle: "Informações para organizar sua viagem",
    label: "Transporte",
    title: "Transporte turístico no Peru para sua viagem",
    paragraphs: [
      "Na Dreamy Tours, coordenamos opções de transporte turístico junto com a Viamed Perú para complementar seu roteiro. Consulte traslados do aeroporto, excursões de meio dia ou dia inteiro e viagens entre destinos, de acordo com o percurso planejado.",
      "Cada serviço é organizado conforme a data, o trajeto e o tamanho do grupo. A disponibilidade e o tipo de veículo são confirmados durante o planejamento da viagem.",
    ],
    link: "Conheça os serviços da Viamed Perú",
  },
}[lang];
const transportTab = {
  ...transportCopy,
  etiqueta: transportCopy.label,
  titulo: transportCopy.title,
  id: 0,
  icon: BusFront,
  isTransport: true as const,
};
const orderedTabs = usefulInfoItems.length
  ? [...categoryTabs, transportTab].map((tab, index) => ({
      ...tab,
      id: index + 1,
    }))
  : [];
---

{
  orderedTabs.length > 0 && (
    <section
      class="w-full py-16 md:py-20"
      aria-labelledby="tour-category-info-title"
    >
      <header class="mb-10 max-w-3xl">
        <h2
          id="tour-category-info-title"
          class="mb-4 text-3xl font-semibold leading-tight tracking-tight text-foreground md:text-4xl"
        >
          {info?.titulo || transportCopy.sectionTitle}
        </h2>
        <SectionDivider />
        {info?.descripcion && (
          <p class="mt-6 leading-7 text-muted-foreground">{info.descripcion}</p>
        )}
      </header>
      <category-info-tabs class="block">
        <div
          data-tab-list
          hidden
          role="tablist"
          aria-labelledby="tour-category-info-title"
          class="category-info-tab-list mb-5 rounded-[1.5rem] border border-border/60 bg-background p-2.5 shadow-[0_10px_30px_-20px_rgba(15,23,42,0.34)]"
        >
          <div class="grid grid-cols-2 gap-2.5 rounded-[1.125rem] bg-muted/70 p-2.5 sm:grid-cols-4 xl:grid-cols-5">
            {orderedTabs.map(({ icon: Icon, ...tab }) => (
              <button
                type="button"
                role="tab"
                id={`category-info-tab-${tab.id}`}
                aria-controls={`category-info-panel-${tab.id}`}
                aria-selected="false"
                tabindex="-1"
                class="category-info-tab relative flex min-h-[4.875rem] min-w-0 flex-col items-center justify-center gap-2 rounded-xl border border-transparent bg-background px-4 py-3.5 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-foreground/60 shadow-[0_8px_18px_-14px_rgba(15,23,42,0.28)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <Icon
                  size={22}
                  strokeWidth={1.8}
                  className="shrink-0"
                  aria-hidden="true"
                />
                <span>{tab.etiqueta}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="space-y-3 sm:space-y-5">
          {orderedTabs.map(({ icon: Icon, ...tab }) => (
            <details
              id={`category-info-panel-${tab.id}`}
              data-info-panel
              open
              class="group/info overflow-hidden rounded-2xl border border-border bg-card shadow-[0_2px_0_rgba(0,0,0,0.05)] sm:rounded-lg sm:shadow-[0_4px_18px_-10px_rgba(13,43,29,0.2)]"
            >
              <summary class="flex min-h-24 cursor-pointer list-none items-center gap-3 px-4 py-4 text-left hover:bg-primary/[0.03] focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-primary group-open/info:bg-primary/[0.05] sm:hidden [&::-webkit-details-marker]:hidden">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary/[0.08] text-primary group-open/info:bg-primary group-open/info:text-primary-foreground">
                  <Icon size={20} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class="text-base font-semibold leading-tight tracking-tight text-foreground">
                    {tab.etiqueta}
                  </span>
                  <span class="text-xs leading-relaxed text-muted-foreground">
                    {tab.titulo}
                  </span>
                </span>
                <ChevronDown
                  size={16}
                  aria-hidden="true"
                  className="shrink-0 text-primary group-open/info:rotate-180 motion-safe:transition-transform"
                />
              </summary>
              <div class="border-t border-primary/10 px-4 py-5 sm:border-0 sm:p-6 md:p-8">
                <h3 class="mb-5 hidden text-xl font-semibold text-foreground sm:block md:text-2xl">
                  {tab.titulo}
                </h3>
                <div class="max-w-[72ch] space-y-4 leading-7 text-muted-foreground">
                  {tab.isTransport ? (
                    <>
                      {tab.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                      <p>
                        <a
                          href="https://viamedperu.com/"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group/viamed inline-flex min-h-11 items-center gap-2 rounded-lg border border-primary/20 bg-primary/[0.045] px-4 py-2 font-semibold text-primary shadow-[0_2px_8px_-5px_color-mix(in_srgb,var(--primary)_28%,transparent)] motion-safe:transition-[background-color,border-color,box-shadow,transform] motion-safe:duration-200 motion-safe:ease-out hover:border-primary/35 hover:bg-primary/[0.09] hover:shadow-[0_9px_20px_-12px_color-mix(in_srgb,var(--primary)_48%,transparent)] active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-safe:hover:-translate-y-0.5"
                        >
                          {tab.link}
                          <ArrowUpRight
                            size={16}
                            strokeWidth={1.8}
                            aria-hidden="true"
                            className="shrink-0 motion-safe:transition-transform motion-safe:duration-200 group-hover/viamed:translate-x-0.5 group-hover/viamed:-translate-y-0.5"
                          />
                        </a>
                      </p>
                    </>
                  ) : (
                    <CategoryInfoBlocks blocks={tab.contenido || []} />
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </category-info-tabs>
    </section>
  )
}

<script>
  class CategoryInfoTabs extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      if (this.dataset.enhanced) return;
      this.dataset.enhanced = "true";
      this.controller = new AbortController();
      const { signal } = this.controller;
      const list = this.querySelector<HTMLElement>("[data-tab-list]");
      const tabs = Array.from(
        this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );
      const panels = Array.from(
        this.querySelectorAll<HTMLDetailsElement>("[data-info-panel]"),
      );
      if (!list || tabs.length !== panels.length || !tabs.length) return;

      const desktop = window.matchMedia("(min-width: 640px)");
      let activeIndex = 0;
      const select = (index: number, focus = false) => {
        activeIndex = index;
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[tabIndex].hidden = desktop.matches && !active;
        });
        if (focus) tabs[index].focus();
      };
      const updateLayout = () => {
        list.hidden = !desktop.matches;
        panels.forEach((panel, index) => {
          panel.open = desktop.matches;
          if (desktop.matches) {
            panel.setAttribute("role", "tabpanel");
            panel.setAttribute("aria-labelledby", tabs[index].id);
            panel.tabIndex = 0;
          } else {
            panel.removeAttribute("role");
            panel.removeAttribute("aria-labelledby");
            panel.removeAttribute("tabindex");
          }
        });
        select(activeIndex);
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index), { signal });
        tab.addEventListener(
          "keydown",
          (event) => {
            let next = index;
            if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
            else if (event.key === "ArrowLeft")
              next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault();
            select(next, true);
          },
          { signal },
        );
      });
      desktop.addEventListener("change", updateLayout, { signal });
      updateLayout();
    }

    disconnectedCallback() {
      this.controller?.abort();
      delete this.dataset.enhanced;
    }
  }
  if (!customElements.get("category-info-tabs"))
    customElements.define("category-info-tabs", CategoryInfoTabs);
</script>

<style>
  .category-info-tab-list[hidden] {
    display: none;
  }

  .category-info-tab[aria-selected="true"] {
    color: var(--primary-foreground);
    border-color: var(--primary);
    background: var(--primary);
  }

  .category-info-tab::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 0;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
    transform: translateX(-50%);
  }

  .category-info-tab[aria-selected="true"]::after {
    width: min(3.25rem, calc(100% - 2rem));
    opacity: 1;
  }

  @media (hover: hover) {
    .category-info-tab:not([aria-selected="true"]):hover {
      color: var(--primary);
      border-color: color-mix(in srgb, var(--primary) 20%, transparent);
      background: color-mix(in srgb, var(--primary) 6%, var(--card));
    }
    .category-info-tab:not([aria-selected="true"]):hover::after {
      width: min(2.75rem, calc(100% - 2rem));
      opacity: 0.5;
    }
    .category-info-tab[aria-selected="true"]:hover {
      background: var(--primary);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .category-info-tab {
      transition:
        background-color 160ms ease,
        border-color 160ms ease,
        color 160ms ease;
    }
    .category-info-tab::after {
      transition:
        width 220ms ease,
        opacity 220ms ease;
    }
  }
</style>
