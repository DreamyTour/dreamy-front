---
import LocalizedPurpose from "@/components/content/LocalizedPurpose.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import HeroImage from "@/components/ui/HeroImage.astro";
import TourCard from "@/components/ui/TourCard.astro";
import {
  Leaf,
  UsersRound,
  Compass,
  Recycle,
  BookOpen,
  BottleWine,
  Footprints,
  Binoculars,
  HandHeart,
  ShoppingBag,
  Map,
} from "lucide-react";
import { getHeroImage } from "@/lib/heroImage";
import { getImageSrcSet, getImageUrl } from "@/lib/helpers";
import { getSustainableTours } from "@/lib/sustainableTourism";
import {
  sustainableTourism as copy,
  verifiedSustainabilityInitiatives,
} from "@/data/sustainableTourism";

const tours = await getSustainableTours();
const andes = tours.slice(0, 3);
const amazon = tours.slice(3);
const commitmentIcons = [Leaf, Recycle, UsersRound, BookOpen];
const tipIcons = [
  BottleWine,
  Footprints,
  Binoculars,
  HandHeart,
  ShoppingBag,
  Map,
];
const hero = getHeroImage(
  tours[2].tour.imagenDestacada,
  "Caminantes y arrieros entre las montañas de la ruta de Lares, Cusco",
);
const sandoval = getHeroImage(
  tours[3].tour.imagenDestacada,
  "Navegación y observación de naturaleza en el Lago Sandoval, Madre de Dios",
);
const palcoyo = getHeroImage(
  tours[1].tour.imagenDestacada,
  "Montañas multicolores y paisaje altoandino de Palcoyo, Cusco",
);
const imageAlts = [
  "Jardines de Mandor, en el entorno natural de Machu Picchu",
  "Paisaje de montañas multicolores de Palcoyo en Cusco",
  "Senderos de montaña en la ruta de Lares a Machu Picchu",
  "Paisaje amazónico del Lago Sandoval en Madre de Dios",
  "Naturaleza del bosque amazónico en la experiencia de Lago Sandoval de tres días",
  "Entorno natural de la expedición amazónica en Tambopata, Madre de Dios",
];
const principles = [
  {
    title: "Proteger la naturaleza",
    icon: Leaf,
    text: "Respetar los ecosistemas, la biodiversidad y los espacios que visitamos.",
  },
  {
    title: "Valorar las comunidades",
    icon: UsersRound,
    text: "Reconocer el conocimiento, la identidad cultural y la participación de las poblaciones locales.",
  },
  {
    title: "Viajar con conciencia",
    icon: Compass,
    text: "Promover decisiones informadas y prácticas que reduzcan los impactos innecesarios.",
  },
];
const wrap = "page-shell";
const section = `${wrap} py-12 md:py-16`;
const eyebrow =
  "mb-4 text-[0.7rem] font-semibold tracking-[0.14em] text-primary uppercase";
const heading =
  "text-balance text-[clamp(1.8rem,1.2rem+1.5vw,2.6rem)] leading-[1.15] font-semibold tracking-[-0.035em]";
const body = "space-y-4 text-[0.95rem] leading-[1.85] text-muted-foreground";
const primaryButton =
  "inline-flex min-h-11 items-center justify-center gap-3 rounded-full border border-secondary bg-secondary px-6 py-3 text-sm font-semibold text-white! transition-colors hover:bg-secondary/90 hover:no-underline! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary motion-reduce:transition-none";
const outlineButton =
  "inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold text-foreground! transition-colors hover:border-primary hover:text-primary! hover:no-underline! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none";
---

<LocalizedPurpose>
  <div
    id="sustainable-landing"
    class="bg-background text-foreground [&_section[id]]:scroll-mt-28"
  >
    <section
      aria-labelledby="sustainable-title"
      class={`${wrap} pt-5 pb-10 md:pb-14`}
    >
      <nav
        aria-label="Ruta de navegación"
        class="mb-8 text-xs text-muted-foreground"
      >
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href="/es/"
              class="hover:text-primary hover:no-underline focus-visible:outline-2 focus-visible:outline-primary"
              >Inicio</a
            >
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Turismo sostenible en Perú</li>
        </ol>
      </nav>
      <div class="grid items-end gap-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div>
          <p class={eyebrow}>Viaja con conciencia</p>
          <h1
            id="sustainable-title"
            class="max-w-2xl text-balance text-[clamp(2.25rem,1.2rem+2.5vw,4rem)] leading-[1.07] font-semibold tracking-[-0.045em]"
          >
            Turismo sostenible en Perú: <span class="text-primary"
              >naturaleza y experiencias</span
            >
          </h1>
          <SectionDivider />
        </div>
        <div>
          <div class={body}>{copy.hero.map((text) => <p>{text}</p>)}</div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              class={primaryButton}
              href="#experiencias"
              data-sustainable-event="hero_experiences"
              >Ver tours <span aria-hidden="true">→</span></a
            >
            <a
              class={outlineButton}
              href="#compromiso"
              data-sustainable-event="hero_commitment">Nuestro compromiso</a
            >
          </div>
        </div>
      </div>
      <figure class="mt-8 overflow-hidden rounded-2xl md:mt-10">
        <HeroImage
          image={hero}
          class="aspect-[4/3] w-full object-cover object-center md:aspect-[2.8]"
        />
      </figure>
    </section>

    <section class={section} aria-labelledby="sustainable-meaning">
      <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <figure class="overflow-hidden rounded-2xl">
          <img
            src="/imagenes/turismo-sostenible-peru.webp"
            sizes="(min-width: 1024px) 42vw, 100vw"
            width={570}
            height={700}
            alt="Grupo de viajeros junto a un gran árbol en el bosque tropical del Perú"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]"
          />
        </figure>
        <div>
          <p class={eyebrow}>Una forma diferente de descubrir</p>
          <h2 id="sustainable-meaning" class={heading}>
            ¿Qué significa viajar de manera sostenible?
          </h2>
          <SectionDivider />
          <div class={`mt-5 ${body}`}>
            {copy.meaning.map((text) => <p>{text}</p>)}
          </div>
        </div>
      </div>
      <div
        class="mt-10 grid gap-4 border-t border-border pt-7 md:grid-cols-3 md:gap-6"
      >
        {
          principles.map(({ title, text, icon: Icon }) => (
            <div class="flex items-start gap-4 rounded-2xl border border-primary/10 bg-primary/[0.025] p-5 md:p-6">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-primary/10 bg-primary/5 text-primary">
                <Icon size={24} strokeWidth={1.6} aria-hidden="true" />
              </div>
              <div class="min-w-0 pt-1">
                <h3 class="mb-2 text-sm font-semibold text-primary">{title}</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="experiencias" class={section} aria-labelledby="andes-title">
      <div class="mb-8 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <p class={eyebrow}>Experiencias en la montaña</p><h2
            id="andes-title"
            class={heading}
          >
            Turismo sostenible en Cusco y los Andes
          </h2><SectionDivider />
        </div>
        <div class={body}>{copy.andes.map((text) => <p>{text}</p>)}</div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          andes.map(({ tour, copy: card }, index) => (
            <TourCard
              tour={tour}
              lang="es"
              compactAction
              editorial={{
                ...card,
                imageAlt: imageAlts[index],
                ctaLabel: "Conoce el tour",
              }}
            />
          ))
        }
      </div>
    </section>

    <section class="bg-muted/30" aria-labelledby="amazon-title">
      <div class={section}>
        <div
          class="mb-8 grid items-center gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-14"
        >
          <div class="lg:order-2">
            <p class={eyebrow}>Biodiversidad que inspira</p><h2
              id="amazon-title"
              class={heading}
            >
              Turismo de naturaleza en Tambopata y Lago Sandoval
            </h2><SectionDivider /><div class={`mt-5 ${body}`}>
              {copy.amazon.map((text) => <p>{text}</p>)}
            </div>
          </div>
          <figure>
            <img
              src={sandoval.src}
              srcset={sandoval.srcset}
              sizes="(min-width: 1024px) 48vw, 100vw"
              width={sandoval.width}
              height={sandoval.height}
              alt={sandoval.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full rounded-2xl object-cover"
            />
          </figure>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            amazon.map(({ tour, copy: card }, index) => (
              <TourCard
                tour={tour}
                lang="es"
                compactAction
                editorial={{
                  ...card,
                  imageAlt: imageAlts[index + 3],
                  ctaLabel: "Conoce el tour",
                }}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="compromiso" class={section} aria-labelledby="commitment-title">
      <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class={eyebrow}>Más allá del recorrido</p><h2
            id="commitment-title"
            class={heading}
          >
            Nuestro compromiso con un turismo más consciente
          </h2><SectionDivider /><div class={`mt-5 ${body}`}>
            {copy.commitment.map((text) => <p>{text}</p>)}
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 md:gap-5">
          {
            copy.commitments.map((item, index) => {
              const Icon = commitmentIcons[index] ?? Leaf;
              return (
                <div class="rounded-2xl border border-primary/10 bg-primary/[0.025] p-5 md:p-6">
                  <span class="mb-5 flex size-12 items-center justify-center rounded-2xl border border-primary/10 bg-primary/5 text-primary">
                    <Icon size={24} strokeWidth={1.6} aria-hidden="true" />
                  </span>
                  <h3 class="mb-3 text-lg leading-tight font-semibold tracking-tight">
                    {item.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
      {
        verifiedSustainabilityInitiatives.length > 0 && (
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {verifiedSustainabilityInitiatives.map((initiative) => (
              <article class="rounded-2xl border border-border p-6">
                <h3 class="text-xl font-semibold">{initiative.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {initiative.description}
                </p>
                {initiative.partner && (
                  <p class="mt-3 text-sm">{initiative.partner}</p>
                )}
                {initiative.result && (
                  <p class="mt-3 text-sm">{initiative.result}</p>
                )}
                <a
                  href={initiative.evidenceUrl}
                  class="mt-4 inline-flex text-sm font-semibold text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-primary"
                >
                  Conoce la iniciativa
                </a>
              </article>
            ))}
          </div>
        )
      }
    </section>

    <section
      class={`${section} border-t border-border`}
      aria-labelledby="traveler-title"
    >
      <div
        class="grid items-center gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
      >
        <div>
          <p class={eyebrow}>Pequeñas decisiones, grandes diferencias</p><h2
            id="traveler-title"
            class={heading}
          >
            ¿Cómo puedes contribuir a un viaje más sostenible?
          </h2><SectionDivider />
        </div>
        <p class={body}>{copy.tipsIntro}</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {
          copy.tips.map((item, index) => {
            const Icon = tipIcons[index] ?? Leaf;
            return (
              <div class="flex items-start gap-4 rounded-2xl border border-primary/10 bg-primary/[0.025] p-5 md:p-6">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-primary/10 bg-primary/5 text-primary">
                  <Icon size={24} strokeWidth={1.6} aria-hidden="true" />
                </span>
                <div class="min-w-0 pt-1">
                  <h3 class="mb-2 text-base font-semibold">
                    {item.title.replace(/\.$/, "")}
                  </h3>
                  <p class="text-sm leading-relaxed text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class={section} aria-labelledby="conservation-title">
      <figure class="mb-8 overflow-hidden rounded-2xl">
        <img
          src={palcoyo.src}
          srcset={palcoyo.srcset}
          sizes="100vw"
          width={palcoyo.width}
          height={palcoyo.height}
          alt={palcoyo.alt}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover md:aspect-[2.8]"
        />
      </figure>
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div>
          <h2 id="conservation-title" class={heading}>
            ¿Por qué es importante proteger los destinos que visitamos?
          </h2><SectionDivider />
        </div><div class={body}>
          {copy.conservation.map((text) => <p>{text}</p>)}
        </div>
      </div>
    </section>

    <section
      class={`${section} border-t border-border`}
      aria-labelledby="related-purpose-title"
    >
      <div
        class="grid items-center gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
      >
        <div class="lg:order-2">
          <p class={eyebrow}>Descubre nuestros compromisos</p><h2
            id="related-purpose-title"
            class={heading}
          >
            Otras formas de descubrir el Perú
          </h2><SectionDivider />
        </div>
        <p class={body}>{copy.relatedIntro}</p>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {
          copy.related.map((item, index) => (
            <a
              href={`/es/${item.slug}/`}
              class="group/related flex gap-5 rounded-2xl border border-border p-6 text-foreground! transition-colors hover:border-primary/30 hover:bg-primary/[0.025] hover:no-underline! focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none md:p-8"
            >
              <>
                <span
                  class="mt-1 h-10 w-0.5 shrink-0 bg-primary/40"
                  aria-hidden="true"
                />
                <div>
                  <>
                    <p class="mb-3 text-xs font-semibold tracking-wider text-primary uppercase">
                      {index === 0
                        ? "Turismo responsable"
                        : "Turismo inclusivo"}
                    </p>
                    <h3 class="mb-3 text-xl leading-tight font-semibold tracking-tight">
                      {item.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {item.description}
                    </p>
                    <span class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary">
                      Conoce más{" "}
                      <span
                        aria-hidden="true"
                        class="transition-transform motion-safe:group-hover/related:translate-x-1 motion-reduce:transition-none"
                      >
                        →
                      </span>
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </section>

    <section class={section} aria-labelledby="sustainable-faq">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
        <div>
          <h2 id="sustainable-faq" class={heading}>
            Preguntas frecuentes sobre turismo sostenible en Perú
          </h2><SectionDivider />
        </div>
        <div class="border-t border-border">
          {
            copy.faq.map((item) => (
              <details
                class="group/faq border-b border-border"
                name="sustainable-faq"
              >
                <>
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-5 py-5 text-base font-semibold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
                    {item.question}
                    <svg
                      class="size-4 shrink-0 text-primary transition-transform group-open/faq:rotate-45 motion-reduce:transition-none"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      aria-hidden="true"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  <p class="pb-6 text-sm leading-[1.8] text-muted-foreground">
                    {item.answer}
                  </p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class={`${wrap} relative isolate mb-16 overflow-hidden rounded-2xl px-6 py-12 text-white md:px-12 md:py-16`}
      aria-labelledby="sustainable-final-title"
    >
      <img
        src={getImageUrl(tours[3].tour.imagenDestacada, "large")}
        srcset={getImageSrcSet(tours[3].tour.imagenDestacada)}
        sizes="100vw"
        width={sandoval.width}
        height={sandoval.height}
        alt="Bosque y aguas del Lago Sandoval, en la Amazonía peruana"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-black/70" aria-hidden="true"></div>
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="sustainable-final-title" class={heading}>
          El próximo viaje también puede ser una oportunidad para cuidar
        </h2><SectionDivider align="center" /><div
          class="mt-5 space-y-4 text-[0.95rem] leading-[1.85] text-white/90"
        >
          {copy.closing.map((text) => <p>{text}</p>)}
        </div><div class="mt-7 flex flex-wrap justify-center gap-3">
          <a
            href="/es/paquetes-peru/"
            class={primaryButton}
            data-sustainable-event="catalog"
            >Ver tours <span aria-hidden="true">→</span></a
          ><a
            href="/es/planea-tu-viaje/"
            class={outlineButton}
            data-sustainable-event="plan_trip">Planea tu viaje</a
          >
        </div>
      </div>
    </section>
  </div>
</LocalizedPurpose>

<script>
  // Reutiliza el dataLayer de GTM del layout; no carga otro script analítico.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>(
      "#sustainable-landing a",
    );
    if (!link) return;
    const tourSlug = link
      .closest("article")
      ?.querySelector<HTMLElement>("[data-tour-slug]")?.dataset.tourSlug;
    const action =
      link.dataset.sustainableEvent || (tourSlug ? "tour" : undefined);
    if (!action) return;
    const analytics = window as Window & {
      dataLayer?: Record<string, unknown>[];
    };
    analytics.dataLayer ??= [];
    analytics.dataLayer.push({
      event: "sustainable_tourism_click",
      action,
      destination: link.getAttribute("href"),
      ...(tourSlug ? { tour_slug: tourSlug } : {}),
      page_location: window.location.href,
    });
  });
</script>
