---
import { Expand, ExternalLink, X } from "lucide-react";
interface Props {
  id: string;
  src: string;
  title: string;
  source?: string;
}
const { id, src, title, source } = Astro.props;
---

<circuit-map class="block min-w-0">
  <figure class="m-0 overflow-hidden rounded-xl border border-border bg-white">
    <a
      href={src}
      data-map-open
      aria-haspopup="dialog"
      aria-controls={`${id}-dialog`}
      aria-label={`Ampliar ${title.toLowerCase()}`}
      class="group block text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
    >
      <img
        src={src}
        alt={title}
        width="2048"
        height="1448"
        loading="lazy"
        decoding="async"
        class="aspect-[2048/1448] w-full bg-white object-contain p-2"
      />
      <span
        class="flex min-h-12 items-center justify-between gap-3 border-t border-border px-4 py-3 text-sm font-semibold transition-colors group-hover:bg-primary/5 motion-reduce:transition-none"
      >
        Ampliar mapa <Expand size={22} aria-hidden="true" />
      </span>
    </a>
    <figcaption
      class="border-t border-border px-4 py-3 text-xs leading-5 text-muted-foreground"
    >
      Cartografía: Ministerio de Cultura del Perú.
      {
        source && (
          <a
            class="mt-1 inline-flex min-h-7 items-center gap-1 text-primary underline underline-offset-4"
            href={source}
            target="_blank"
            rel="noopener noreferrer"
          >
            Consultar mapa oficial en PDF{" "}
            <>
              <ExternalLink size={18} aria-hidden="true" />
              <span class="sr-only"> (abre en otra pestaña)</span>
            </>
          </a>
        )
      }
    </figcaption>
  </figure>
  <dialog
    id={`${id}-dialog`}
    aria-labelledby={`${id}-title`}
    closedby="any"
    class="m-auto max-h-[94dvh] w-[min(96vw,90rem)] max-w-none rounded-xl border border-border bg-white p-0 text-foreground shadow-2xl backdrop:bg-black/80"
  >
    <header
      class="flex items-center justify-between gap-4 border-b border-border px-4 py-3"
    >
      <h2 id={`${id}-title`} class="text-base font-semibold sm:text-lg">
        {title}
      </h2>
      <form method="dialog">
        <button
          autofocus
          type="submit"
          class="grid size-11 cursor-pointer place-items-center rounded-full border border-border hover:bg-muted focus-visible:outline-2 focus-visible:outline-secondary"
          aria-label="Cerrar mapa"><X size={24} aria-hidden="true" /></button
        >
      </form>
    </header>
    <div class="overflow-auto p-2 sm:p-4">
      <img
        src={src}
        alt={title}
        width="2048"
        height="1448"
        loading="lazy"
        class="mx-auto max-h-[73dvh] w-full object-contain"
      />
    </div>
    <div class="border-t border-border px-4 py-3 text-sm">
      <a
        href={src}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-8 items-center gap-2 text-primary underline underline-offset-4"
        >Abrir imagen a tamaño completo <ExternalLink
          size={20}
          aria-hidden="true"
        /><span class="sr-only"> (abre en otra pestaña)</span></a
      >
    </div>
  </dialog>
</circuit-map>

<script>
  class CircuitMap extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector<HTMLAnchorElement>("[data-map-open]");
      const dialog = this.querySelector("dialog");
      if (!trigger || !dialog || this.dataset.ready) return;
      this.dataset.ready = "true";
      trigger.addEventListener("click", (event) => {
        // Preserve opening the image in a new tab and the no-JS image fallback.
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        if (typeof dialog.showModal !== "function") return;
        event.preventDefault();
        if (!dialog.open) dialog.showModal();
      });
      dialog.addEventListener("close", () =>
        trigger.focus({ preventScroll: true }),
      );
      if (!("closedBy" in HTMLDialogElement.prototype)) {
        dialog.addEventListener("click", (event) => {
          if (event.target !== dialog) return;
          const rect = dialog.getBoundingClientRect();
          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          )
            dialog.close();
        });
      }
    }
  }
  if (!customElements.get("circuit-map"))
    customElements.define("circuit-map", CircuitMap);
</script>
