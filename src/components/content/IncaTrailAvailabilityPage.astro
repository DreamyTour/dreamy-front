---
import PageLayout from "@/layouts/PageLayout.astro";
import HomeTourCard from "@/components/ui/HomeTourCard.astro";
import IncaTrailAvailabilityBookingIsland from "@/components/content/IncaTrailAvailabilityBookingIsland.astro";
import IncaTrailBookingGuide from "./IncaTrailBookingGuide.astro";
import { fetchAllStrapi } from "@/lib/strapi";
import { dedupeLocalizedDocuments, sortToursByOrder } from "@/lib/utils";
import type { Lang } from "@/lib/i18n";
import type { SEOProps } from "@/components/layout/SEO.astro";
import type { Tour, Category as TourCategory } from "@/types/tours";
import { serializeJsonForHtml } from "@/lib/html";
import { incaTrailAvailabilitySlugMap } from "@/data/incaTrailAvailabilityPage";
import {
  getIncaTrailBookingConfig,
  getIncaTrailAvailabilityTours,
} from "@/lib/incaTrailBooking";

interface Props {
  lang: Lang;
  seo: SEOProps;
}

const { lang, seo } = Astro.props;
const isBookingUrl = Astro.url.searchParams.has("tour");
const pageSeo: SEOProps = {
  ...seo,
  ...(isBookingUrl ? { robots: "noindex, follow" } : {}),
};
if (isBookingUrl) {
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}

const copyByLang = {
