      "Fechamento anual",
    ],
    toursTitle: "Tours da Trilha Inca",
    toursIntro:
      "Estas experiencias pertencem a categoria Trilha Inca e podem ser reservadas conforme as vagas oficiais.",
    noTours: "Nao encontramos tours publicados na categoria Trilha Inca.",
    paymentTitle: "Solicitacao de pre-reserva",
    paymentIntro:
      "Nenhum pagamento e realizado nesta pagina. Envie seus dados e a preferencia de pagamento para que nossa equipe analise a solicitacao.",
    depositTitle: "Preferencia de pagamento",
    depositItems: [
      "Voce pode indicar se prefere pagar depois uma entrada de 50% ou o valor total.",
      "A escolha e apenas informativa: nao gera cobranca nem confirma a reserva.",
    ],
    conditionsTitle: "Analise por um agente",
    conditions:
      "Ao enviar a pre-reserva, nossos agentes recebem uma cotacao em PDF com os dados dos viajantes, a data escolhida, as vagas consultadas e o valor preferido.",
    methodsTitle: "Proximo passo",
    methods: [
      "Um agente verifica novamente o preco e a disponibilidade.",
      "A equipe entra em contato para resolver qualquer detalhe.",
      "Depois, voce recebe as instrucoes ou o link de pagamento por outro canal.",
    ],
    confirmationTitle: "Confirmacao posterior",
    confirmation:
      "A pre-reserva nao garante a vaga. A reserva e confirmada somente quando a agencia valida o pagamento e emite a permissao oficial correspondente.",
    categoryLabel: "Trilha Inca",
    stats: [
      "permissoes diarias entre viajantes, guias e carregadores",
      "meses de antecedencia recomendados para reservar",
      "fechado para manutencao da rota",
    ],
  },
} as const;

const copy = copyByLang[lang];
const designCopy = {
  es: {
    title: "Tu aventura empieza en el",
    bookingTitle: "Reserva de tour",
    accent: "Camino Inca",
    intro:
      "Elige tu recorrido, encuentra una fecha disponible y prepara tu viaje a Machu Picchu en tres pasos.",
    tours: "Experiencias",
    permits: "Permisos diarios",
    live: "Disponibilidad de permisos",
    planning: "Planea tu aventura",
    steps: ["Elige tu experiencia", "Encuentra tu fecha", "Prepara tu reserva"],
  },
  en: {
    title: "Your adventure begins on the",
    bookingTitle: "Tour booking",
    accent: "Inca Trail",
    intro:
      "Choose your journey, find an available date and plan your trip to Machu Picchu in three simple steps.",
    tours: "Experiences",
    permits: "Daily permits",
    live: "Permit availability",
    planning: "Plan your adventure",
    steps: ["Choose your experience", "Find your date", "Prepare your booking"],
  },
  pt: {
    title: "Sua aventura começa na",
    bookingTitle: "Reserva do tour",
    accent: "Trilha Inca",
    intro:
      "Escolha seu roteiro, encontre uma data disponível e prepare sua viagem a Machu Picchu em três etapas.",
    tours: "Experiências",
    permits: "Permissões diárias",
    live: "Disponibilidade de permissões",
    planning: "Planeje sua aventura",
    steps: [
      "Escolha sua experiência",
      "Encontre sua data",
      "Prepare sua reserva",
    ],
  },
}[lang];
const now = new Date();
const calendarYear = 2026;
const initialMonth =
  calendarYear === now.getFullYear() ? now.getMonth() + 1 : 1;

const calendarRoadLabelsByLang = {
  es: {
    "1": "Camino Inca 4 dias",
    "5": "Camino Inca 2 dias",
  },
  en: {
    "1": "Classic Inca Trail 4 Days",
    "5": "Short Inca Trail 2 Days",
  },
  pt: {
    "1": "Trilha Inca Classica 4 dias",
    "5": "Trilha Inca Curta 2 dias",
  },
} as const;

const normalizeText = (value: string | undefined) =>
  (value || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "");

const categoryAliases = [
  "inca trail",
  "camino inca",
  "trilha inca",
  "trilha-inca",
  "inca-trail",
  "camino-inca",
];

function isIncaTrailCategory(category: TourCategory) {
  const source = `${category.slug} ${category.nombre}`;
  const normalized = normalizeText(source).replaceAll("-", " ");

  return categoryAliases.some((alias) =>
    normalized.includes(alias.replaceAll("-", " ")),
  );
}

const toursRaw = await fetchAllStrapi<Tour>({
  endpoint: "tours",
  locale: lang,
  query: {
    "sort[0]": "orden:asc",
    "sort[1]": "titulo:asc",
  },
});

const tours = sortToursByOrder(
  dedupeLocalizedDocuments(Array.isArray(toursRaw) ? toursRaw : []).filter(
    (tour) => tour.categories?.some(isIncaTrailCategory),
  ),
);

type AvailabilityBookingTour = {
  road: string;
  durationDays: number;
  permitStartOffsetDays: number;
  tourId: string | number;
  tourName: string;
  basePrice?: number;
  slug: string;
};

const configuredTours: AvailabilityBookingTour[] = dedupeLocalizedDocuments(
  Array.isArray(toursRaw) ? toursRaw : [],
).flatMap((tour) => {
  const config = getIncaTrailBookingConfig(tour.slug);
  return config
    ? [
        {
          road: config.road,
          durationDays: config.durationDays,
          permitStartOffsetDays: config.permitStartOffsetDays,
          tourId: tour.documentId || tour.id,
          tourName: tour.titulo,
          basePrice: tour.priceTour,
          slug: tour.slug,
        },
      ]
    : [];
});
const requestedTour = configuredTours.find(
  (tour) => tour.slug === Astro.url.searchParams.get("tour"),
);
const initialTourSlug = requestedTour?.slug;
const initialRoad = requestedTour?.road ?? "1";
const bookingTours = requestedTour
  ? [requestedTour]
  : getIncaTrailAvailabilityTours(configuredTours);
---

<PageLayout seo={pageSeo} lang={lang} enableViewTransitions={false}>
  <script
    is:inline
    id="page-slug-map"
    type="application/json"
    set:html={serializeJsonForHtml(incaTrailAvailabilitySlugMap)}
  />

  <div class="inca-availability bg-[#f7f9f7]">
    <section
      class="border-b border-primary/10 bg-white bg-[radial-gradient(ellipse_at_15%_40%,rgba(0,112,32,0.07),transparent_55%),radial-gradient(ellipse_at_85%_20%,rgba(183,21,50,0.05),transparent_50%)]"
    >
      <div
        class="mx-auto flex max-w-8xl flex-col justify-between gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-end lg:px-8 lg:py-12"
      >
        <div class="max-w-2xl">
          <span
            class="inline-flex items-center gap-2 rounded-full bg-secondary/8 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-secondary"
            ><span class="size-1.5 rounded-full bg-secondary"></span>{
              designCopy.live
            }
            {calendarYear}</span
          >
          <h1
            class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-foreground md:text-4xl lg:text-5xl"
          >
            {
              requestedTour ? (
                <>
                  <span class="mb-3 block text-sm font-bold uppercase tracking-wider text-primary">
                    {designCopy.bookingTitle}{" "}
                  </span>
                  {requestedTour.tourName}
                </>
              ) : (
                <>
                  {designCopy.title}{" "}
                  <span class="text-primary">{designCopy.accent}</span>
                </>
              )
            }
          </h1>
          <p
            class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground"
          >
            {designCopy.intro}
          </p>
        </div>
        <div class="flex shrink-0 gap-3">
          <div
            class="rounded-2xl border border-primary/10 bg-primary/5 px-5 py-3"
          >
            <strong class="block text-2xl font-extrabold text-primary"
              >{bookingTours.length}</strong
            ><span class="text-xs text-muted-foreground"
              >{designCopy.tours}</span
            >
          </div>
          <div
            class="rounded-2xl border border-secondary/10 bg-secondary/5 px-5 py-3"
          >
            <strong class="block text-2xl font-extrabold text-secondary"
              >500</strong
            ><span class="text-xs text-muted-foreground"
              >{designCopy.permits}</span
            >
          </div>
        </div>
      </div>
    </section>
    <section
      id="availability-calendar"
      tabindex="-1"
      aria-label={designCopy.planning}
      class="mx-auto max-w-8xl scroll-mt-6 px-4 py-8 focus:outline-none sm:px-6 lg:px-8 lg:py-10"
    >
      <ol
        class="mb-7 grid grid-cols-3 gap-2 text-xs font-semibold text-muted-foreground sm:gap-5 sm:text-sm"
      >
        {
          designCopy.steps.map((step, index) => (
            <li class="flex items-center gap-2 rounded-xl border border-border/60 bg-white px-3 py-3 sm:px-4">
              <>
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">
                  {index + 1}
                </span>
                <span>{step}</span>
              </>
            </li>
          ))
        }
      </ol>
      <IncaTrailAvailabilityBookingIsland
        server:defer
        lang={lang}
        year={calendarYear}
        initialMonth={initialMonth}
        initialRoad={initialRoad}
        initialTourSlug={initialTourSlug}
        roadLabels={calendarRoadLabelsByLang[lang]}
        tours={bookingTours}
      >
        <div
          slot="fallback"
          aria-hidden="true"
          class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]"
        >
          <div
            class="min-h-[650px] space-y-6 rounded-2xl border border-border/60 bg-white p-7"
          >
            <div class="h-7 w-1/2 rounded-lg bg-primary/10"></div><div
              class="h-12 rounded-xl bg-muted"
            >
            </div><div class="mt-8 h-7 w-2/3 rounded-lg bg-primary/10">
            </div><div class="grid grid-cols-7 gap-2">
              {
                Array.from({ length: 35 }).map(() => (
                  <div class="h-16 rounded-lg bg-muted" />
                ))
              }
            </div>
          </div>
          <div class="h-96 rounded-2xl border border-primary/10 bg-white p-6">
            <div class="h-28 rounded-xl bg-primary/5"></div><div
              class="mt-6 h-8 rounded-lg bg-muted"
            >
            </div><div class="mt-6 h-12 rounded-xl bg-primary/10"></div>
          </div>
        </div>
      </IncaTrailAvailabilityBookingIsland>
    </section>

    <div class="mx-auto max-w-8xl px-4 py-12 md:px-6 lg:px-8">
      <IncaTrailBookingGuide lang={lang} information={copy} />

      <section class="py-14 md:py-16">
        <div
          class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
        >
          <div>
            <span
              class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary"
            >
              {copy.categoryLabel}
            </span>
            <h2
              class="mt-2 text-3xl font-semibold tracking-tight text-foreground"
            >
              {copy.toursTitle}
            </h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
            {copy.toursIntro}
          </p>
        </div>

        {
          tours.length > 0 ? (
            <div class="grid grid-cols-1 gap-x-2 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
              {tours.map((tour) => (
                <HomeTourCard tour={tour} lang={lang} />
              ))}
            </div>
          ) : (
            <div class="rounded-sm border border-dashed border-border bg-muted/40 p-8 text-center text-muted-foreground">
              {copy.noTours}
            </div>
          )
        }
      </section>
    </div>
  </div>
</PageLayout>
