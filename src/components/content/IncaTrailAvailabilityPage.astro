    statsValues: ["500", "6 meses", "Febrero"],
    statsKickers: ["Permisos diarios", "Reserva anticipada", "Cierre anual"],
    toursTitle: "Tours de Camino Inca",
    toursIntro:
      "Estas experiencias pertenecen a la categoria Camino Inca y estan disponibles para reserva segun cupos oficiales.",
    noTours: "No encontramos tours publicados en la categoria Camino Inca.",
    paymentTitle: "Solicitud de pre-reserva",
    paymentIntro:
