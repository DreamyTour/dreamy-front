---
import type { Lang } from "@/lib/i18n";
import LocalizedCircuitGuide from "./LocalizedCircuitGuide.astro";
import { circuitText, circuitHref } from "@/lib/localizeCircuitGuide";
import {
  localizedRoutePath,
  circuitOverviewPath,
  circuitRouteSlugMap,
} from "@/data/circuitGuideTranslations";
import { localizedCircuitSeo } from "@/data/circuitGuideLocalizedSeo";
import Layout from "@/layouts/main.astro";
import CircuitMap from "@/components/content/CircuitMap.astro";
import CircuitGuideSources from "@/components/content/CircuitGuideSources.astro";
import {
  ArrowLeft,
  ArrowRight,
  Check,
  Clock3,
  Info,
  MapPinned,
  Footprints,
} from "lucide-react";
import "@/styles/circuit-themes.css";
import { buildSEOProps } from "@/lib/seo";
import { circuitRouteSeo } from "@/data/machuPicchuGuideSeo";
import {
  circuitGuides,
  circuitRouteGuides,
  guideSources,
  routeGuideHref,
  routeMapImage,
  routeMapSource,
  type CircuitRouteGuide,
} from "@/data/machuPicchuGuide";

interface Props {
  route: CircuitRouteGuide;
  lang?: Lang;
}
const { route, lang = "es" } = Astro.props;
const circuit = circuitGuides.find((item) => item.number === route.circuit)!;
const siblings = circuitRouteGuides.filter(
  (item) => item.circuit === route.circuit && item.slug !== route.slug,
);
const title = `Ruta ${route.code}: ${route.name}`;
const metadata =
  lang === "es"
    ? circuitRouteSeo[route.slug]
    : localizedCircuitSeo[lang][route.slug];
const seo = buildSEOProps({
  fallbackTitle: metadata.title,
  fallbackDescription: metadata.description,
  fallbackImage: routeMapImage(route),
  fallbackImageAlt: circuitText(
    `Mapa de la ruta ${route.code}: ${route.name}`,
    lang,
  ),
  canonicalUrl: new URL(
    localizedRoutePath(route.slug, lang),
    Astro.site || "https://dreamy.tours",
  ).href,
  lang,
  type: "website",
  slugMap: circuitRouteSlugMap(route.slug),
});
seo.breadcrumbs = [
  {
    name: circuitText("Inicio", lang),
    url: new URL(circuitHref("/es/", lang), Astro.site).href,
  },
  {
    name: circuitText("Circuitos de Machu Picchu", lang),
    url: new URL(circuitOverviewPath[lang], Astro.site).href,
  },
  { name: circuitText(title, lang), url: seo.canonicalUrl! },
];
---

<Layout lang={lang} seo={seo} enableViewTransitions={false}>
  <LocalizedCircuitGuide lang={lang}>
    <div
      class={`route-guide theme-${circuit.theme} page-shell pb-16 text-foreground`}
    >
      <nav
        aria-label="Ruta de navegación"
        class="flex flex-wrap items-center gap-2 py-6 text-xs leading-6 text-muted-foreground"
      >
        <a href="/es/" class="hover:text-primary">Inicio</a><span
          aria-hidden="true">/</span
        >
        <a href="/es/circuitos-machupicchu/" class="hover:text-primary"
          >Circuitos de Machu Picchu</a
        ><span aria-hidden="true">/</span>
        <span aria-current="page">Ruta {route.code}</span>
      </nav>
      <article>
        <header class="route-hero rounded-2xl border border-border p-6 md:p-10">
          <a
            href={`/es/circuitos-machupicchu/#${circuit.id}`}
            class="inline-flex min-h-9 items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary hover:underline"
            ><ArrowLeft size={20} aria-hidden="true" />Circuito {circuit.number} ·
            {circuit.name}</a
          >
          <h1
            class="mt-4 max-w-5xl text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl"
          >
            {title}
          </h1>
          <p
            class="mt-4 max-w-3xl text-base leading-8 text-foreground md:text-lg"
          >
            {route.summary}
          </p>
          <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium">
            <span
              class="rounded-full border border-border bg-muted/50 px-3 py-2"
              >Guía de la ruta · Machu Picchu</span
            >
            <span
              class:list={[
                "rounded-full border px-3 py-2",
                route.seasonal
                  ? "border-amber-800/15 bg-amber-50 text-amber-900"
                  : "border-primary/15 bg-primary/5 text-primary",
              ]}
              >{
                route.seasonal
                  ? "Ruta de temporada alta"
                  : "Ruta sin restricción estacional en el listado oficial"
              }</span
            >
          </div>
        </header>
        <dl
          class="route-facts mt-6 grid gap-4 text-sm leading-6 md:grid-cols-3"
        >
          <div>
            <dt class="flex items-center gap-2 font-semibold">
              <Clock3 size={26} aria-hidden="true" />Permanencia máxima según el
              mapa publicado
            </dt><dd class="mt-1 pl-6">
              <strong class="text-lg font-semibold text-primary"
                >{route.maxStay}</strong
              ><p class="mt-1 text-muted-foreground">
                Es el límite indicado en el <a
                  href={routeMapSource(route)}
                  class="text-primary underline underline-offset-4"
                  >mapa del Ministerio de Cultura</a
                >, no una duración garantizada de caminata. Comprueba las
                condiciones vigentes de tu boleto.
              </p>
            </dd>
          </div>
          <div>
            <dt class="flex items-center gap-2 font-semibold">
              <Footprints size={26} aria-hidden="true" />Esfuerzo del recorrido
            </dt><dd class="mt-1 pl-6 text-muted-foreground">
              {route.effort}
            </dd>
          </div>
          <div>
            <dt class="flex items-center gap-2 font-semibold">
              <Info size={26} aria-hidden="true" />Disponibilidad
            </dt><dd class="mt-1 pl-6 text-muted-foreground">
              {
                route.seasonal
                  ? "El Ministerio la clasifica como ruta de temporada alta. Confirma las fechas habilitadas y posibles cierres para tu viaje."
                  : "El listado oficial no la limita a temporada alta. Los cupos, horarios y posibles cierres deben confirmarse para tu fecha."
              }
            </dd>
          </div>
        </dl>

        <div
          class="grid items-start gap-10 py-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14"
        >
          <div class="min-w-0">
            <h2 class="text-2xl font-semibold tracking-tight">
              ¿Cómo es esta ruta?
            </h2>
            <div
              class="route-description mt-5 space-y-5 text-base leading-8 text-muted-foreground"
            >
              {route.paragraphs.map((text) => <p>{text}</p>)}
            </div>
          </div>
          <aside
            class="route-map-frame min-w-0 rounded-2xl p-4 sm:p-5 lg:sticky lg:top-28"
            aria-label="Mapa individual de la ruta"
          >
            <p
              class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
            >
              <MapPinned size={22} aria-hidden="true" />Mapa individual · Ruta {
                route.code
              }
            </p>
            <CircuitMap
              id={`map-${route.slug}`}
              src={routeMapImage(route)}
              title={`Mapa de la ruta ${route.code}: ${route.name}`}
              source={routeMapSource(route)}
            />
            <p class="mt-3 text-xs leading-6 text-muted-foreground">
              Sigue el trazado marcado y sus flechas. La leyenda puede mostrar
              otros lugares del conjunto que no forman parte de esta ruta.
            </p>
          </aside>
        </div>

        <section
          class="grid gap-5 pb-10 md:grid-cols-2"
          aria-label="Alcance del recorrido"
        >
          <div
            class="included-panel rounded-2xl border border-border p-6 sm:p-7"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold">
              <Check size={28} aria-hidden="true" />Qué incluye el recorrido
            </h2><ul
              class="mt-4 list-disc space-y-3 pl-5 text-sm leading-7 text-muted-foreground"
            >
              {route.includes.map((text) => <li>{text}</li>)}
            </ul>
          </div>
          <div
            class="excluded-panel rounded-2xl border border-border p-6 sm:p-7"
          >
            <h2 class="flex items-center gap-2 text-xl font-semibold">
              <Info size={28} aria-hidden="true" />Qué queda fuera de esta ruta
            </h2><ul
              class="mt-4 list-disc space-y-3 pl-5 text-sm leading-7 text-muted-foreground"
            >
              {route.excludes.map((text) => <li>{text}</li>)}
            </ul>
          </div>
        </section>

        <section
          class="route-booking grid gap-6 rounded-2xl p-6 md:grid-cols-[0.65fr_1fr] md:gap-14 md:p-9"
          aria-labelledby="before-booking"
        >
          <h2 id="before-booking" class="text-2xl font-semibold tracking-tight">
            Antes de elegir<br />tu entrada
          </h2>
          <div class="space-y-4 leading-8 text-muted-foreground">
            <p class="route-advice rounded-xl bg-white p-5 text-foreground">
              {route.advice}
            </p>
            <p>
              En la <a
                href={guideSources.tickets}
                class="font-medium text-primary underline underline-offset-4"
                >plataforma oficial TuBoleto</a
              >, selecciona el circuito {route.circuit} y comprueba el código <strong
                class="text-foreground">{route.code}</strong
              >, la fecha y el horario antes de pagar. Revisa también las
              restricciones de edad y los documentos exigidos para tu tarifa.
            </p>
            <p>
              La entrada al sitio arqueológico y los servicios de tren, bus o
              guía se coordinan por separado, salvo que tu reserva los incluya
              expresamente. Si la ruta tiene montaña, confirma también su
              horario de control para organizar el resto del día.
            </p>
            <a
              href="/es/planea-tu-viaje/"
              class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >Consultar esta ruta con Dreamy Tours <ArrowRight
                size={22}
                aria-hidden="true"
              /></a
            >
          </div>
        </section>
      </article>

      <nav
        class="mb-10 mt-10 border-t border-border pt-9"
        aria-label={`Otras rutas del circuito ${route.circuit}`}
      >
        <h2 class="text-2xl font-semibold tracking-tight">
          Otras rutas del circuito {route.circuit}
        </h2>
        <ul class="mt-5 grid list-none gap-3 p-0 md:grid-cols-3">
          {
            siblings.map((item) => (
              <li>
                <a
                  href={routeGuideHref(item)}
                  class="flex h-full min-h-20 items-center justify-between gap-4 rounded-xl border border-border p-4 text-foreground no-underline hover:border-primary hover:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                >
                  <>
                    <span>
                      <>
                        <span class="block text-xs font-semibold text-primary">
                          Ruta {item.code}
                        </span>
                        <span class="mt-1 block font-medium">{item.name}</span>
                      </>
                    </span>
                    <ArrowRight size={26} aria-hidden="true" />
                  </>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={`/es/circuitos-machupicchu/#${circuit.id}`}
          class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary hover:underline"
          ><ArrowLeft size={22} aria-hidden="true" />Volver a todos los
          circuitos y mapas generales</a
        >
      </nav>
      <CircuitGuideSources />
    </div>
  </LocalizedCircuitGuide>
</Layout>

<style>
  .route-guide :global(svg) {
    flex-shrink: 0;
  }
  .route-hero {
    background: var(--circuit-surface);
    border-top: 4px solid var(--circuit-color);
  }
  .route-guide a.text-primary,
  .route-guide span.text-primary,
  .route-guide strong.text-primary {
    color: var(--circuit-color);
  }
  .route-facts > div {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: white;
    box-shadow: 0 5px 20px rgb(24 52 36 / 0.05);
  }
  .route-facts dt {
    color: var(--circuit-color);
    align-items: flex-start;
  }
  .route-facts :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .route-facts dd {
    padding-left: 0;
    margin-top: 0.75rem;
  }
  .route-description p:first-child {
    color: var(--foreground);
    font-size: 1.125rem;
    line-height: 1.9;
  }
  .route-map-frame {
    background: var(--circuit-tint);
  }
  .route-map-frame :global([data-map-open] > span) {
    background: var(--circuit-color);
    color: white;
  }
  .route-map-frame :global([data-map-open]:hover > span) {
    background: color-mix(in srgb, var(--circuit-color) 85%, black);
  }
  .included-panel {
    background: var(--circuit-surface);
    border-top: 3px solid var(--circuit-color);
  }
  .included-panel h2 {
    color: var(--circuit-color);
  }
  .excluded-panel {
    background: #fffcf6;
    border-top: 3px solid #b78439;
  }
  .route-booking {
    background: var(--circuit-surface);
    border: 1px solid var(--border);
  }
  .route-advice {
    border-left: 3px solid var(--circuit-color);
  }
  .route-guide a.bg-primary {
    background: var(--circuit-color);
  }
</style>
