---
import LocalizedPurpose from "@/components/content/LocalizedPurpose.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import ProjectGallery from "@/components/content/ProjectGallery.astro";
import { ArrowLeft, Heart, MapPin, Images } from "lucide-react";

const campaigns = [
  {
    year: "2025",
    title: "Juegos y alegría en Saylla",
    place: "Distrito de Saylla · Cusco",
    text: "En 2025 volvimos a Saylla para compartir una jornada navideña con la comunidad. Repartimos juguetes, compartimos una chocolatada y organizamos dinámicas y actividades para disfrutar juntos. Entre juegos y sonrisas, seguimos fortaleciendo los lazos que dan sentido a esta tradición.",
    folder: "2025-saylla/",
    photos: ["1", "2", "3", "4"],
  },
  {
    year: "2024",
    title: "Una Navidad más en Saylla",
    place: "Distrito de Saylla · Cusco",
    text: "En 2024 compartimos una nueva jornada navideña en el distrito de Saylla, Cusco. Un encuentro para seguir fortaleciendo nuestro vínculo con la comunidad y celebrar juntos el espíritu de la Navidad.",
    folder: "2024-saylla/",
    photos: ["foto-01", "foto-02", "foto-03", "foto-04"],
  },
  {
    year: "2023",
    title: "Navidad en Patacolca",
    place: "Cusipata · Comunidad de Patacolca",
    text: "En 2023 visitamos la comunidad de Patacolca, en el distrito de Cusipata, para celebrar la Navidad. Llevamos chocolatada, panetones y juguetes a los niños, compartiendo una jornada llena de emoción, risas y el espíritu solidario que nos une cada diciembre.",
    folder: "patacolca-2023/",
    photos: ["1", "2", "3", "4", "5"],
  },
  {
    year: "2022",
    title: "Volver a compartir en Saylla",
    place: "Distrito de Saylla · Cusco",
    text: "En 2022 regresamos al distrito de Saylla para celebrar la Navidad junto a los niños y familias del lugar. Compartimos chocolatada, panetones y regalos, creando un ambiente de alegría, esperanza y gratitud que llenó de magia cada rincón de la comunidad.",
    photos: ["navidad-2022", "navidad-2022-1", "navidad-2022-2"],
  },
  {
    year: "2021",
    title: "Una tarde de unión en Huilloq",
    place: "Comunidad de Huilloq",
    text: "En 2021 celebramos la Navidad en la comunidad de Huilloq, llevando regalos, panetones y chocolatada para los niños. Compartimos una tarde llena de sonrisas, música y unión, fortaleciendo los lazos con una comunidad que siempre nos recibe con cariño.",
    photos: ["navidad-2021", "navidad-2021-1", "navidad-2021-2"],
  },
  {
    year: "2020",
    title: "Donde comenzó esta tradición",
    place: "Distrito de Saylla · Cusco",
    text: "En 2020 celebramos la Navidad en Saylla, compartiendo momentos de alegría con los niños del lugar. Llevamos chocolatada, panetones y regalos, y juntos disfrutamos juegos, risas y el espíritu solidario que dio inicio a nuestras actividades navideñas.",
    photos: ["navidad-2020", "navidad-2020-1", "navidad-2020-2"],
  },
];
const saylla2024Descriptions = [
  "Equipo de Dreamy Tours y participantes con vestuario navideño en Saylla, 2024",
  "Niños con vestuario festivo junto a Papá Noel durante la Navidad en Saylla, 2024",
  "Participantes de la campaña navideña con la bandera de Dreamy Tours en Saylla, 2024",
  "Celebración navideña con niños y familias frente a la Municipalidad Distrital de Saylla, 2024",
];
const saylla2025Descriptions = [
  "Niños y familias participando en una dinámica navideña con personajes festivos en Saylla, 2025",
  "Participantes reunidos en círculo durante los juegos de la campaña navideña en Saylla, 2025",
  "Vista de la jornada navideña con la comunidad junto al escenario decorado en Saylla, 2025",
  "Familias y personajes navideños reunidos frente al local de la actividad en Saylla, 2025",
];
---

<LocalizedPurpose>
  <div class="bg-background text-foreground">
    <div class="page-shell pb-16">
      <nav
        aria-label="Ruta de navegación"
        class="flex flex-wrap items-center gap-2 py-6 text-xs text-muted-foreground"
      >
        <a
          href="/es/"
          class="hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary"
          >Inicio</a
        ><span aria-hidden="true">/</span><a
          href="/es/proyecto-social/"
          class="hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary"
          >Proyecto social</a
        ><span aria-hidden="true">/</span><span aria-current="page"
          >Proyecto navideño</span
        >
      </nav>
      <section
        aria-labelledby="christmas-intro"
        class="grid gap-6 py-8 md:grid-cols-[1fr_1.2fr] md:gap-16 md:py-12"
      >
        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-primary"
          >
            Una tradición desde 2020
          </p><h2
            id="christmas-intro"
            class="text-3xl font-semibold leading-tight tracking-tight md:text-4xl"
          >
            Compartir también<br />es parte del viaje.
          </h2><SectionDivider />
        </div>
        <div class="space-y-4 leading-7 text-muted-foreground">
          <p>
            Cada diciembre, nuestro equipo se une para visitar comunidades del
            Valle Sagrado, Cusco y otras zonas andinas. Llevamos chocolatadas,
            panetones, juguetes y ropa de abrigo, pero sobre todo compartimos
            sonrisas, juegos y el espíritu solidario que nos motiva.
          </p><p>
            Lo que empezó como una pequeña iniciativa entre amigos se ha
            convertido en una tradición que crece gracias al apoyo de nuestros
            viajeros, colaboradores y guías.
          </p>
        </div>
      </section>
      <section aria-labelledby="christmas-timeline" class="pt-6 md:pt-10">
        <header class="mb-10 md:mb-14">
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-primary"
          >
            Encuentros que dejan huella
          </p><h2
            id="christmas-timeline"
            class="text-3xl font-semibold tracking-tight md:text-4xl"
          >
            Nuestra Navidad, año a año
          </h2><SectionDivider /><p
            class="max-w-2xl leading-7 text-muted-foreground"
          >
            Recuerdos de las comunidades con las que compartimos esta tradición.
          </p>
        </header>
        <christmas-timeline class="relative block">
          <nav
            aria-label="Ir a una campaña navideña"
            class="mb-8 flex flex-wrap items-center gap-2"
          >
            <span class="mr-2 text-xs text-muted-foreground"
              >Explora por año</span
            >
            {
              campaigns.map((campaign) => (
                <a
                  data-timeline-jump
                  href={`#navidad-${campaign.year}`}
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-background px-4 text-sm font-semibold text-muted-foreground transition-colors hover:border-secondary hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary data-[state=active]:border-secondary data-[state=active]:bg-secondary data-[state=active]:text-secondary-foreground data-[state=complete]:border-primary/25 data-[state=complete]:bg-primary/5 data-[state=complete]:text-primary"
                >
                  {campaign.year}
                </a>
              ))
            }
          </nav>
          <div class="relative">
            <svg
              data-timeline-line
              class="pointer-events-none absolute left-[1.4rem] top-6 h-[calc(100%-3rem)] w-1 md:left-1/2 md:-translate-x-1/2"
              viewBox="0 0 4 1000"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <defs
                ><clipPath id="christmas-timeline-green"
                  ><rect data-timeline-progress x="0" y="0" width="4" height="0"
                  ></rect></clipPath
                ></defs
              >
              <path
                d="M2 0V1000"
                class="stroke-secondary"
                stroke-width="3"
                vector-effect="non-scaling-stroke"></path>
              <path
                d="M2 0V1000"
                class="stroke-primary"
                stroke-width="3"
                vector-effect="non-scaling-stroke"
                clip-path="url(#christmas-timeline-green)"></path>
            </svg>
            <ol class="relative m-0 list-none p-0">
              {
                campaigns.map((campaign, index) => (
                  <li
                    id={`navidad-${campaign.year}`}
                    data-timeline-entry
                    tabindex="-1"
                    class="group/timeline relative scroll-mt-36 pb-12 pl-16 outline-none last:pb-0 md:pb-16 md:pl-0"
                  >
                    <span
                      aria-hidden="true"
                      class:list={[
                        "pointer-events-none absolute left-12 top-10 w-4 border-t-2 border-dashed border-secondary/50 group-data-[state=complete]/timeline:border-primary md:w-10",
                        index % 2 === 0
                          ? "md:left-1/2"
                          : "md:left-auto md:right-1/2",
                      ]}
                    />
                    <span
                      data-timeline-badge
                      class="absolute left-0 top-5 z-10 grid h-10 w-12 place-items-center rounded-full border border-secondary/30 bg-background text-sm font-bold text-secondary transition-colors group-data-[state=active]/timeline:border-secondary group-data-[state=active]/timeline:bg-secondary group-data-[state=active]/timeline:text-secondary-foreground group-data-[state=complete]/timeline:border-primary group-data-[state=complete]/timeline:bg-primary group-data-[state=complete]/timeline:text-primary-foreground motion-reduce:transition-none md:left-1/2 md:-translate-x-1/2"
                    >
                      {campaign.year}
                    </span>
                    <article
                      aria-labelledby={`campaign-${campaign.year}`}
                      class="grid items-center gap-6 md:grid-cols-2 md:gap-20"
                    >
                      <div
                        class:list={[
                          "min-w-0",
                          index % 2 === 1 && "md:col-start-2 md:row-start-1",
                        ]}
                      >
                        {campaign.photos.length > 0 ? (
                          <ProjectGallery
                            id={`christmas-${campaign.year}`}
                            title={`${campaign.title} · ${campaign.year}`}
                            images={campaign.photos.map((photo, i) => ({
                              src: `/imagenes/proyecto-social/navidad/${campaign.folder || ""}${photo}.webp`,
                              preview: campaign.folder
                                ? `/imagenes/proyecto-social/navidad/${campaign.folder}${photo}-800.webp`
                                : undefined,
                              thumbnail: campaign.folder
                                ? `/imagenes/proyecto-social/navidad/${campaign.folder}${photo}-thumb.webp`
                                : undefined,
                              alt:
                                campaign.year === "2025"
                                  ? saylla2025Descriptions[i]
                                  : campaign.year === "2024"
                                    ? saylla2024Descriptions[i]
                                    : `${campaign.title}: recuerdo ${i + 1} de la campaña navideña de Dreamy Tours`,
                            }))}
                          />
                        ) : (
                          <div class="grid aspect-[1.5] place-items-center rounded-2xl border border-dashed border-primary/25 bg-primary/5 p-6 text-center">
                            <div>
                              <Images
                                size={32}
                                strokeWidth={1.25}
                                className="mx-auto mb-3 text-primary"
                                aria-hidden="true"
                              />
                              <p class="text-sm font-semibold text-foreground">
                                Navidad en Saylla · 2024
                              </p>
                              <p class="mt-1 text-xs text-muted-foreground">
                                Pronto compartiremos las fotos de esta jornada.
                              </p>
                            </div>
                          </div>
                        )}
                      </div>
                      <div
                        class:list={[
                          "relative",
                          index % 2 === 1 && "md:col-start-1 md:row-start-1",
                        ]}
                      >
                        <p class="mb-3 flex items-start gap-2 text-xs font-semibold uppercase leading-5 tracking-[0.07em] text-primary">
                          <MapPin
                            size={15}
                            className="mt-0.5 shrink-0"
                            aria-hidden="true"
                          />
                          {campaign.place}
                        </p>
                        <h3
                          id={`campaign-${campaign.year}`}
                          class="mb-4 text-2xl font-semibold leading-tight tracking-tight lg:text-3xl"
                        >
                          {campaign.title}
                        </h3>
                        <p class="text-sm leading-7 text-muted-foreground md:text-base">
                          {campaign.text}
                        </p>
                      </div>
                    </article>
                  </li>
                ))
              }
            </ol>
          </div>
        </christmas-timeline>
      </section>
      <div
        class="mt-12 flex flex-col items-start justify-between gap-6 rounded-2xl bg-primary/5 p-6 md:mt-16 md:flex-row md:items-center md:p-8"
      >
        <div class="flex items-start gap-3">
          <Heart
            size={22}
            className="mt-1 shrink-0 text-secondary"
            aria-hidden="true"
          /><p class="max-w-xl leading-7 text-foreground">
            Dar sin esperar, servir con alegría y compartir con cada comunidad
            que nos recibe.
          </p>
        </div><a
          href="/es/proyecto-social/"
          class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border border-secondary px-5 py-2 text-sm font-semibold text-secondary transition-colors hover:bg-secondary hover:text-secondary-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
          ><ArrowLeft size={16} aria-hidden="true" />Proyecto social</a
        >
      </div>
    </div>
  </div>
</LocalizedPurpose>

<script>
  class ChristmasTimeline extends HTMLElement {
    private abort?: AbortController;
    private observer?: ResizeObserver;
    private frame = 0;
    connectedCallback() {
      this.abort = new AbortController();
      const progress = this.querySelector<SVGRectElement>(
        "[data-timeline-progress]",
      )!;
      const line = this.querySelector<SVGSVGElement>("[data-timeline-line]")!;
      const entries = Array.from(
        this.querySelectorAll<HTMLElement>("[data-timeline-entry]"),
      );
      const links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>("[data-timeline-jump]"),
      );
      let previousActive = -1;
      const update = () => {
        this.frame = 0;
        const rect = line.getBoundingClientRect();
        const amount = Math.max(
          0,
          Math.min(1, (window.innerHeight * 0.4 - rect.top) / rect.height),
        );
        progress.setAttribute("height", String(amount * 1000));
        let active = 0;
        entries.forEach((entry, index) => {
          const badge = entry
            .querySelector<HTMLElement>("[data-timeline-badge]")!
            .getBoundingClientRect();
          if (badge.top + badge.height / 2 <= window.innerHeight * 0.4)
            active = index;
        });
        if (active !== previousActive) {
          previousActive = active;
          entries.forEach((entry, index) => {
            const state =
              index < active
                ? "complete"
                : index === active
                  ? "active"
                  : "upcoming";
            entry.dataset.state = links[index].dataset.state = state;
            if (index === active)
              links[index].setAttribute("aria-current", "location");
            else links[index].removeAttribute("aria-current");
          });
        }
      };
      const schedule = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update);
      };
      links.forEach((link, index) =>
        link.addEventListener(
          "click",
          (event) => {
            event.preventDefault();
            entries[index].scrollIntoView({
              block: "start",
              behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "instant"
                : "smooth",
            });
            entries[index].focus({ preventScroll: true });
            history.replaceState(null, "", link.hash);
          },
          { signal: this.abort!.signal },
        ),
      );
      window.addEventListener("scroll", schedule, {
        passive: true,
        signal: this.abort.signal,
      });
      window.addEventListener("resize", schedule, {
        passive: true,
        signal: this.abort.signal,
      });
      this.observer = new ResizeObserver(schedule);
      this.observer.observe(this);
      schedule();
    }
    disconnectedCallback() {
      this.abort?.abort();
      this.observer?.disconnect();
      cancelAnimationFrame(this.frame);
      this.frame = 0;
    }
  }
  if (!customElements.get("christmas-timeline"))
    customElements.define("christmas-timeline", ChristmasTimeline);
</script>
