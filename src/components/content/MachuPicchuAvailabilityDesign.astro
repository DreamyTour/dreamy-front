---
import type { Lang } from "@/lib/i18n";
import { availabilityTranslator } from "@/lib/machuPicchuAvailabilityI18n";
import { MACHU_PICCHU_ROUTES } from "@/lib/calendarAvailability";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props;
const t = availabilityTranslator(lang);
const weekdays = Array.from({ length: 7 }, (_, i) =>
  new Intl.DateTimeFormat(lang, { weekday: "short", timeZone: "UTC" }).format(
    new Date(Date.UTC(2026, 0, 5 + i)),
  ),
);
---

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
<div
  data-availability-lang={lang}
  class="mp-availability bg-[#f7f9f7] font-[Inter,sans-serif] [&_:is(button,select,a):focus-visible]:outline-3 [&_:is(button,select,a):focus-visible]:outline-[#b71532] [&_:is(button,select,a):focus-visible]:outline-offset-3 [&_select]:appearance-none"
>
  <!-- HERO -->
  <section
    class="bg-[radial-gradient(circle_at_20%_50%,rgba(0,112,32,0.08)_0%,transparent_50%),radial-gradient(circle_at_80%_20%,rgba(183,21,50,0.06)_0%,transparent_50%)] bg-white border-b border-gray-100"
  >
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      <div
        class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6"
      >
        <div class="max-w-2xl">
          <div
            class="inline-flex items-center gap-2 bg-[#fbeaed] text-[#B71532] text-xs font-bold px-3 py-1.5 rounded-full mb-4 uppercase tracking-wide"
          >
            <span class="w-1.5 h-1.5 bg-[#B71532] rounded-full animate-pulse"
            ></span>{t("Disponibilidad por circuito y horario")}
          </div>
          <h1
            class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 leading-tight tracking-tight"
          >
            {t("Reserva tu visita a")}{" "}<span class="text-[#007020]"
              >Machu Picchu</span
            >
          </h1>
          <p class="mt-4 text-gray-500 text-base md:text-lg">
            {
              t(
                "Tres pasos simples: elige tu circuito, el mes y el horario perfecto.",
              )
            }
          </p>
        </div>
        <div class="flex gap-4 lg:gap-8">
          <div
            class="bg-[#e6f2e8] rounded-xl px-5 py-3 border border-[#007020]/10"
          >
            <span class="block text-2xl font-extrabold text-[#007020]">10</span>
            <span class="text-xs text-gray-500 font-medium">{t("Rutas")}</span>
          </div>
          <div
            class="bg-[#fbeaed] rounded-xl px-5 py-3 border border-[#B71532]/10"
          >
            <span class="block text-2xl font-extrabold text-[#B71532]"
              >2h30</span
            >
            <span class="text-xs text-gray-500 font-medium"
              >{t("Duración")}</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- COLUMNA IZQUIERDA: CONFIGURADOR -->
      <div class="lg:col-span-2 space-y-6">
        <!-- PASO 2: CIRCUITO -->
        <div
          id="step2"
          class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 opacity-50 pointer-events-none transition"
        >
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div
                id="step2Badge"
                class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold text-sm"
              >
                1
              </div>
              <h2 class="text-lg font-bold text-gray-900">
                {t("Elige tu circuito")}
              </h2>
            </div>
            <span
              class="text-xs font-medium text-gray-400 bg-gray-100 px-3 py-1 rounded-full"
              >{t("Paso 1 de 3")}</span
            >
          </div>

          <label
            class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2"
            >{t("Tipo de boleto")}</label
          >
          <div class="relative">
            <div class="relative">
              <select
                id="circuitSelect"
                class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-11 pr-10 py-3.5 text-sm font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#007020] focus:border-transparent transition cursor-pointer"
              >
                {
                  MACHU_PICCHU_ROUTES.map((route) => (
                    <option value={route.code} selected={route.code === "2A"}>
                      {t(route.circuit)} / {t("Ruta")} {route.code}:{" "}
                      {t(route.name)}
                    </option>
                  ))
                }
              </select><svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-[#007020]"
                ><path d="m6 9 6 6 6-6"></path></svg
              >
            </div>
            <div
              class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
            >
              <svg
                class="w-5 h-5 text-[#007020]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Resumen del circuito -->
          <div
            class="mt-5 bg-[#e6f2e8]/50 rounded-xl p-4 border border-[#007020]/10"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
              <div class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-[#007020] mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700"
                  ><strong id="circuitGroup">{t("Circuito")} 2</strong></span
                >
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-[#007020] mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700"
                  ><strong id="circuitRoute">{t("Ruta")} 2A</strong></span
                >
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-[#B71532] mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700"
                  >{t("Duración")}:{" "}<strong>2h 30min</strong></span
                >
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-[#B71532] mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700"
                  >{t("Ingreso")}:{" "}<strong>06:00 – 15:00</strong></span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- PASO 1: MES -->
        <div
          class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 shadow-[0_0_0_4px_rgba(0,112,32,0.12)]"
        >
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div
                class="w-8 h-8 rounded-full bg-[#007020] text-white flex items-center justify-center font-bold text-sm shadow-sm"
              >
                2
              </div>
              <h2 class="text-lg font-bold text-gray-900">
                {t("Elige el mes")}
              </h2>
            </div>
            <span
              class="text-xs font-medium text-gray-400 bg-gray-100 px-3 py-1 rounded-full"
              >{t("Paso 2 de 3")}</span
            >
          </div>

          <div class="mb-3 flex items-center justify-between gap-3">
            <p class="text-xs text-gray-500">{t("Mes de visita")}</p>
            <div class="flex items-center gap-2">
              <label for="visitYear" class="text-xs font-medium text-gray-500"
                >{t("Año")}</label
              >
              <div class="relative">
                <select
                  id="visitYear"
                  class="rounded-md border border-gray-200 bg-white py-1.5 pl-2 pr-7 text-xs font-semibold text-gray-700"
                ></select><svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-[#007020]"
                  ><path d="m6 9 6 6 6-6"></path></svg
                >
              </div>
            </div>
          </div>
          <!-- Meses completos del año; los anteriores están deshabilitados. -->
          <div
            id="monthPills"
            class="grid grid-cols-3 gap-1 rounded-lg bg-gray-50 p-1 sm:grid-cols-6"
          >
          </div>
          <p class="sr-only">
            {t("Los meses y días pasados no se pueden seleccionar.")}
          </p>

          <div class="mb-4 flex items-start justify-between gap-3">
            <p
              id="availabilityStatus"
              role="status"
              aria-live="polite"
              class="text-xs leading-relaxed text-gray-500"
            >
            </p>
            <button
              id="retryAvailability"
              type="button"
              class="shrink-0 rounded-md px-2 py-1 text-xs font-semibold text-[#007020] hover:bg-green-50"
              >{t("Actualizar")}</button
            >
          </div>
          <!-- Calendario -->
          <div class="mt-6 border border-gray-100 rounded-xl overflow-hidden">
            <div
              class="grid grid-cols-7 bg-gray-50 border-b border-gray-100 text-center text-[11px] font-bold text-gray-500 uppercase tracking-wider"
            >
              {weekdays.map((day) => <div class="py-3">{day}</div>)}
            </div>
            <div
              id="calendarDays"
              class="grid grid-cols-7 gap-1.5 bg-white p-1.5 text-center text-sm sm:gap-2 sm:p-2"
            >
            </div>
          </div>

          <!-- Leyenda -->
          <div
            class="mt-4 flex flex-wrap items-center gap-4 text-xs text-gray-500"
          >
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#007020]"></span><span
                >{t("Disponible")}</span
              >
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-orange-500"></span><span
                >{t("Últimos cupos")}</span
              >
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#B71532]"></span><span
                >{t("Agotado")}</span
              >
            </div>
          </div>
        </div>

        <!-- PASO 3: HORA -->
        <div
          id="step3"
          class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8 opacity-50 pointer-events-none transition"
        >
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div
                id="step3Badge"
                class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold text-sm"
              >
                3
              </div>
              <h2 class="text-lg font-bold text-gray-900">
                {t("Elige el horario")}
              </h2>
            </div>
            <span
              class="text-xs font-medium text-gray-400 bg-gray-100 px-3 py-1 rounded-full"
              >{t("Paso 3 de 3")}</span
            >
          </div>

          <p class="text-sm text-gray-500 mb-4">
            {
              t(
                "Los horarios disponibles varían según el circuito y la demanda del día.",
              )
            }
          </p>

          <!-- Grid de horarios -->
          <div
            id="timeGrid"
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2"
          >
            <!-- Se generan con JS -->
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: RESUMEN STICKY -->
      <div class="lg:col-span-1">
        <div class="sticky top-24 space-y-4">
          <div
            class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden"
          >
            <div class="bg-gradient-to-r from-[#007020] to-[#005a19] px-6 py-4">
              <h3 class="text-white font-bold text-lg">{t("Tu reserva")}</h3>
              <p class="text-white/80 text-xs mt-0.5">
                {t("Se completa a medida que eliges")}
              </p>
            </div>

            <div class="p-6 space-y-4">
              <div class="rounded-lg bg-[#e6f2e8] px-3 py-2.5">
                <span class="block text-xs text-gray-500"
                  >{t("Código de solicitud")}</span
                >
                <strong
                  id="bookingReference"
                  class="mt-1 block text-sm tracking-wide text-[#007020]"
                ></strong>
              </div>
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="text-gray-500">{t("Mes")}</span>
                <span
                  id="sumMonth"
                  class="font-semibold text-gray-400 text-right">—</span
                >
              </div>
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="text-gray-500">{t("Fecha")}</span>
                <span
                  id="sumDate"
                  class="font-semibold text-gray-400 text-right">—</span
                >
              </div>
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="text-gray-500">{t("Circuito")}</span>
                <span
                  id="sumCircuit"
                  class="font-semibold text-gray-400 text-right">—</span
                >
              </div>
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="text-gray-500">{t("Horario")}</span>
                <span
                  id="sumTime"
                  class="font-semibold text-gray-400 text-right">—</span
                >
              </div>
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="text-gray-500">{t("Visitantes")}</span>
                <span class="font-semibold text-gray-900"
                  >{t("Por definir")}</span
                >
              </div>

              <div class="border-t border-dashed border-gray-200 pt-4">
                <p class="text-xs text-gray-500">
                  {t("Precio de la visita")}
                </p><p class="mt-1 text-base font-semibold text-[#007020]">
                  {t("Pendiente de cotización")}
                </p>
              </div>

              <button
                id="payBtn"
                disabled
                class="w-full bg-gray-300 text-white font-bold py-3.5 rounded-xl transition cursor-not-allowed"
                >{t("Solicitar pre-reserva")}</button
              >
              <p class="text-[11px] text-gray-400 text-center leading-relaxed">
                {
                  t(
                    "La disponibilidad puede cambiar. Un agente revisará tu solicitud antes de confirmar disponibilidad y precio. No se realiza ningún cobro.",
                  )
                }
              </p>
              <p
                id="previewStatus"
                role="status"
                class="text-sm text-[#007020]"
              >
              </p>
            </div>
          </div>

          <div
            class="bg-[#fbeaed]/60 border border-[#B71532]/10 rounded-2xl p-5"
          >
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#B71532] shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <h4 class="font-bold text-[#B71532] text-sm">
                  {t("Importante")}
                </h4>
                <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                  {
                    t(
                      "Llega con 30 minutos de anticipación. Solo se permite un ingreso por boleto.",
                    )
                  }
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  import "@/lib/machuPicchuCalendar.js";
</script>
