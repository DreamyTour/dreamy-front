---
import type { Blog } from "@/types/blog";
import type { Lang } from "@/lib/i18n";
import { useTranslations } from "@/i18n/ui";
import {
  extractTextFromBlocks,
  getImageSrcSet,
  getImageUrl,
} from "@/lib/helpers";
import { rewriteUrl } from "@/lib/utils";

interface Props {
  blog: Blog;
  lang: Lang;
  variant?: "standard" | "featured";
}
const { blog, lang, variant = "standard" } = Astro.props;
const t = useTranslations(lang);
const href = rewriteUrl(`/blog/${blog.slug}`, lang);
const featured = variant === "featured";
const image = getImageUrl(blog.portadaImage, featured ? "large" : "medium");
const category = blog.category_blogs?.[0]?.nombre;
const dateValue = blog.publishedAt || blog.createdAt;
const date = dateValue ? new Date(dateValue) : null;
const validDate = date && !Number.isNaN(date.getTime());
const locale = { es: "es-PE", en: "en-US", pt: "pt-BR" }[lang];
const description =
  typeof blog.contenido === "string"
    ? blog.contenido
        .replace(/<[^>]*>/g, " ")
        .replace(/[#*_`]/g, "")
        .replace(/\s+/g, " ")
        .trim()
    : extractTextFromBlocks(blog.contenido ?? []);
---

<article
  class:list={["home-journal-card", featured && "home-journal-card--featured"]}
>
  <div class="journal-link">
    <a
      class="journal-photo"
      href={href}
      aria-label={`${t("aria.leerArticulo")}: ${blog.titulo}`}
    >
      {
        image && image !== "/og-default.jpg" && (
          <img
            src={image}
            srcset={
              getImageSrcSet(blog.portadaImage, ["small", "medium", "large"], {
                includeOriginal: true,
              }) || undefined
            }
            sizes={
              featured
                ? "(min-width: 1440px) 680px, (min-width: 1024px) 50vw, 100vw"
                : "(min-width: 1024px) 220px, (min-width: 640px) 30vw, 100vw"
            }
            alt=""
            loading="lazy"
            decoding="async"
          />
        )
      }
    </a>
    <div class="journal-content">
      <div class="journal-meta">
        {
          category && (
            <span class="journal-category">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <>
                  <path d="M20 13 13 20a2 2 0 0 1-2.8 0L3 12.8V3h9.8L20 10.2a2 2 0 0 1 0 2.8Z" />
                  <circle cx="7.5" cy="7.5" r="1" />
                </>
              </svg>
              {category}
            </span>
          )
        }
        {
          validDate && (
            <time datetime={date!.toISOString()}>
              {date!.toLocaleDateString(locale, {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </time>
          )
        }
      </div>
      <h3><a class="journal-title" href={href}>{blog.titulo}</a></h3>
      {
        featured && description && (
          <p class="journal-description">{description}</p>
        )
      }
      <a
        class="journal-read"
        href={href}
        aria-label={`${t("blog.leerMas")}: ${blog.titulo}`}
        >{t("blog.leerMas")}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
        ></a
      >
    </div>
  </div>
</article>

<style>
  .home-journal-card {
    height: 100%;
    background: white;
    border: 1px solid #dce7df;
    border-radius: 1rem;
    overflow: hidden;
    translate: 0;
    box-shadow: 0 5px 20px -15px #123e27;
  }
  .journal-link {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    height: 100%;
    color: #14251b;
    text-decoration: none;
  }
  .journal-photo:focus-visible,
  .journal-title:focus-visible,
  .journal-read:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: -3px;
  }
  .journal-photo {
    min-height: 180px;
    overflow: hidden;
    background: #e1ece3;
  }
  .journal-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1;
  }
  .journal-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.8rem;
    min-width: 0;
  }
  .journal-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 0.72rem;
    color: #6b776e;
  }
  .journal-category {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border-radius: 0.45rem;
    background: var(--secondary);
    color: white;
    font-weight: 700;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .journal-title {
    border-radius: 0.2rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    cursor: pointer;
    color: inherit;
    text-decoration: none;
  }
  .journal-title:hover,
  .journal-title:focus-visible {
    background-color: color-mix(in oklab, var(--primary) 10%, white);
    color: var(--primary);
    text-decoration: none;
  }
  h3 {
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .journal-read {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 1px solid color-mix(in oklab, var(--primary) 30%, white);
    border-radius: 0.65rem;
    background: white;
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: auto;
    box-shadow: 0 2px 5px -3px #123e2733;
  }
  .home-journal-card--featured .journal-read {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }
  .journal-read:hover,
  .journal-read:focus-visible {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
    box-shadow: 0 5px 12px -6px #123e2766;
  }
  .home-journal-card--featured .journal-read:hover,
  .home-journal-card--featured .journal-read:focus-visible {
    background: color-mix(in oklab, var(--primary) 85%, black);
  }
  .journal-description {
    color: #647268;
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .home-journal-card--featured .journal-link {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(280px, 1fr) auto;
  }
  .home-journal-card--featured .journal-content {
    padding: 1.75rem;
    gap: 1rem;
  }
  .home-journal-card--featured h3 {
    font-size: clamp(1.6rem, 2vw, 2.15rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .journal-title {
      transition:
        color 0.2s ease,
        background-color 0.2s ease;
    }
    .journal-read {
      transition:
        background-color 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
    }
    .home-journal-card {
      transition:
        translate 0.3s ease,
        box-shadow 0.3s ease;
    }
    .home-journal-card:hover,
    .home-journal-card:focus-within {
      translate: 0 -3px;
      box-shadow: 0 14px 30px -20px #123e2755;
    }
    .journal-photo img {
      transition: scale 0.65s ease;
    }
    .journal-photo:hover img {
      scale: 1.025;
    }
    .journal-read svg {
      transition: translate 0.3s ease;
      translate: 0;
    }
    .journal-read:hover svg {
      translate: 3px 0;
    }
  }
  @media (max-width: 639px) {
    .journal-link {
      grid-template-columns: minmax(0, 1fr);
    }
    .journal-photo {
      height: 210px;
      min-height: 0;
    }
    .home-journal-card--featured .journal-link {
      grid-template-rows: auto auto;
    }
    .home-journal-card--featured .journal-content {
      padding: 1.25rem;
    }
    .journal-content {
      gap: 0.8rem;
    }
  }
</style>
