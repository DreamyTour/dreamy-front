---
interface Props {
  certificates: { src: string; title: string }[];
  actionLabel?: string;
  dialogLabel?: string;
  closeLabel?: string;
}

const {
  certificates,
  actionLabel = "View",
  dialogLabel = "Certification",
  closeLabel = "Close certifications popup",
} = Astro.props;

const galleryGridClass =
  certificates.length === 2
    ? "mx-auto grid max-w-2xl grid-cols-1 gap-6 sm:grid-cols-2"
    : "grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3";
---

<div class="certificates-gallery not-prose" data-certificate-gallery>
  <div class={galleryGridClass}>
    {
      certificates.map((certificate) => (
        <a
          href={certificate.src}
          class="certificate-trigger group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white text-left shadow-sm ring-1 ring-transparent transition-all duration-300 ease-out hover:-translate-y-1 hover:border-primary/35 hover:shadow-xl hover:shadow-slate-900/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
          data-certificate-trigger
          data-certificate-src={certificate.src}
          data-certificate-title={certificate.title}
          aria-label={`Open ${certificate.title}`}
          aria-haspopup="dialog"
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-slate-50 to-white">
            <img
              src={certificate.src}
              alt={certificate.title}
              class="h-full w-full object-contain p-6 transition-transform duration-500 ease-out group-hover:scale-[1.035]"
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
            />

            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/55 via-slate-950/10 to-transparent opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100" />

            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 translate-y-3 items-center gap-2 rounded-full bg-primary px-4 py-2 text-xs font-semibold text-white opacity-0 shadow-lg shadow-primary/25 ring-1 ring-white/20 backdrop-blur transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
              </svg>

              <span>{actionLabel}</span>
            </div>
          </div>

          <div class="border-t border-slate-100 px-4 py-4">
            <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-slate-900 transition-colors duration-300 group-hover:text-primary">
              {certificate.title}
            </h3>
          </div>
        </a>
      ))
    }
  </div>

  <dialog
    class="m-auto max-h-[92vh] w-fit max-w-[92vw] overflow-visible rounded-xl border-0 bg-transparent p-0 backdrop:bg-black/75"
    data-certificate-dialog
    aria-label={dialogLabel}
  >
    <div class="relative flex max-h-[92vh] max-w-[92vw] flex-col items-center">
      <form method="dialog" class="absolute -right-3 -top-3 z-10">
        <button
          type="submit"
          class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-white bg-primary text-white shadow-lg transition-colors hover:bg-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label={closeLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </form>

      <img
        data-certificate-dialog-image
        alt=""
        class="max-h-[calc(92vh-3rem)] w-auto max-w-full rounded-xl bg-white object-contain shadow-2xl"
      />
      <p data-certificate-dialog-title class="mt-3 text-center text-sm font-semibold text-white"></p>
    </div>
  </dialog>
</div>

<script>
  import "@/scripts/certificate-lightbox";
</script>
