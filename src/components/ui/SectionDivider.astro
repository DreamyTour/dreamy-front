---
interface Props {
  align?: "start" | "center";
}
const { align = "start" } = Astro.props;
---

<div
  class:list={[
    "section-divider",
    { "section-divider-center": align === "center" },
  ]}
  aria-hidden="true"
>
  <span class="divider-line divider-line-left"></span>
  <span class="divider-middle"><span></span></span>
  <span class="divider-line divider-line-right"></span>
</div>

<style>
  .section-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .section-divider-center {
    justify-content: center;
  }
  .divider-line {
    height: 1px;
    width: 4rem;
  }
  .divider-line-left {
    background: linear-gradient(to right, transparent, var(--secondary));
  }
  .divider-line-right {
    background: linear-gradient(to left, transparent, var(--secondary));
  }
  .divider-middle {
    position: relative;
    width: 3rem;
    height: 0.375rem;
    border-radius: 99px;
    background: var(--secondary);
  }
  .divider-middle > span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--background);
  }
</style>
