    .about-proposal__essence-grid,
    .about-proposal__license-grid,
    .about-proposal__team-grid,
    .about-proposal__department--vertical .about-proposal__team-grid {
      grid-template-columns: 1fr;
    }
    .about-proposal__essence-card--offset-one,
    .about-proposal__essence-card--offset-two {
      margin-top: 0;
    }
    .about-proposal__team-card {
      display: block;
    }
    .about-proposal__team-card-image {
      min-width: 0;
    }
    .about-proposal__slider-button--previous {
      left: -0.25rem;
    }
    .about-proposal__slider-button--next {
      right: -0.25rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-about-slider]")
      .forEach((slider) => {
        if (slider.dataset.initialized) return;
        slider.dataset.initialized = "true";

        const track = slider.querySelector<HTMLElement>(
          ".about-proposal__slider-track",
        );
        const items = slider.querySelectorAll<HTMLElement>(
          ".about-proposal__slider-item",
        );
        const dots =
          slider.querySelectorAll<HTMLButtonElement>("[data-slider-dot]");
        const previous = slider.querySelector<HTMLButtonElement>(
          "[data-slider-previous]",
        );
        const next =
          slider.querySelector<HTMLButtonElement>("[data-slider-next]");
        if (!track || !items.length || !previous || !next) return;

        let index = 0;
        let interval: number | undefined;
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

        const perView = () =>
          window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
        const maxIndex = () => Math.max(0, items.length - perView());
        const update = () => {
          index = Math.min(index, maxIndex());
          track.style.transform = `translateX(-${index * (100 / perView())}%)`;
          dots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === index;
            dot.hidden = dotIndex > maxIndex();
            dot.setAttribute("aria-current", String(isActive));
          });
          previous.disabled = index === 0;
          next.disabled = index === maxIndex();
        };
        const move = (direction: number) => {
          index = Math.max(0, Math.min(maxIndex(), index + direction));
          update();
        };
        const stopAutoSlide = () => {
          if (interval) window.clearInterval(interval);
          interval = undefined;
        };
        const startAutoSlide = () => {
          stopAutoSlide();
          if (reducedMotion.matches || maxIndex() === 0) return;
          interval = window.setInterval(() => {
            index = index >= maxIndex() ? 0 : index + 1;
            update();
          }, 5000);
        };

        previous.addEventListener("click", () => move(-1));
        next.addEventListener("click", () => move(1));
        dots.forEach((dot, dotIndex) =>
          dot.addEventListener("click", () => {
            index = dotIndex;
            update();
            startAutoSlide();
          }),
        );
        slider.addEventListener("mouseenter", stopAutoSlide);
        slider.addEventListener("mouseleave", startAutoSlide);
        window.addEventListener("resize", () => {
          update();
          startAutoSlide();
        });
        reducedMotion.addEventListener("change", startAutoSlide);
        update();
        startAutoSlide();
      });
  });
</script>
