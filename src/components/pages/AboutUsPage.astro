---

<div class="about-proposal not-prose">
  <section class="about-proposal__intro">
    <div class="about-proposal__intro-card">
      <p class="about-proposal__intro-lead">
        <strong>DREAMY TOURS</strong>
        {copy.introLead.replace("DREAMY TOURS ", "")}
      </p>
      <div class="about-proposal__intro-divider">
        <p>{copy.introBody}</p>
      </div>
    </div>
  </section>

  <section
    class="about-proposal__essence"
    aria-labelledby="about-essence-title"
  >
    <div class="about-proposal__section-title">
      <h2 id="about-essence-title">{copy.essence}</h2>
      <span aria-hidden="true"></span>
    </div>
    <div class="about-proposal__essence-grid">
      <article class="about-proposal__essence-card">
        <span class="about-proposal__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"
            ><path
              d="M9 20 3.55 17.28A1 1 0 0 1 3 16.38V5.62a1 1 0 0 1 1.45-.89L9 7m0 13 6-3m-6 3V7m6 10 4.55 2.28A1 1 0 0 0 21 18.38V7.62a1 1 0 0 0-.55-.89L15 4m0 13V4m0 0L9 7"
            ></path></svg
          >
        </span>
        <h3>{copy.mission}</h3>
        <p>{copy.missionBody}</p>
      </article>
      <article
        class="about-proposal__essence-card about-proposal__essence-card--offset-one"
      >
        <span class="about-proposal__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="3"></circle><path
              d="M2.46 12C3.73 7.94 7.52 5 12 5s8.27 2.94 9.54 7c-1.27 4.06-5.06 7-9.54 7S3.73 16.06 2.46 12Z"
            ></path></svg
          >
        </span>
        <h3>{copy.vision}</h3>
        <p>{copy.visionBody}</p>
      </article>
      <article
        class="about-proposal__essence-card about-proposal__essence-card--offset-two"
      >
        <span class="about-proposal__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"
            ><path
              d="M4.32 6.32a4.5 4.5 0 0 0 0 6.36L12 20.36l7.68-7.68a4.5 4.5 0 0 0-6.36-6.36L12 7.64l-1.32-1.32a4.5 4.5 0 0 0-6.36 0Z"
            ></path></svg
          >
        </span>
        <h3>{copy.values}</h3>
        <p>{copy.valuesBody}</p>
      </article>
    </div>
  </section>

  <section
    class="about-proposal__philosophy"
    aria-labelledby="about-philosophy-title"
  >
    <div class="about-proposal__philosophy-content">
      <p class="about-proposal__eyebrow">{copy.philosophyEyebrow}</p>
      <h2 id="about-philosophy-title">{copy.philosophyTitle}</h2>
      <div class="about-proposal__philosophy-card">
        <p>{copy.philosophy}</p>
        <div aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
    </div>
  </section>

  <section
    class="about-proposal__licenses"
    aria-labelledby="about-licenses-title"
  >
    <div class="about-proposal__licenses-content">
      <div class="about-proposal__section-title">
        <p class="about-proposal__eyebrow">{copy.licensesEyebrow}</p>
        <h2 id="about-licenses-title">{copy.licensesTitle}</h2>
        <span aria-hidden="true"></span>
      </div>
      <div class="about-proposal__licenses-intro">
        <p><strong>{copy.licenseLead}</strong>{copy.licenseLeadRest}</p>
        <p>{copy.licenseIntro}</p>
      </div>
      <ul class="about-proposal__license-grid" role="list">
        {
          copy.licenseCards.map((license) => (
            <li class="about-proposal__license-card">
              <div class="about-proposal__license-card-title">
                <span
                  class="about-proposal__icon about-proposal__icon--small"
                  aria-hidden="true"
                >
                  {license.icon === "building" && (
                    <svg viewBox="0 0 24 24">
                      <path d="M3 21h18M5 21V5h14v16M9 9h1m4 0h1M9 13h1m4 0h1M9 17h1m4 0h1" />
                    </svg>
                  )}
                  {license.icon === "globe" && (
                    <svg viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
                    </svg>
                  )}
                  {license.icon === "folder" && (
                    <svg viewBox="0 0 24 24">
                      <path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2Z" />
                    </svg>
                  )}
                </span>
                <div>
                  <>
                    <h3>{license.name}</h3>
