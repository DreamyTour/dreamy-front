---
import Layout from "@/layouts/main.astro";
import fetchApi from "@/lib/strapi";
import type { Home } from "@/types/home";
import Hero from "@/components/sections/Hero.astro";
import HomeStats from "@/components/sections/HomeStats.astro";
import About from "@/components/sections/About.astro";
import Certifications from "@/components/sections/Certifications.astro";
import TourPackagesSection from "@/components/sections/TourPackagesSection.astro";
import PeruGuide from "@/components/sections/PeruGuide.astro";
import HomePost from "@/components/sections/HomePost.astro";
import ReviewsWall from "@/components/sections/ReviewsWall.astro";
import TravelExperiences from "@/components/sections/TravelExperiences.astro";
import PurposeTourism from "@/components/sections/PurposeTourism.astro";
import type { Lang } from "@/lib/i18n";
import { DEFAULT_SEO_IMAGE, buildSEOProps } from "@/lib/seo";
import { homeMobileHeroImage } from "@/lib/homeHeroImage";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const homeData = await fetchApi<Home>({
  endpoint: "home",
  wrappedByKey: "data",
  query: {
    locale: lang,
    populate: "*",
  },
});

const seoProps = {
  ...buildSEOProps({
    seo: homeData?.seo,
    fallbackTitle: "Turismo Peru Bolivia - Tours y Paquetes Turisticos",
    fallbackDescription:
      "Organiza tu viaje a Peru y Bolivia con los mejores tours: Machu Picchu, Lago Titicaca, Salar de Uyuni y mas. Paquetes turisticos completos.",
    type: "website",
    lang,
  }),
  // Complete, localized copy instead of the truncated CMS descriptions.
  description: {
    en: "Tours and travel packages in Peru and Bolivia: Machu Picchu, the Inca Trail, Lake Titicaca and Uyuni. Plan your adventure with Dreamy Tours.",
    es: "Tours y paquetes de viaje en Perú y Bolivia: Machu Picchu, Camino Inca, lago Titicaca y Uyuni. Planifica tu aventura con Dreamy Tours.",
    pt: "Passeios e pacotes de viagem no Peru e na Bolívia: Machu Picchu, Trilha Inca, Lago Titicaca e Uyuni. Planeje sua aventura com a Dreamy Tours.",
  }[lang],
  image: DEFAULT_SEO_IMAGE,
  imageAlt: "Dreamy Tours - tours y paquetes turisticos en Peru y Bolivia",
};
---

<Layout
  seo={seoProps}
  lang={lang}
  lcpImageUrl={homeMobileHeroImage.src}
  lcpImageSrcSet={homeMobileHeroImage.srcset}
  lcpImageSizes={homeMobileHeroImage.sizes}
  lcpImageType={homeMobileHeroImage.type}
  lcpImageMedia={homeMobileHeroImage.media}
>
  <Hero data={homeData?.hero} lang={lang} />
  <HomeStats lang={lang} />
  <About data={homeData?.about} lang={lang} />
  <Certifications data={homeData?.premios?.premios} lang={lang} />
  <TourPackagesSection
    data={homeData?.sectionMapi}
    lang={lang}
    sectionId="machupicchu"
    titleId="machupicchu-title"
    href={`/${homeData?.sectionMapi?.category?.slug || "machu-picchu"}`}
    defaultLimit={10}
    highlighted
    ctaLabelKey="section.verMasPaquetes"
  />
  <TourPackagesSection
    data={homeData?.peruPaquetes}
    lang={lang}
    titleId="peru-packages-title"
    href={{
      es: "/paquetes-peru",
      en: "/peru-packages",
      pt: "/pacotes-peru",
    }[lang] || "/peru-packages"}
    surface="white"
    ctaLabelKey="section.verMasPaquetes"
  />
  <PeruGuide lang={lang} />
  <TourPackagesSection
    data={homeData?.boliviaPaquetes}
    lang={lang}
    titleId="bolivia-packages-title"
    href="/bolivia"
    ctaLabelKey="section.verMasPaquetes"
  />
  <HomePost data={homeData?.cardPost} lang={lang} />
  <TravelExperiences lang={lang} />
  <PurposeTourism lang={lang} />
  <ReviewsWall lang={lang} />
</Layout>
