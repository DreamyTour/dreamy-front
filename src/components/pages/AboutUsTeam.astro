    accountingTags: ["Finance", "Taxes"],
    accountingAssistantTags: ["Invoicing", "Support"],
    devTools: "Development tools",
    seoTools: "Technical SEO, web performance and WordPress development",
    socialTools: "Social media responsibilities",
    socialTags: [
      "Social media",
      "Community",
      "Content",
      "Photography",
      "Storytelling",
      "Reels",
      "Analytics",
      "Planning",
      "Copywriting",
    ],
  },
  pt: {
    manager: {
      eyebrow: "Mensagem do Gerente Geral",
      title: "Cada experiência conta uma história",
      quote:
        "Cada experiência conta uma história, e na Dreamy Tours queremos fazer parte da sua.",
      paragraphs: [
        "Sou Mark Luna, diretor comercial, e junto com minha equipe nos dedicamos a organizar experiências pelo Peru e pela Bolívia, cuidando daqueles detalhes que muitas vezes fazem toda a diferença entre uma boa viagem e uma viagem inesquecível.",
        "Agradecemos a confiança que vocês depositam em nós e a oportunidade de acompanhá-los na descoberta dos nossos destinos.",
      ],
      name: "Mark Luna",
      role: "Diretor comercial",
      imageAlt: "Mark Luna, diretor comercial da Dreamy Tours",
    },
    eyebrow: "Profissionais",
    title: "Uma equipe por trás de cada viagem",
