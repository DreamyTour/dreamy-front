      "Astro",
      "React",
      "TypeScript",
      "Sys Arch",
      "Node/Bun",
      "Docker",
      "CI/CD",
      "PostgreS",
      "Linux",
    ],
    tagLabel: copy.devTools,
  },
  {
    name: "Yuri Alata",
    role: copy.technologyRoles[1],
    image: "/imagenes/personal/jack.webp",
    alt: `Yuri Alata, ${copy.technologyRoles[1]}`,
    tags: [
      "Semrush",
      "Cloudflare",
      "Ahrefs",
      "WordPress",
      "Search Console",
      "Php",
      "Nginx",
      "tailwindcss",
      "Astro",
    ],
    tagLabel: copy.seoTools,
  },
  {
    name: "Junior",
    role: copy.technologyRoles[2],
    image: "/imagenes/personal/junior.webp",
    alt: `Junior, ${copy.technologyRoles[2]}`,
    tags: copy.socialTags,
    tagLabel: copy.socialTools,
  },
];

const operatingDepartments = [
  {
    id: "department-operaciones",
    title: copy.operations,
    members: [
      {
        name: "Zaida",
        role: copy.operationsRole,
        image: "/imagenes/personal/zaida.webp",
        alt: `Zaida, ${copy.operationsRole}`,
        summary: copy.operationsSummary,
        tags: copy.operationsTags,
      },
      {
        name: "Yuliana",
        role: copy.operationsRole,
        image: "/imagenes/personal/juliana.webp",
        alt: `Yuliana, ${copy.operationsRole}`,
        summary: copy.operationsSummary,
        tags: copy.operationsTags,
      },
    ],
  },
  {
    id: "department-contabilidad",
    title: copy.accounting,
    members: [
      {
        name: "Susana",
        role: copy.accountingRole,
        image: "/imagenes/personal/susana.webp",
        alt: `Susana, ${copy.accountingRole}`,
        summary: copy.accountingSummary,
        tags: copy.accountingTags,
      },
      {
        name: "Lizbeth",
        role: copy.accountingAssistantRole,
        image: "/imagenes/personal/liz.webp",
        alt: `Lizbeth, ${copy.accountingAssistantRole}`,
        summary: copy.accountingAssistantSummary,
        tags: copy.accountingAssistantTags,
      },
    ],
  },
];
---

<section
  class="mx-auto max-w-7xl px-6 pb-4 pt-12 md:pt-16"
  aria-labelledby="manager-message-title"
>
  <div
    class="relative isolate overflow-hidden rounded-[2rem] border border-primary/15 bg-white px-5 py-5 shadow-[0_30px_70px_-42px_color-mix(in_oklab,var(--primary)_42%,transparent)] sm:px-8 sm:py-8 lg:px-10 lg:py-10"
  >
    <span
      class="pointer-events-none absolute -right-24 -top-28 size-80 rounded-full border border-primary/20"
      aria-hidden="true"></span
    >
    <span
      class="pointer-events-none absolute -bottom-32 left-[38%] size-80 rounded-full bg-primary/10 blur-3xl"
      aria-hidden="true"></span
    >
    <span
      class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle_at_1px_1px,color-mix(in_oklab,var(--primary)_42%,transparent)_1px,transparent_1.25px)] [background-size:0.95rem_0.95rem] [-webkit-mask-image:radial-gradient(ellipse_42rem_28rem_at_84%_6%,black_0%,black_34%,transparent_78%)] [mask-image:radial-gradient(ellipse_42rem_28rem_at_84%_6%,black_0%,black_34%,transparent_78%)]"
      aria-hidden="true"></span
    >

    <div class="relative grid gap-9 lg:grid-cols-[minmax(17rem,0.76fr)_minmax(0,1.24fr)] lg:items-center lg:gap-14">
      <figure class="group relative mx-auto w-full max-w-md lg:max-w-none">
        <div
          class="absolute -inset-3 rounded-[1.75rem] border border-primary/20 [transform:rotate(-2.5deg)]"
          aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[1.5rem] bg-white shadow-[0_24px_42px_-24px_color-mix(in_oklab,black_75%,transparent)]">
          <img
            class="block aspect-[4/5] w-full scale-100 object-cover object-[52%_center] transition-transform duration-500 ease-out group-hover:scale-[1.035] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            src="/imagenes/personal/mark.webp"
            alt={copy.manager.imageAlt}
            width="1440"
            height="1080"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 28rem, calc(100vw - 4rem)"
          />
          <figcaption
            class="absolute inset-x-4 bottom-4 rounded-xl border border-secondary/80 bg-secondary/95 px-4 py-3 text-white shadow-[0_18px_30px_-18px_color-mix(in_oklab,var(--secondary)_90%,transparent)] backdrop-blur-sm"
          >
            <span class="block text-base font-bold leading-none">{copy.manager.name}</span>
            <span class="mt-1 block text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white">{copy.manager.role}</span>
          </figcaption>
        </div>
      </figure>

      <div class="py-1 text-foreground lg:py-4">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-primary">
          <span class="h-px w-9 bg-primary" aria-hidden="true"></span>
          {copy.manager.eyebrow}
        </p>
        <h2
          id="manager-message-title"
          class="mt-5 max-w-2xl text-balance text-4xl font-bold tracking-tight text-foreground md:text-5xl"
        >
          {copy.manager.title}
        </h2>

        <blockquote class="relative mt-7 border-l-2 border-secondary pl-5 md:pl-6">
          <span
            class="pointer-events-none absolute -left-1 top-[-1.3rem] font-serif text-6xl leading-none text-secondary"
            aria-hidden="true">“</span
          >
          <p class="m-0 max-w-2xl text-balance text-xl font-semibold leading-8 text-foreground md:text-2xl md:leading-9">
            {copy.manager.quote}
          </p>
        </blockquote>

        <div class="mt-7 max-w-2xl space-y-4 text-pretty leading-7 text-muted-foreground md:text-lg md:leading-8">
          <p class="m-0">{copy.manager.paragraphs[0]}</p>
          <p class="m-0">{copy.manager.paragraphs[1]}</p>
        </div>

        <div class="mt-8 flex items-center gap-4">
          <span class="h-px w-12 bg-secondary" aria-hidden="true"></span>
          <div>
            <p class="m-0 font-bold tracking-tight text-foreground">{copy.manager.name}</p>
            <p class="m-0 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">{copy.manager.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  class="mx-auto max-w-7xl px-6 py-12 md:py-16"
  aria-labelledby="about-team-title"
>
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">
      {copy.eyebrow}
    </p>
    <h2
      id="about-team-title"
      class="mt-3 text-3xl font-bold tracking-tight md:text-5xl"
    >
      {copy.title}
    </h2>
    <div class="mt-4 space-y-4 leading-7 text-muted-foreground">
      <p class="m-0">{copy.paragraphs[0]}</p>
      <p class="m-0">{copy.paragraphs[1]}</p>
      <p class="m-0">{copy.paragraphs[2]}</p>
    </div>
    <span
      class="mx-auto mt-5 block h-1 w-20 rounded-full bg-secondary"
      aria-hidden="true"></span>
  </div>

  <section class="mt-10" aria-labelledby="department-tecnologia">
    <div class="mb-6 flex items-center gap-3">
      <span class="h-8 w-1 rounded-full bg-secondary" aria-hidden="true"
      ></span><h3 id="department-tecnologia" class="text-xl font-bold">
        {copy.technology}
      </h3>
    </div>
    <ul class="grid list-none gap-6 p-0 md:grid-cols-3" role="list">
      {
        technologyTeam.map((member) => (
          <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <img
              class="!my-0 block h-auto min-h-0 w-full object-contain object-top"
              src={member.image}
              alt={member.alt}
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0 p-6 text-center">
              <h4 class="m-0 text-xl font-bold">{member.name}</h4>
              <p class="mt-1 font-bold text-primary">{member.role}</p>
              <div
                class="mt-4 flex flex-wrap justify-center gap-2"
                aria-label={member.tagLabel}
              >
                {member.tags.map((tag) => (
                  <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {
    operatingDepartments.map((department) => (
      <section class="mt-10" aria-labelledby={department.id}>
        <div class="mb-6 flex items-center gap-3">
          <>
            <span
              class="h-8 w-1 rounded-full bg-secondary"
              aria-hidden="true"
            />
            <h3 id={department.id} class="text-xl font-bold">
              {department.title}
            </h3>
          </>
        </div>
        <ul class="grid list-none gap-6 p-0 md:grid-cols-2" role="list">
          {department.members.map((member) => (
            <li class="overflow-hidden rounded-2xl border border-border bg-card shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:flex">
              <img
                class="!my-0 min-h-48 w-full self-stretch object-cover sm:w-2/5"
                src={member.image}
                alt={member.alt}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
              <div class="p-6">
                <h4 class="m-0 text-xl font-bold">{member.name}</h4>
                <p class="mt-1 font-bold text-primary">{member.role}</p>
                <small class="mt-3 block leading-5 text-muted-foreground">
                  {member.summary}
                </small>
                <div class="mt-4 flex flex-wrap gap-2">
                  {member.tags.map((tag) => (
                    <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>
