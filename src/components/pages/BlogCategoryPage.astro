---
import Layout from "@/layouts/main.astro";
import CardPost from "@/components/ui/CardPost.astro";
import BlogAside from "@/components/ui/BlogAside.astro";
import BlogPagination from "@/components/blog/BlogPagination.astro";
import BlogSearch from "@/components/blog/BlogSearch";
import { DEFAULT_LANG, type Lang } from "@/lib/i18n";
import { getImageSrcSet, getImageUrl } from "@/lib/helpers";
import { buildSEOProps } from "@/lib/seo";
import { buildBlogCategorySchemas } from "@/lib/pageSchema";
import { buildBlogSearchItems } from "@/lib/blogSearch";
import { serializeJsonForHtml } from "@/lib/html";
import type { Blog } from "@/types/blog";
import type { BlogCategoryProps } from "@/lib/blogRoutes";

interface Props extends BlogCategoryProps {
  lang: Lang;
}

const {
  page,
  searchBlogs,
  allCategories,
  currentCategory,
  categorySlug,
  slugMap,
  categoryPostCounts,
  totalPostCount,
  socialLogos,
  lang = DEFAULT_LANG,
} = Astro.props;

const blogsList = page.data;
const blogSearchItems = buildBlogSearchItems(searchBlogs, lang);
const heroImage = currentCategory?.imagenDestacada
  ? getImageUrl(currentCategory.imagenDestacada)
  : "";
const heroImageSrcSet = currentCategory?.imagenDestacada
  ? getImageSrcSet(
      currentCategory.imagenDestacada,
      ["small", "medium", "large"],
      { includeOriginal: true },
    )
  : "";

const pageLabelByLang: Record<Lang, string> = {
  en: "Page",
  es: "Pagina",
  pt: "Pagina",
};
const emptyByLang: Record<Lang, string> = {
  en: "No blog posts available in this category",
  es: "No hay blogs disponibles en esta categoria",
  pt: "Nao ha posts disponiveis nesta categoria",
};
const categoryDescriptionFallbackByLang: Record<Lang, (name: string) => string> = {
	en: (name) =>
		`Find travel guides, recommendations, and ideas to plan your trip to ${name}.`,
	es: (name) =>
		`Encuentra guías, recomendaciones e ideas para planificar tu viaje a ${name}.`,
	pt: (name) =>
		`Encontre guias, recomendações e ideias para planejar sua viagem a ${name}.`,
};
const categoryDescription = currentCategory?.descripcion?.trim() ||
  (currentCategory?.nombre
    ? categoryDescriptionFallbackByLang[lang](currentCategory.nombre)
    : "");
const categorySeoProps = buildSEOProps({
  seo: currentCategory?.seo,
  fallbackTitle: currentCategory?.nombre || "Blog",
  fallbackDescription: categoryDescription,
  type: "website",
  lang,
  slugMap,
  fallbackImage: heroImage || undefined,
  fallbackImageAlt: currentCategory?.nombre,
  schemas: buildBlogCategorySchemas({
    canonicalUrl: `${Astro.site?.origin || "https://dreamy.tours"}${Astro.url.pathname}`,
    siteUrl: Astro.site?.origin || "https://dreamy.tours",
    lang,
    title: currentCategory?.seo?.metaTitle || currentCategory?.nombre || "Blog",
    description:
      currentCategory?.seo?.metaDescription ||
      categoryDescription,
    imageUrl: heroImage || undefined,
    category: currentCategory,
    posts: blogsList,
  }),
});
const seoProps =
  page.currentPage > 1
    ? {
        ...categorySeoProps,
        title: `${categorySeoProps.title} - ${pageLabelByLang[lang]} ${page.currentPage}`,
      }
    : categorySeoProps;
---

<Layout
  seo={seoProps}
  lang={lang}
  lcpImageUrl={heroImage || undefined}
  lcpImageSrcSet={heroImageSrcSet || undefined}
>
  <section
    class="blog-page-shell relative isolate overflow-hidden"
    aria-labelledby="blog-category-title"
  >
    {
      slugMap && Object.keys(slugMap).length > 0 && (
        <script
          is:inline
          id="blog-slug-map"
          type="application/json"
          set:html={serializeJsonForHtml(slugMap)}
        />
      )
    }

    {
      currentCategory?.imagenDestacada ? (
        <header class="relative h-[46vh] min-h-[300px] max-h-[460px] w-full overflow-hidden">
          <img
            src={heroImage}
            srcset={heroImageSrcSet || undefined}
            sizes="100vw"
            alt=""
            aria-hidden="true"
            width={currentCategory.imagenDestacada.width || 2000}
            height={currentCategory.imagenDestacada.height || 600}
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-black/55" aria-hidden="true" />

          <div class="relative z-10 mx-auto flex h-full max-w-8xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8">
            <h1
              id="blog-category-title"
              class="max-w-3xl text-3xl font-semibold leading-[1.05] text-white drop-shadow-md md:text-5xl lg:text-6xl"
            >
              {currentCategory.nombre}
            </h1>
          </div>
        </header>
      ) : (
        <header class="w-full py-14 md:py-20">
          <div class="mx-auto max-w-8xl px-4 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center">
              <h1
                id="blog-category-title"
                class="text-3xl font-semibold leading-[1.05] text-primary md:text-5xl lg:text-6xl"
              >
                {currentCategory?.nombre}
              </h1>
            </div>
          </div>
        </header>
      )
    }

    <div class="blog-category-page py-12 lg:py-16">
      <div class="mx-auto max-w-8xl px-4 sm:px-6 lg:px-8">
        <div
          class="grid items-start gap-8 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[21rem_minmax(0,1fr)] xl:gap-12"
        >
          <div class="lg:sticky lg:top-24">
            <BlogSearch
              client:load
              items={blogSearchItems}
              lang={lang}
              targetId="blog-category-search-results"
              defaultContentId="blog-category-default-posts"
            />

            <div class="mt-5 lg:hidden">
              <BlogAside
                categories={allCategories}
                currentSlug={categorySlug}
                lang={lang}
                categoryPostCounts={categoryPostCounts}
                totalPostCount={totalPostCount}
                layout="toolbar"
              />
            </div>

            <div class="mt-5 hidden lg:block">
              <BlogAside
                categories={allCategories}
                currentSlug={categorySlug}
                lang={lang}
                categoryPostCounts={categoryPostCounts}
                totalPostCount={totalPostCount}
                socialLogos={socialLogos}
                layout="sidebar"
              />
            </div>
          </div>

          <div class="min-w-0">
            {
              categoryDescription && (
                <p class="mb-7 max-w-3xl border-l border-secondary/45 pl-5 text-base leading-7 text-foreground/68 [text-wrap:pretty] md:text-lg">
                  {categoryDescription}
                </p>
              )
            }

            <div id="blog-category-search-results"></div>

            <div id="blog-category-default-posts">
              {
                blogsList.length > 0 ? (
                  <>
                    <div class="blog-category-grid">
                      {blogsList.map((blog: Blog) => (
                        <CardPost blog={blog} lang={lang} showDescription />
                      ))}
                    </div>

                    <BlogPagination page={page} lang={lang} />
                  </>
                ) : (
                  <p class="text-center text-muted-foreground">
                    {emptyByLang[lang]}
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-page-shell::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("/fondo.svg");
    background-position: top center;
    background-repeat: repeat;
    background-size: 520px 520px;
    content: "";
    opacity: 0.035;
    pointer-events: none;
  }

  .blog-category-page {
    background: transparent;
  }

  .blog-category-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .blog-category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .blog-category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .blog-category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
