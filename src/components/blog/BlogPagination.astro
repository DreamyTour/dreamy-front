---
import { localizePath, type Lang } from "@/lib/i18n";
import type { PaginatedBlogPage } from "@/lib/blogRoutes";
import Pagination from "./Pagination";

interface Props {
  page: PaginatedBlogPage;
  lang: Lang;
}

const { page, lang } = Astro.props;
---

<Pagination
  currentPage={page.currentPage}
  totalPages={page.lastPage}
  lang={lang}
  pathname={localizePath(Astro.url.pathname, lang)}
/>
