{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dreamy-front",
	// Evita que cada despliegue reactive el subdominio público workers.dev.
	"workers_dev": false,
	"main": "./src/worker.ts",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": [],
	"keep_vars": true,
	"durable_objects": { "bindings": [{ "name": "FORM_RATE_LIMITER", "class_name": "FormRateLimiter" }] },
	"migrations": [{ "tag": "form-antispam-v1", "new_sqlite_classes": ["FormRateLimiter"] }],
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "586d1e4ff42d4732b8810abdf09c02d4" }
	],
	"images": { "binding": "IMAGES" },
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		// Preserve /en/ handling and run query checks before the three home assets.
		"run_worker_first": ["/en", "/en/*", "/", "/es", "/es/", "/pt", "/pt/"]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": false }
	}
}
