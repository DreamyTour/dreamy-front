{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dreamy-front",
	// Evita que cada despliegue reactive el subdominio público workers.dev.
	"workers_dev": false,
	"main": "./src/worker.ts",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": [],
	"keep_vars": true,
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "586d1e4ff42d4732b8810abdf09c02d4" }
	],
	"images": { "binding": "IMAGES" },
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"run_worker_first": ["/en", "/en/*"]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": false }
	}
}
