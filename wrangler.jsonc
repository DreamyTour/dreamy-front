{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dreamy-front",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": [],
	"keep_vars": true,
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "586d1e4ff42a4732b8810abdf09c02d4" }
	],
	"images": { "binding": "IMAGES" },
	"assets": { "binding": "ASSETS", "directory": "./dist/client" },
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": false }
	}
}
